+/**
+ * Confirm ancestry with GitHub's compare API. `ahead`/`identical` means
+ * `commitSha` is reachable from `branch`, so a squash commit recorded on main
+ * can be verified instead of trusted from a local string.
+ */
+export async function isCommitOnBranch(
+  repository: DevRepositoryKey | string,
+  commitSha: string,
+  branch: string
+): Promise<{ onBranch: boolean; status: string; detail: string }> {
+  const config = getDevRepositoryConfig(repoKey(repository));
+  const sha = String(commitSha || '').trim();
+  if (!/^[0-9a-f]{7,40}$/i.test(sha) || !branch) {
+    return { onBranch: false, status: 'invalid', detail: 'A valid commit and branch are required.' };
+  }
+  try {
+    const response = await client().rest.repos.compareCommits({
+      owner: config.owner,
+      repo: config.repo,
+      base: sha,
+      head: safeBranch(branch),
+      per_page: 1,
+    });
+    const status = String(response.data.status || 'unknown');
+    return {
+      onBranch: status === 'ahead' || status === 'identical',
+      status,
+      detail:
+        status === 'ahead' || status === 'identical'
+          ? `GitHub confirms ${sha.slice(0, 7)} is reachable from ${branch}.`
+          : `GitHub reports compare status ${status}: ${sha.slice(0, 7)} is not an ancestor of ${branch}.`,
+    };
+  } catch (error) {
+    const normalized = toError(error, 'GITHUB_COMPARE_FAILED');
+    return { onBranch: false, status: 'unknown', detail: normalized.message };
+  }
+}
+
