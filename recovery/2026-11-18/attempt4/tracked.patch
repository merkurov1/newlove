+): Promise<{ inMain: boolean; status: string; detail: string }> {
+  const config = getDevRepositoryConfig(repoKey(repository));
+  const branch = baseRef || config.defaultBranch;
+  const result = await isCommitOnBranch(repository, commitSha, branch);
+  return {
+    inMain: result.onBranch,
+    status: result.status,
+    detail: result.onBranch
+      ? `GitHub confirms ${String(commitSha).slice(0, 7)} is in ${branch}.`
