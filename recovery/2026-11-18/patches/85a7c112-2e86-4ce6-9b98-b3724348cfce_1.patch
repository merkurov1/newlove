+import { isLongQuestionText, QUESTION_LONG_TEXT_CHARS } from '../display';
+
+describe('question display typography', () => {
+  it('keeps ordinary short questions in the unchanged display style', () => {
+    expect(isLongQuestionText('В чём смысл жизни?')).toBe(false);
+    expect(isLongQuestionText('а'.repeat(QUESTION_LONG_TEXT_CHARS))).toBe(false);
+  });
+
+  it('marks long questions for calmer typography', () => {
+    expect(isLongQuestionText('а'.repeat(QUESTION_LONG_TEXT_CHARS + 1))).toBe(true);
+  });
+
+  it('calms multi-paragraph questions without changing their text', () => {
+    const text = 'Первый абзац.\n\nВторой абзац.';
+
+    expect(isLongQuestionText(text)).toBe(true);
+    expect(text).toBe('Первый абзац.\n\nВторой абзац.');
+  });
+});
