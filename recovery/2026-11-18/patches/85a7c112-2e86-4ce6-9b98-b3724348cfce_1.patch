diff --git a/lib/question/display.ts b/lib/question/display.ts
new file mode 100644
index 00000000..ec955329
--- /dev/null
+++ b/lib/question/display.ts
@@ -0,0 +1,20 @@
+/**
+ * Questions are stored verbatim, so some of them are long or contain explicit
+ * line breaks. Those need quieter typography than a short one-line question
+ * without changing the text itself.
+ */
+export const QUESTION_LONG_TEXT_CHARS = 180;
+export const QUESTION_LONG_TEXT_LINES = 3;
+
+export function isLongQuestionText(text: string): boolean {
+  if (typeof text !== 'string') return false;
+
+  const normalized = text.replace(/\r\n?/g, '\n').trim();
+
+  if (!normalized) return false;
+
+  return (
+    normalized.length > QUESTION_LONG_TEXT_CHARS ||
+    normalized.split('\n').length >= QUESTION_LONG_TEXT_LINES
+  );
+}
diff --git a/migrations/2026-12-11_question_text_length_2000.sql b/migrations/2026-12-11_question_text_length_2000.sql
new file mode 100644
index 00000000..b594c2c9
--- /dev/null
+++ b/migrations/2026-12-11_question_text_length_2000.sql
@@ -0,0 +1,48 @@
+-- ============================================================================
+-- Question — restore the production text limit
+-- Date: 2026-12-11
+--
+-- Production already enforces 3..2000 characters on questions.question.
+-- The original domain migration used the older 3..500 limit, so fresh
+-- environments must be brought back to the same contract.
+--
+-- Additive only: this migration replaces the length check and never rewrites
+-- existing question text, answers or syntheses.
+-- ============================================================================
+
+begin;
+
+-- The original table was created with an inline (auto-named) check. Replace
+-- every question-length check so this migration is safe both on a fresh
+-- database and on production where the 2000-character limit is already live.
+do $$
+declare
+  existing_constraint text;
+begin
+  for existing_constraint in
+    select c.conname
+    from pg_constraint c
+    join pg_class t on t.oid = c.conrelid
+    join pg_namespace n on n.oid = t.relnamespace
+    where n.nspname = 'public'
+      and t.relname = 'questions'
+      and c.contype = 'c'
+      and pg_get_constraintdef(c.oid) ilike '%char_length%'
+      and pg_get_constraintdef(c.oid) ilike '%question%'
+  loop
+    execute format(
+      'alter table public.questions drop constraint %I',
+      existing_constraint
+    );
+  end loop;
+end
+$$;
+
+alter table public.questions
+  add constraint questions_question_length_check
+  check (char_length(btrim(question)) between 3 and 2000);
+
+comment on constraint questions_question_length_check on public.questions is
+  'Verbatim question text must be 3-2000 characters, matching production.';
+
+commit;
-- 
