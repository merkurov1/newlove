@@ -0,0 +1,205 @@
+/** @jest-environment node */
+
+/**
+ * Regression: Next.js 16 passes `searchParams` to a server page as a Promise.
+ * The chat page used to read it synchronously, so every deep link
+ * (`?history=`, `?session=`, `?project=`, `?conversation=`, `?new=1`) was
+ * silently ignored and a project link always rendered the MAIN history.
+ *
+ * These tests call the real page component with the same Promise shape the
+ * Next.js runtime provides. They fail if the page stops awaiting searchParams.
+ */
+
+import { beforeEach, describe, expect, it, jest } from '@jest/globals';
+
+const redirect = jest.fn((url: string) => {
+  throw new Error(`redirect:${url}`);
+});
+
+jest.mock('next/navigation', () => ({
+  redirect: (url: string) => redirect(url),
+}));
+
+jest.mock('next/headers', () => ({
+  cookies: jest.fn(async () => ({ get: () => undefined })),
+}));
+
+jest.mock('@/lib/serverAuth', () => ({
+  requireAdmin: jest.fn(async () => ({ id: 'owner-1' })),
+}));
+
+jest.mock('@/lib/pierrot/workspace/data', () => ({
+  loadOwnerHistoryView: jest.fn(),
+  loadWorkspaceOverview: jest.fn(async () => ({})),
+}));
+
+jest.mock('@/lib/pierrot/serverStore', () => ({
+  createPierrotStore: jest.fn(() => ({})),
+}));
+
+jest.mock('@/lib/pierrot/memory/brainStatus', () => ({
+  loadBrainStatus: jest.fn(async () => null),
+}));
+
+jest.mock('@/lib/pierrot/projects/store', () => ({
+  getPierrotProject: jest.fn(async () => ({
+    id: 'project-1',
+    slug: 'heart-and-angel',
+    name: 'Heart & Angel',
+  })),
+}));
+
+jest.mock('@/lib/pierrot/workspace/cache', () => ({
+  overviewCookieName: (id: string) => `pierrot-overview-${id}`,
+  parseOverviewCache: jest.fn(() => null),
+}));
+
+jest.mock('@/components/pierrot/workspace/ChatWorkspace', () => ({
+  __esModule: true,
+  default: () => null,
+}));
+
+type SearchParams = Record<string, string | string[] | undefined>;
+
+const data = jest.requireMock('@/lib/pierrot/workspace/data') as {
+  loadOwnerHistoryView: jest.Mock;
+};
+const projects = jest.requireMock('@/lib/pierrot/projects/store') as {
+  getPierrotProject: jest.Mock;
+};
+
+function viewFor(historyId: string, sessionId: string | null = null) {
+  return {
+    scope: {
+      history: { id: historyId, type: 'project', title: 'Проект' },
+      session: sessionId ? { id: sessionId } : null,
+      activeSession: null,
+      conversationId: 'conversation-1',
+      conversationSessionId: 'conversation-token',
+      project: null,
+    },
+    sessions: [],
+    conversation: {
+      id: 'conversation-1',
+      sessionId: 'conversation-token',
+      title: 'Проект',
+      consentState: 'granted',
+      messages: [],
+      hasMore: false,
+      oldestMessageIndex: null,
+      historyId,
+      historyType: 'project',
+      historyTitle: 'Проект',
+      projectId: 'project-1',
+      projectSlug: 'heart-and-angel',
+      projectName: 'Heart & Angel',
+      currentSessionId: sessionId,
+      currentSessionTitle: null,
+      activeSessionId: null,
+      oldestSequence: null,
+      newestSequence: null,
+      hasNewer: false,
+      emptyCurrentSession: false,
+    },
+    project: null,
+  };
+}
+
+async function callPage(searchParams: SearchParams | Promise<SearchParams> | undefined) {
+  // Imported lazily so the mocks above are registered first.
+  const { default: ChatPage } = await import('../page');
+
+  // Next.js 16 hands the page a Promise, never a plain object.
+  return (ChatPage as unknown as (props: { searchParams?: unknown }) => Promise<unknown>)({
+    searchParams,
+  });
+}
+
+describe('chat page search params', () => {
+  beforeEach(() => {
+    redirect.mockClear();
+    data.loadOwnerHistoryView.mockReset();
+    projects.getPierrotProject.mockClear();
+  });
+
+  it('opens the project history from a Next.js promise deep link', async () => {
+    data.loadOwnerHistoryView.mockResolvedValue(viewFor('project-history-1'));
+
+    await callPage(Promise.resolve({ history: 'project-history-1' }));
+
+    expect(data.loadOwnerHistoryView).toHaveBeenCalledWith(
+      'owner-1',
+      expect.objectContaining({ historyId: 'project-history-1', createSession: false })
+    );
+  });
+
+  it('keeps a session deep link when the same history is requested', async () => {
+    data.loadOwnerHistoryView.mockResolvedValue(viewFor('project-history-1', 'session-7'));
+
+    await callPage(Promise.resolve({ history: 'project-history-1', session: 'session-7' }));
+
+    expect(data.loadOwnerHistoryView).toHaveBeenCalledWith(
+      'owner-1',
+      expect.objectContaining({
+        historyId: 'project-history-1',
+        sessionId: 'session-7',
+        createSession: false,
+      })
+    );
+  });
+
+  it('redirects a project slug link to the project canonical history', async () => {
+    data.loadOwnerHistoryView.mockResolvedValue(viewFor('project-history-2'));
+
+    await expect(callPage(Promise.resolve({ project: 'heart-and-angel' }))).rejects.toThrow(
+      'redirect:/admin/pierrot?history=project-history-2'
+    );
+
+    expect(projects.getPierrotProject).toHaveBeenCalledWith('owner-1', 'heart-and-angel');
+    expect(data.loadOwnerHistoryView).toHaveBeenCalledWith(
+      'owner-1',
+      expect.objectContaining({ projectId: 'project-1', createSession: false })
+    );
+  });
+
+  it('redirects a legacy conversation link into the permanent history', async () => {
+    data.loadOwnerHistoryView.mockResolvedValue(viewFor('main-history', 'session-legacy'));
+
+    await expect(
+      callPage(Promise.resolve({ conversation: 'legacy-conversation' }))
+    ).rejects.toThrow('redirect:/admin/pierrot?history=main-history&session=session-legacy');
+
+    expect(data.loadOwnerHistoryView).toHaveBeenCalledWith(
+      'owner-1',
+      expect.objectContaining({
+        conversationId: 'legacy-conversation',
+        createSession: false,
+      })
+    );
+  });
+
+  it('honours the explicit new-chat flag', async () => {
+    data.loadOwnerHistoryView.mockResolvedValue(viewFor('main-history'));
+
+    const element = (await callPage(Promise.resolve({ new: '1' }))) as {
+      props?: { startNew?: boolean };
+    };
+
+    expect(data.loadOwnerHistoryView).toHaveBeenCalledWith(
+      'owner-1',
+      expect.objectContaining({ createSession: false })
+    );
+    expect(element.props?.startNew).toBe(true);
+    expect(redirect).not.toHaveBeenCalled();
+  });
+
+  it('does not start a new session for an ordinary history link', async () => {
+    data.loadOwnerHistoryView.mockResolvedValue(viewFor('main-history'));
+
+    const element = (await callPage(Promise.resolve({ history: 'main-history' }))) as {
+      props?: { startNew?: boolean };
+    };
+
+    expect(element.props?.startNew).toBe(false);
+  });
+});
