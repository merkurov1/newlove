diff --git a/lib/pierrot/workspace/__tests__/projectChatFlow.test.ts b/lib/pierrot/workspace/__tests__/projectChatFlow.test.ts
new file mode 100644
index 00000000..9b580d20
--- /dev/null
+++ b/lib/pierrot/workspace/__tests__/projectChatFlow.test.ts
@@ -0,0 +1,433 @@
+/** @jest-environment node */
+
+/**
+ * End-to-end (store-level) regression for the project chat flow that broke in
+ * production after PR #40:
+ *
+ *   open project -> see previous history -> send -> persist -> reload/resume.
+ *
+ * The fixture mirrors the production post-backfill state: the project history
+ * exists, its legacy session is closed (`ended_at` set) and every message has
+ * history/session provenance. The only write that may create a session is the
+ * first message, never a read.
+ */
+
+import { randomUUID } from 'crypto';
+import { describe, expect, it } from '@jest/globals';
+import { FakeSupabase, OWNER_ID } from '@/lib/pierrot/memory/testSupport/fakeSupabase';
+import { appendPierrotMessage } from '@/lib/pierrot/serverStore';
+import { loadOwnerHistoryViewFromStore } from '../data';
+import { resolveHistoryScope } from '@/lib/pierrot/history/store';
+
+const TABLES = [
+  'pierrot_histories',
+  'pierrot_sessions',
+  'pierrot_messages',
+  'pierrot_events',
+  'pierrot_projects',
+  'pierrot_conversations',
+  'pierrot_project_conversations',
+];
+
+type Fixture = Awaited<ReturnType<typeof seedProjectChat>>;
+
+async function seedProjectChat() {
+  const db = new FakeSupabase(TABLES);
+  const now = '2026-11-20T10:00:00.000Z';
+  const projectId = randomUUID();
+  const historyId = randomUUID();
+  const conversationId = randomUUID();
+  const closedSessionId = randomUUID();
+  const createdSessionId = randomUUID();
+
+  db.seed('pierrot_conversations', [
+    {
+      id: conversationId,
+      session_id: `session-token-${randomUUID()}`,
+      identity_type: 'owner',
+      user_id: OWNER_ID,
+      mode: 'site',
+      consent_state: 'granted',
+      title: 'Heart & Angel',
+      started_at: now,
+      updated_at: now,
+    },
+  ]);
+  db.seed('pierrot_projects', [
+    {
+      id: projectId,
+      owner_user_id: OWNER_ID,
+      slug: 'heart-and-angel',
+      name: 'Heart & Angel',
+      description: '',
+      objective: '',
+      status: 'active',
+      priority: 0,
+      project_brief: '',
+      brief_revision: 1,
+      conversation_id: conversationId,
+      last_activity_at: now,
+      created_at: now,
+      updated_at: now,
+    },
+  ]);
+  db.seed('pierrot_histories', [
+    {
+      id: historyId,
+      owner_user_id: OWNER_ID,
+      type: 'project',
+      project_id: projectId,
+      canonical_conversation_id: conversationId,
+      title: 'Heart & Angel',
+      metadata: {},
+      next_message_sequence: 5,
+      created_at: now,
+      updated_at: now,
+    },
+  ]);
+  db.seed('pierrot_sessions', [
+    {
+      id: closedSessionId,
+      history_id: historyId,
+      conversation_id: conversationId,
+      source_conversation_id: null,
+      ordinal: 1,
+      title: 'Прежняя история',
+      started_at: now,
+      // Production backfill closes every migrated legacy episode.
+      ended_at: now,
+      last_message_at: now,
+      message_count: 4,
+      first_message_sequence: 1,
+      last_message_sequence: 4,
+      metadata: {},
+      created_at: now,
+      updated_at: now,
+    },
+  ]);
+  db.seed(
+    'pierrot_messages',
+    Array.from({ length: 4 }, (_, index) => ({
+      id: `old-message-${index + 1}`,
+      conversation_id: conversationId,
+      role: index % 2 === 0 ? 'user' : 'assistant',
+      content: `Previous message ${index + 1}`,
+      message_index: index + 1,
+      provider: null,
+      created_at: `2026-11-20T10:0${index}:00.000Z`,
+      history_id: historyId,
+      session_id: closedSessionId,
+      history_sequence: index + 1,
+    }))
+  );
+
+  db.onRpc('pierrot_ensure_project_history', () => ({ data: historyId, error: null }));
+
+  db.onRpc('pierrot_create_session', (params) => {
+    const sessions = db.all('pierrot_sessions');
+    const ordinal = Math.max(0, ...sessions.map((row) => Number(row.ordinal || 0))) + 1;
+    const row = {
+      id: createdSessionId,
+      history_id: params.p_history_id,
+      conversation_id: conversationId,
+      source_conversation_id: null,
+      ordinal,
+      title: (params.p_title as string) || 'Новая сессия',
+      started_at: '2026-11-20T11:00:00.000Z',
+      ended_at: null,
+      last_message_at: null,
+      message_count: 0,
+      first_message_sequence: null,
+      last_message_sequence: null,
+      metadata: {},
+      created_at: '2026-11-20T11:00:00.000Z',
+      updated_at: '2026-11-20T11:00:00.000Z',
+    };
+    sessions.push(row);
+    return { data: [row], error: null };
+  });
+
+  db.onRpc('pierrot_append_message_v2', (params) => {
+    const messages = db.all('pierrot_messages');
+    const existing = messages.find((row) => row.id === params.p_message_id);
+    if (existing) {
+      return {
+        data: [
+          {
+            sequence: existing.message_index,
+            content: existing.content,
+            inserted: false,
+            history_sequence: existing.history_sequence,
+          },
+        ],
+        error: null,
+      };
+    }
+
+    const history = db.all('pierrot_histories').find((row) => row.id === params.p_history_id);
+    if (!history) return { data: null, error: { code: 'P0002', message: 'history_not_found' } };
+    if (params.p_history_id !== historyId) {
+      return { data: null, error: { code: 'P0002', message: 'wrong_history' } };
+    }
+
+    const episode = db
+      .all('pierrot_sessions')
+      .find((row) => row.id === params.p_episode_id && row.history_id === params.p_history_id);
+    if (!episode) return { data: null, error: { code: 'P0002', message: 'session_not_found' } };
+
+    const sequence = Number(history.next_message_sequence || 1);
+    history.next_message_sequence = sequence + 1;
+    const messageIndex =
+      Math.max(
+        0,
+        ...messages
+          .filter((row) => row.conversation_id === params.p_conversation_id)
+          .map((row) => Number(row.message_index || 0))
+      ) + 1;
+
+    messages.push({
+      id: params.p_message_id,
+      conversation_id: params.p_conversation_id,
+      role: params.p_role,
+      content: params.p_content,
+      message_index: messageIndex,
+      provider: params.p_provider,
+      created_at: '2026-11-20T11:01:00.000Z',
+      history_id: params.p_history_id,
+      session_id: params.p_episode_id,
+      history_sequence: sequence,
+    });
+
+    episode.message_count = Number(episode.message_count || 0) + 1;
+    episode.first_message_sequence = episode.first_message_sequence ?? sequence;
+    episode.last_message_sequence = sequence;
+    episode.last_message_at = '2026-11-20T11:01:00.000Z';
+    episode.updated_at = '2026-11-20T11:01:00.000Z';
+    if (params.p_role === 'user' && episode.title === 'Новая сессия') {
+      episode.title = String(params.p_content).slice(0, 120);
+    }
+
+    return {
+      data: [
+        {
+          sequence: messageIndex,
+          content: params.p_content,
+          inserted: true,
+          history_sequence: sequence,
+        },
+      ],
+      error: null,
+    };
+  });
+
+  return { db, projectId, historyId, conversationId, closedSessionId, createdSessionId };
+}
+
+async function sendRecordedTurn(
+  fixture: Fixture,
+  input: { userText: string; replyText: string }
+): Promise<string> {
+  const scope = await resolveHistoryScope(fixture.db.asClient(), OWNER_ID, {
+    historyId: fixture.historyId,
+    createSession: true,
+  });
+  expect(scope?.session).not.toBeNull();
+  const episodeId = scope!.session!.id;
+
+  const userMessageId = randomUUID();
+  await appendPierrotMessage(fixture.db.asClient(), {
+    conversationId: scope!.conversationId,
+    sessionId: scope!.conversationSessionId,
+    historyId: fixture.historyId,
+    episodeId,
+    messageId: userMessageId,
+    role: 'user',
+    content: input.userText,
+    provider: null,
+  });
+
+  await appendPierrotMessage(fixture.db.asClient(), {
+    conversationId: scope!.conversationId,
+    sessionId: scope!.conversationSessionId,
+    historyId: fixture.historyId,
+    episodeId,
+    messageId: randomUUID(),
+    role: 'assistant',
+    content: input.replyText,
+    provider: 'deepseek',
+  });
+
+  return episodeId;
+}
+
+describe('project chat: open history, send, reload and resume', () => {
+  it('opens the canonical project history without creating an empty session', async () => {
+    const fixture = await seedProjectChat();
+
+    const view = await loadOwnerHistoryViewFromStore(fixture.db.asClient(), OWNER_ID, {
+      historyId: fixture.historyId,
+    });
+
+    expect(view?.scope.history.id).toBe(fixture.historyId);
+    expect(view?.conversation.projectSlug).toBe('heart-and-angel');
+    expect(view?.conversation.messages.map((message) => message.content)).toEqual([
+      'Previous message 1',
+      'Previous message 2',
+      'Previous message 3',
+      'Previous message 4',
+    ]);
+    // The closed legacy episode is readable but is not a write target.
+    expect(view?.conversation.activeSessionId).toBeNull();
+    expect(fixture.db.all('pierrot_sessions')).toHaveLength(1);
+  });
+
+  it('creates exactly one open session on the first message and persists both turns', async () => {
+    const fixture = await seedProjectChat();
+
+    const episodeId = await sendRecordedTurn(fixture, {
+      userText: 'Continue the project chat',
+      replyText: 'The project chat is working.',
+    });
+
+    expect(episodeId).toBe(fixture.createdSessionId);
+    expect(fixture.db.all('pierrot_histories')).toHaveLength(1);
+    expect(fixture.db.all('pierrot_sessions')).toHaveLength(2);
+
+    const created = fixture.db
+      .all('pierrot_sessions')
+      .find((row) => row.id === fixture.createdSessionId);
+    expect(created?.ended_at).toBeNull();
+    expect(created?.message_count).toBe(2);
+    // The closed episode is preserved untouched.
+    const closed = fixture.db
+      .all('pierrot_sessions')
+      .find((row) => row.id === fixture.closedSessionId);
+    expect(closed?.message_count).toBe(4);
+    expect(closed?.last_message_sequence).toBe(4);
+
+    const persisted = fixture.db
+      .all('pierrot_messages')
+      .filter((row) => row.session_id === fixture.createdSessionId);
+    expect(persisted.map((row) => row.content)).toEqual([
+      'Continue the project chat',
+      'The project chat is working.',
+    ]);
+    expect(persisted.map((row) => row.history_sequence)).toEqual([5, 6]);
+  });
+
+  it('shows the saved dialogue after a reload and resumes the same chat', async () => {
+    const fixture = await seedProjectChat();
+    const episodeId = await sendRecordedTurn(fixture, {
+      userText: 'Continue the project chat',
+      replyText: 'The project chat is working.',
+    });
+
+    // Reload of the canonical project URL (no ?session=): continuous history.
+    const reloaded = await loadOwnerHistoryViewFromStore(fixture.db.asClient(), OWNER_ID, {
+      historyId: fixture.historyId,
+    });
+
+    expect(reloaded?.conversation.messages.map((message) => message.content)).toEqual([
+      'Previous message 1',
+      'Previous message 2',
+      'Previous message 3',
+      'Previous message 4',
+      'Continue the project chat',
+      'The project chat is working.',
+    ]);
+    expect(reloaded?.conversation.activeSessionId).toBe(episodeId);
+    expect(reloaded?.conversation.hasNewer).toBe(false);
+
+    // Direct session link (reload of the URL written after the turn).
+    const resumed = await loadOwnerHistoryViewFromStore(fixture.db.asClient(), OWNER_ID, {
+      historyId: fixture.historyId,
+      sessionId: episodeId,
+    });
+    expect(resumed?.conversation.messages.map((message) => message.content)).toEqual([
+      'Continue the project chat',
+      'The project chat is working.',
+    ]);
+    expect(resumed?.conversation.currentSessionId).toBe(episodeId);
+    expect(resumed?.conversation.activeSessionId).toBe(episodeId);
+
+    // A second turn must continue the same open session, not create a third.
+    const secondEpisodeId = await sendRecordedTurn(fixture, {
+      userText: 'Second message',
+      replyText: 'Second answer',
+    });
+    expect(secondEpisodeId).toBe(episodeId);
+    expect(fixture.db.all('pierrot_sessions')).toHaveLength(2);
+
+    const afterSecondTurn = await loadOwnerHistoryViewFromStore(fixture.db.asClient(), OWNER_ID, {
+      historyId: fixture.historyId,
+    });
+    expect(afterSecondTurn?.conversation.messages).toHaveLength(8);
+  });
+
+  it('keeps project histories isolated from MAIN', async () => {
+    const fixture = await seedProjectChat();
+    const mainHistoryId = randomUUID();
+    const mainConversationId = randomUUID();
+
+    fixture.db.seed('pierrot_conversations', [
+      ...fixture.db.all('pierrot_conversations'),
+      {
+        id: mainConversationId,
+        session_id: `main-token-${randomUUID()}`,
+        identity_type: 'owner',
+        user_id: OWNER_ID,
+        mode: 'site',
+        consent_state: 'granted',
+        started_at: '2026-11-20T09:00:00.000Z',
+        updated_at: '2026-11-20T09:00:00.000Z',
+      },
