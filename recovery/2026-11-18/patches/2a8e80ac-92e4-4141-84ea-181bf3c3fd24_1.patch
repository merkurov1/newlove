+  isUuid,
+  listAttempts,
+  listAttemptsForTasks,
+  listBatchDependencies,
+  listDeploymentTaskStates,
+  listPushedReleaseItems,
+  listReleaseTaskStates,
+  listTaskRows,
+  patchAttempt,
+  patchTask,
+  patchTaskRelease,
+  updateLatestReleaseItemDeployment,
+  updateRelease,
+  updateReleaseItem,
+  type ReleaseTaskState,
+} from './store';
+import {
+  commitUrl,
+  compareCommits,
+  createPullRequestForAttempt,
+  getBranchHead,
+  getCommitChecks,
+  getPullRequestStatus,
+  getVercelDeploymentStatus,
+  mergeVerifiedPullRequest,
+} from './github';
+import { notifyDevOwner } from './notifications';
+import type {
+  DevAttempt,
+  DevReleaseItem,
+  DevReleasePreflight,
+  DevReleasePreflightItem,
+  DevReleaseQueueItem,
+  DevReleaseReport,
+  DevReleaseState,
+  DevReleaseSummary,
+  DevValidationState,
+  DevWorkbenchTask,
+} from './types';
+
+assertServerOnly('lib/pierrot/dev/workbench/release');
+
+export const RELEASE_BATCH_LIMIT = 10;
+const MAIN_BRANCH = 'main';
+const DEPLOYMENT_REFRESH_WINDOW_MS = 45_000;
+
+let lastDeploymentRefreshAt = 0;
+
+export class ReleaseError extends Error {
+  readonly code: string;
+  readonly status: number;
+
+  constructor(code: string, message: string, status = 409) {
+    super(message);
+    this.name = 'ReleaseError';
+    this.code = code;
+    this.status = status;
+  }
+}
+
+/**
+ * Promotion to main is owner-only. Every Admin path already requires an ADMIN
+ * session; when a specific owner id is configured, that id is the only one
+ * allowed to run the release action (the machine admin secret is also accepted
+ * so an automated owner runbook keeps working).
+ */
+export function isPromotionOwner(admin: { id: string; role: string }): boolean {
+  if (admin.role !== 'ADMIN') return false;
+  const configured = (process.env.PIERROT_DEV_OWNER_USER_ID || '').trim();
+  if (!configured) return true;
+  return admin.id === configured || admin.id === 'system-admin';
+}
+
+export function releaseStateLabel(state: DevReleaseState): string {
+  const labels: Record<DevReleaseState, string> = {
+    none: 'Not committed',
+    no_changes: 'No changes',
+    validation_failed: 'Validation failed',
+    committed: 'Committed',
+    ready: 'Ready to Push',
+    blocked: 'Blocked',
+    pushing: 'Pushing',
+    in_main: 'In main',
+    deployment_pending: 'Deployment pending',
+    deployed: 'Deployed',
+    deployment_failed: 'Deployment failed',
+  };
+  return labels[state] || state;
+}
+
+function nowIso(): string {
+  return new Date().toISOString();
+}
+
+function text(value: unknown, limit = 1600): string {
+  return typeof value === 'string' ? value.trim().slice(0, limit) : '';
+}
+
+function isFullSha(value: unknown): value is string {
+  return typeof value === 'string' && /^[0-9a-f]{40}$/i.test(value.trim());
+}
+
+function parsePrNumber(url: string): number | null {
+  const match = String(url || '').match(/\/pull\/(\d+)(?:\b|$)/);
+  if (!match) return null;
+  const number = Number(match[1]);
+  return Number.isSafeInteger(number) && number > 0 ? number : null;
+}
+
+// ---------------------------------------------------------------------------
+// Pure validation and ordering (unit-testable, no I/O)
+// ---------------------------------------------------------------------------
+
+export type AttemptValidation = {
+  commitSha: string | null;
+  branch: string | null;
+  changedFiles: string[];
+  validationState: DevValidationState;
+  releaseState: DevReleaseState;
+  detail: string;
+  passedCommands: number;
+  failedCommands: number;
+};
+
+/**
+ * Decide whether a completed attempt has a real, validated commit.
+ *
+ * A failed local command always wins. A commit with no reported verification is
+ * recorded as committed but never as ready; preflight can later upgrade it with
+ * a passing GitHub check run, which is real independent evidence.
+ */
+export function evaluateAttemptValidation(input: {
+  headSha: string | null;
+  branch: string | null;
+  expectedBranch: string | null;
+  changedFiles: string[];
+  commands: Array<{ name?: string; status?: string }>;
+}): AttemptValidation {
+  const commitSha = isFullSha(input.headSha) ? input.headSha.trim().toLowerCase() : null;
+  const branch = text(input.branch, 200) || null;
+  const changedFiles = Array.isArray(input.changedFiles)
+    ? input.changedFiles.filter((file): file is string => typeof file === 'string').slice(0, 200)
+    : [];
+  const commands = Array.isArray(input.commands) ? input.commands : [];
+  const failed = commands.filter((command) => command?.status === 'failed');
+  const passed = commands.filter((command) => command?.status === 'passed');
+
+  const base = {
+    commitSha,
+    branch,
+    changedFiles,
+    passedCommands: passed.length,
+    failedCommands: failed.length,
+  };
+
+  if (!commitSha || changedFiles.length === 0) {
+    return {
+      ...base,
+      validationState: 'none',
+      releaseState: 'no_changes',
+      detail:
+        changedFiles.length === 0
+          ? 'The attempt produced no changed files. No empty commit was created.'
+          : 'The attempt did not report a commit SHA. Nothing can be released.',
+    };
+  }
+
+  if (input.expectedBranch && branch !== input.expectedBranch) {
+    return {
+      ...base,
+      validationState: 'failed',
+      releaseState: 'validation_failed',
+      detail: `Attempt branch ${branch || 'unknown'} does not match ${input.expectedBranch}.`,
+    };
+  }
+
+  if (failed.length > 0) {
+    return {
+      ...base,
+      validationState: 'failed',
+      releaseState: 'validation_failed',
+      detail: `Failed checks: ${failed
+        .map((command) => text(command.name, 120) || 'command')
+        .slice(0, 6)
+        .join(', ')}. The commit cannot become Ready to Push.`,
+    };
+  }
+
+  if (passed.length > 0) {
+    return {
+      ...base,
+      validationState: 'passed',
+      releaseState: 'ready',
+      detail: `${passed.length} verification command(s) passed before the commit was recorded.`,
+    };
+  }
+
+  return {
+    ...base,
+    validationState: 'unverified',
+    releaseState: 'committed',
+    detail:
+      'The commit is recorded, but no passing local verification command was reported. A passing GitHub check run is required before Ready to Push.',
+  };
+}
+
+/** Stable dependency ordering. Dependencies outside the selection are ignored here. */
+export function orderReleaseItems<T extends { taskId: string; dependsOnTaskId: string | null }>(
+  items: T[]
+): { ordered: T[]; cycle: boolean } {
+  const byId = new Map(items.map((item) => [item.taskId, item]));
+  const remaining = [...items];
+  const ordered: T[] = [];
+  const placed = new Set<string>();
+  while (remaining.length > 0) {
+    const index = remaining.findIndex((item) => {
+      if (!item.dependsOnTaskId) return true;
+      if (!byId.has(item.dependsOnTaskId)) return true;
+      return placed.has(item.dependsOnTaskId);
+    });
+    if (index < 0) return { ordered: items, cycle: true };
+    const [next] = remaining.splice(index, 1);
+    ordered.push(next);
+    placed.add(next.taskId);
+  }
+  return { ordered, cycle: false };
+}
+
+export function buildReleaseRequestKey(
+  items: Array<{ taskId: string; commitSha: string | null }>
+): string {
+  const signature = [...items]
+    .map((item) => `${item.taskId}:${item.commitSha || 'none'}`)
+    .sort()
+    .join('|');
+  return `release:${createHash('sha256').update(signature).digest('hex').slice(0, 40)}`;
+}
+
+// ---------------------------------------------------------------------------
+// Commit recording on task completion
+// ---------------------------------------------------------------------------
+
+/**
+ * Called when an attempt completes. The worker has already created and pushed
+ * the commit; this records it, runs the validation policy and makes the task
+ * visible as Committed or Ready to Push. It never merges anything.
+ */
+export async function recordAttemptCommit(input: {
+  task: DevWorkbenchTask;
+  attempt: DevAttempt;
+}): Promise<AttemptValidation | null> {
+  if (!(await isReleaseSchemaReady())) return null;
+  const { task, attempt } = input;
+
+  let expected: string | null = null;
+  try {
+    expected = expectedBranch(attempt.taskId, attempt.attemptNumber);
+  } catch {
+    expected = null;
+  }
+
+  const validation = evaluateAttemptValidation({
+    headSha: attempt.headSha,
+    branch: attempt.branch,
+    expectedBranch: expected,
+    changedFiles: attempt.changedFiles,
+    commands: attempt.commands,
+  });
+
+  let verifiedOnGitHub = false;
+  if (validation.commitSha && validation.branch) {
+    try {
+      const head = await getBranchHead(task.repository, validation.branch);
+      verifiedOnGitHub = Boolean(head && head.toLowerCase() === validation.commitSha);
+    } catch {
+      verifiedOnGitHub = false;
+    }
+  }
+
+  let releaseState = validation.releaseState;
+  let detail = validation.detail;
+  if (releaseState === 'ready' && !verifiedOnGitHub) {
+    releaseState = 'committed';
+    detail =
+      'The commit is recorded locally, but the GitHub branch head did not confirm it yet. Preflight will verify it before any push.';
+  }
+
+  const recordedAt = nowIso();
+  await patchTaskRelease(task.id, {
+    release_state: releaseState,
+    release_detail: detail,
+    validation_state: validation.validationState,
+    committed_at: validation.commitSha ? recordedAt : null,
+  });
+
+  await patchAttempt(attempt.id, {
+    verification: {
+      ...(attempt.verification || {}),
+      commit: {
+        sha: validation.commitSha,
+        branch: validation.branch,
+        recordedAt,
+        verifiedOnGitHub,
+        changedFiles: validation.changedFiles.length,
+      },
+      validation: {
+        state: validation.validationState,
+        detail,
+        passedCommands: validation.passedCommands,
+        failedCommands: validation.failedCommands,
+      },
+    },
+  }).catch(() => null);
+
+  const eventType =
+    releaseState === 'no_changes'
+      ? 'task.no_changes'
+      : releaseState === 'validation_failed'
+        ? 'task.validation_failed'
+        : releaseState === 'ready'
+          ? 'task.committed'
+          : 'task.commit_recorded';
+  await appendEvent({
+    taskId: task.id,
+    attemptId: attempt.id,
+    type: eventType,
+    level: releaseState === 'validation_failed' || releaseState === 'no_changes' ? 'warn' : 'info',
+    message: `${releaseStateLabel(releaseState)}: ${detail}`,
+    payload: {
+      commitSha: validation.commitSha,
+      branch: validation.branch,
+      validationState: validation.validationState,
+      verifiedOnGitHub,
+    },
+    dedupeKey: `commit-recorded:${attempt.id}`,
+  }).catch(() => {});
+
+  return { ...validation, releaseState, detail };
+}
+
+// ---------------------------------------------------------------------------
+// Release summary (read-only, no network)
+// ---------------------------------------------------------------------------
+
+function emptyReleaseSummary(schemaReady: boolean): DevReleaseSummary {
+  return {
+    schemaReady,
+    migrationFile: RELEASE_MIGRATION_FILE,
+    counts: {
+      ready: 0,
+      committed: 0,
+      validationFailed: 0,
+      blocked: 0,
+      noChanges: 0,
+      pushing: 0,
+      inMain: 0,
+      deploymentPending: 0,
+      deployed: 0,
+      deploymentFailed: 0,
+      needsReconciliation: 0,
+    },
+    readyTasks: 0,
+    readyCommits: 0,
+    items: [],
+    main: { sha: null, url: null, releaseId: null, updatedAt: null },
+    production: null,
+    activeRelease: null,
+    lastRelease: null,
+    updatedAt: nowIso(),
+  };
+}
+
+function taskReleaseItem(input: {
+  task: DevWorkbenchTask;
+  attempt: DevAttempt | null;
+  state: ReleaseTaskState;
+  releaseItem: DevReleaseItem | null;
+  dependsOnTaskId: string | null;
+  needsReconciliation: boolean;
+}): DevReleaseQueueItem {
+  const { task, attempt, state, releaseItem, dependsOnTaskId, needsReconciliation } = input;
+  const commands = attempt?.commands || [];
+  const commitSha = attempt?.headSha || task.resultCommit;
+  return {
+    taskId: task.id,
+    title: task.title,
+    releaseState: state.releaseState,
+    releaseLabel: needsReconciliation ? 'Needs reconciliation' : releaseStateLabel(state.releaseState),
+    releaseDetail: state.releaseDetail,
+    validationState: state.validationState,
+    commitSha,
+    branch: attempt?.branch || null,
+    attemptId: attempt?.id || null,
+    attemptNumber: attempt?.attemptNumber ?? null,
+    prNumber: attempt?.prNumber ?? parsePrNumber(attempt?.prUrl || task.pullRequests[0] || ''),
+    prUrl: attempt?.prUrl || task.pullRequests[0] || null,
+    changedFiles: attempt?.changedFiles || [],
+    commands: {
+      total: commands.length,
+      passed: commands.filter((command) => command.status === 'passed').length,
+      failed: commands.filter((command) => command.status === 'failed').length,
+    },
+    checks: releaseItem?.checks || [],
+    committedAt: state.committedAt,
+    completedAt: attempt?.finishedAt || null,
+    dependsOnTaskId,
+    conflicted: releaseItem?.status === 'conflict',
+    inMain: ['in_main', 'deployment_pending', 'deployed', 'deployment_failed'].includes(
+      state.releaseState
+    ),
+    deployed: state.releaseState === 'deployed',
+    pendingMainConfirmation: releaseItem?.status === 'pushed',
+    mainSha: state.mainSha,
+    deployedAt: state.deployedAt,
+    deploymentState: state.deploymentState,
+    deploymentUrl: state.deploymentUrl,
+    actionRequired:
+      state.releaseState === 'validation_failed'
+        ? 'Fix the failed checks and retry the task.'
+        : state.releaseState === 'no_changes'
+          ? 'Review why the executor produced no changes.'
+          : state.releaseState === 'blocked'
+            ? 'Resolve the reported conflict, check failure or dependency.'
+            : state.releaseState === 'deployment_failed'
+              ? 'Check the Vercel deployment and retry the production deployment.'
+              : releaseItem?.status === 'pushed'
+                ? 'GitHub accepted the merge; waiting for main confirmation. Use Verify main & Vercel.'
+                : needsReconciliation
+                  ? 'Run Reconcile existing PRs to import the current PR state.'
+                  : null,
+    needsReconciliation,
+  };
+}
+
+export async function getReleaseSummary(
+  userId: string,
+  tasks: DevWorkbenchTask[]
+): Promise<DevReleaseSummary> {
+  const schemaReady = await isReleaseSchemaReady();
+  if (!schemaReady) return emptyReleaseSummary(false);
+
+  const [states, latestRelease, activeRelease] = await Promise.all([
+    listReleaseTaskStates(tasks.map((task) => task.id)),
+    getLatestReleaseRow(),
+    getActiveReleaseRow(),
+  ]);
+
+  const candidateIds = tasks
+    .filter((task) => {
+      const state = states.get(task.id);
+      return (
+        (state && state.releaseState !== 'none') ||
+        (['review', 'verified'].includes(task.status) && task.pullRequests.length > 0)
+      );
+    })
+    .map((task) => task.id);
+  const [attemptsByTask, dependencies] = await Promise.all([
+    listAttemptsForTasks(candidateIds, 1),
+    listBatchDependencies(candidateIds),
+  ]);
+
+  const releaseItems = latestRelease?.items || [];
+  const items: DevReleaseQueueItem[] = [];
+  for (const task of tasks) {
+    const state = states.get(task.id);
+    const attempt = (attemptsByTask.get(task.id) || [])[0] || null;
+    const needsReconciliation =
+      (!state || state.releaseState === 'none') &&
+      ['review', 'verified'].includes(task.status) &&
+      task.pullRequests.length > 0;
+    if ((!state || state.releaseState === 'none') && !needsReconciliation) continue;
+    const resolvedState =
+      state ||
+      {
+        taskId: task.id,
+        releaseState: 'none' as DevReleaseState,
+        releaseDetail: null,
+        validationState: 'none' as DevValidationState,
+        committedAt: null,
+        mainSha: null,
+        deployedAt: null,
+        deploymentState: null,
+        deploymentUrl: null,
+        releaseId: null,
+      };
+    items.push(
+      taskReleaseItem({
+        task,
+        attempt,
+        state: resolvedState,
+        releaseItem: releaseItems.find((item) => item.taskId === task.id) || null,
+        dependsOnTaskId: dependencies.get(task.id) || null,
+        needsReconciliation,
+      })
+    );
+  }
+
+  const count = (value: DevReleaseState) =>
+    items.filter((item) => item.releaseState === value && !item.needsReconciliation).length;
+  const counts = {
+    ready: count('ready'),
+    committed: count('committed'),
+    validationFailed: count('validation_failed'),
+    blocked: count('blocked'),
+    noChanges: count('no_changes'),
+    pushing: count('pushing'),
+    inMain: count('in_main'),
+    deploymentPending: count('deployment_pending'),
+    deployed: count('deployed'),
+    deploymentFailed: count('deployment_failed'),
+    needsReconciliation: items.filter((item) => item.needsReconciliation).length,
+  };
+
+  const mainItem =
+    items.find((item) => item.inMain && item.mainSha) ||
+    items.find((item) => Boolean(item.mainSha));
+  const productionItem =
+    items.find((item) => item.releaseState === 'deployed') ||
+    items.find((item) => item.releaseState === 'deployment_pending') ||
+    items.find((item) => item.releaseState === 'deployment_failed') ||
+    items.find((item) => Boolean(item.deploymentState));
+
+  return {
+    schemaReady: true,
+    migrationFile: RELEASE_MIGRATION_FILE,
+    counts,
+    readyTasks: items.filter(
+      (item) => item.releaseState === 'ready' || item.releaseState === 'committed'
+    ).length,
+    readyCommits: new Set(
+      items
+        .filter(
+          (item) =>
+            (item.releaseState === 'ready' || item.releaseState === 'committed') && item.commitSha
+        )
+        .map((item) => item.commitSha)
+    ).size,
+    items,
+    main: {
+      sha: latestRelease?.mainSha || mainItem?.mainSha || null,
+      url:
+        latestRelease?.mainSha
+          ? commitUrl('newlove', latestRelease.mainSha)
+          : mainItem?.mainSha
+            ? commitUrl('newlove', mainItem.mainSha)
+            : null,
+      releaseId: latestRelease?.id || null,
+      updatedAt: latestRelease?.updatedAt || mainItem?.committedAt || null,
+    },
+    production: productionItem
+      ? {
+          state: productionItem.releaseState,
+          url: productionItem.deploymentUrl,
+          commitSha: productionItem.mainSha,
+          taskId: productionItem.taskId,
+          taskTitle: productionItem.title,
+          checkedAt: latestRelease?.updatedAt || productionItem.committedAt,
+          reason: productionItem.releaseDetail,
+        }
+      : null,
+    activeRelease,
+    lastRelease: latestRelease,
+    updatedAt: nowIso(),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Preflight
+// ---------------------------------------------------------------------------
+
+function blockedItem(
+  base: Partial<DevReleasePreflightItem> & { taskId: string; title: string },
+  reasons: string[],
+  status: 'ready' | 'blocked' | 'conflict' = 'blocked'
+): DevReleasePreflightItem {
+  return {
+    taskId: base.taskId,
+    title: base.title,
+    attemptId: base.attemptId || null,
+    attemptNumber: base.attemptNumber ?? null,
+    commitSha: base.commitSha || null,
+    branch: base.branch || null,
+    prNumber: base.prNumber ?? null,
+    prUrl: base.prUrl || null,
+    baseRef: base.baseRef || MAIN_BRANCH,
+    changedFiles: base.changedFiles || [],
+    dependsOnTaskId: base.dependsOnTaskId || null,
+    dependencySatisfied: base.dependencySatisfied !== false,
+    ancestry: base.ancestry || null,
+    mergeable: base.mergeable ?? null,
+    checks: base.checks || null,
+    status,
+    reasons:
+      reasons.length > 0 ? reasons : ['The task is not ready to be promoted.'],
+    warnings: base.warnings || [],
+  };
+}
+
+export async function preflightRelease(input: {
+  userId: string;
+  taskIds: string[];
+}): Promise<DevReleasePreflight> {
+  const taskIds = [...new Set(input.taskIds.filter(isUuid))];
+  if (taskIds.length === 0) {
+    throw new ReleaseError('RELEASE_TASKS_REQUIRED', 'Select at least one ready task.', 400);
+  }
+  if (taskIds.length > RELEASE_BATCH_LIMIT) {
+    throw new ReleaseError(
+      'RELEASE_BATCH_TOO_LARGE',
+      `A release batch can contain at most ${RELEASE_BATCH_LIMIT} commits.`,
+      400
+    );
+  }
+  if (!(await isReleaseSchemaReady())) {
+    throw new ReleaseError(
+      'RELEASE_MIGRATION_REQUIRED',
+      `The release pipeline requires the additive migration ${RELEASE_MIGRATION_FILE}.`,
+      503
+    );
+  }
+
+  const [states, dependencies] = await Promise.all([
+    listReleaseTaskStates(taskIds),
+    listBatchDependencies(taskIds),
+  ]);
+  const baseSha = await getBranchHead('newlove', MAIN_BRANCH).catch(() => null);
+  const items: DevReleasePreflightItem[] = [];
+
+  for (const taskId of taskIds) {
+    const task = await getTaskRow(input.userId, taskId);
+    if (!task) {
+      items.push(
+        blockedItem({ taskId, title: taskId }, ['Task not found or not owned by the owner.'])
+      );
+      continue;
+    }
+    const state = states.get(taskId);
+    const attempts = await listAttempts(task.id, 5);
+    const attempt =
+      attempts.find((item) => item.status === 'completed' && item.headSha) || null;
+    const dependsOnTaskId = dependencies.get(taskId) || null;
+    const base: Partial<DevReleasePreflightItem> & { taskId: string; title: string } = {
+      taskId: task.id,
+      title: task.title,
+      attemptId: attempt?.id || null,
+      attemptNumber: attempt?.attemptNumber ?? null,
+      commitSha: attempt?.headSha || null,
+      branch: attempt?.branch || null,
+      prNumber: attempt?.prNumber ?? parsePrNumber(attempt?.prUrl || task.pullRequests[0] || ''),
+      prUrl: attempt?.prUrl || task.pullRequests[0] || null,
+      baseRef: task.baseRef || MAIN_BRANCH,
+      changedFiles: attempt?.changedFiles || [],
+      dependsOnTaskId,
+      warnings: [],
+    };
+
+    if (!attempt || !isFullSha(attempt.headSha)) {
+      items.push(blockedItem(base, ['No completed attempt with a recorded commit SHA.']));
+      continue;
+    }
+    if (!state || state.releaseState === 'none') {
+      items.push(
+        blockedItem(base, [
+          'This task predates the release ledger. Run Reconcile existing PRs first.',
+        ])
+      );
+      continue;
+    }
+    if (state.releaseState === 'no_changes') {
+      items.push(blockedItem(base, ['The attempt produced no changes; there is nothing to push.']));
+      continue;
+    }
+    if (state.releaseState === 'validation_failed') {
+      items.push(
+        blockedItem(base, [
+          state.releaseDetail || 'Validation failed for this attempt. Retry the task first.',
+        ])
+      );
+      continue;
+    }
+    if (state.releaseState === 'blocked') {
+      items.push(
+        blockedItem(base, [state.releaseDetail || 'The task is blocked and cannot be pushed.'])
+      );
+      continue;
+    }
+    if (
+      ['in_main', 'deployment_pending', 'deployed', 'deployment_failed', 'pushing'].includes(
+        state.releaseState
+      )
+    ) {
+      items.push(
+        blockedItem(base, [
+          `Release state is already ${releaseStateLabel(state.releaseState)}; it cannot be pushed again.`,
+        ])
+      );
+      continue;
+    }
+    if (!['ready', 'committed'].includes(state.releaseState)) {
+      items.push(blockedItem(base, [`Unsupported release state: ${state.releaseState}.`]));
+      continue;
+    }
+    if (!baseSha) {
+      items.push(
+        blockedItem(base, [`Could not read the current ${MAIN_BRANCH} head from GitHub.`])
+      );
+      continue;
+    }
+
+    const commitSha = attempt.headSha.toLowerCase();
+    const reasons: string[] = [];
+    const warnings: string[] = [];
+
+    if (attempt.branch) {
+      const branchHead = await getBranchHead(task.repository, attempt.branch).catch(() => null);
+      if (!branchHead) {
+        reasons.push(`GitHub did not return the head of ${attempt.branch}.`);
+      } else if (branchHead.toLowerCase() !== commitSha) {
+        reasons.push(
+          `Branch ${attempt.branch} moved after the recorded commit (${commitSha.slice(0, 7)}).`
+        );
+      }
+    } else {
+      reasons.push('The attempt has no recorded branch.');
+    }
+
+    const ancestry = await compareCommits(task.repository, baseSha, commitSha).catch(() => null);
+    if (!ancestry || ancestry.status === 'unknown') {
+      reasons.push(`Could not verify commit ancestry against ${MAIN_BRANCH}.`);
+    } else if (ancestry.status !== 'ahead' || ancestry.aheadBy < 1) {
+      reasons.push(
+        `The commit is ${ancestry.status} relative to ${MAIN_BRANCH}; it must be ahead by at least one commit.`
+      );
+    }
+
+    const prNumber = base.prNumber ?? null;
+    let prUrl = base.prUrl ?? null;
+    let mergeable: boolean | null = null;
+    if (prNumber) {
+      const pr = await getPullRequestStatus(task.repository, prNumber).catch(() => null);
+      if (!pr) {
+        reasons.push(`GitHub did not return PR #${prNumber}.`);
+      } else {
+        prUrl = pr.url;
+        mergeable = pr.mergeable;
+        if (pr.merged) {
+          reasons.push('The pull request is already merged. Reconcile the task first.');
+        } else if (pr.state !== 'open') {
+          reasons.push(`The pull request is ${pr.state}, not open.`);
+        }
+        if (pr.headSha.toLowerCase() !== commitSha) {
+          reasons.push('The pull request head moved after the recorded commit.');
+        }
+        if (pr.baseBranch !== task.baseRef) {
+          reasons.push(`The pull request targets ${pr.baseBranch}, not ${task.baseRef}.`);
+        }
+        if (pr.mergeable === false) {
+          reasons.push(
+            `Pull request #${prNumber} is not mergeable (${pr.mergeableState || 'conflict'}).`
+          );
+        }
+      }
+    }
+
+    const checks = await getCommitChecks(task.repository, commitSha).catch(() => null);
+    if (!checks) {
+      reasons.push('Could not read GitHub checks for the commit.');
+    } else if (checks.status === 'failed') {
+      reasons.push(`CI failed: ${checks.detail}`);
+    } else if (checks.status === 'pending') {
+      reasons.push(`CI is still running: ${checks.detail}`);
+    } else if (checks.status === 'unknown') {
+      reasons.push(`CI status is unknown: ${checks.detail}`);
+    } else if (checks.status === 'none') {
+      if (state.validationState !== 'passed') {
+        reasons.push(
+          'No GitHub CI checks and no passing local verification command. The commit cannot be validated.'
+        );
+      } else {
+        warnings.push('No GitHub CI checks are attached; local verification passed.');
+      }
+    } else if (checks.status === 'passed' && state.validationState !== 'passed') {
+      warnings.push('Validation evidence came from GitHub CI, not executor-reported commands.');
+    }
+
+    if (dependsOnTaskId) {
+      const dependencyInBatch = taskIds.includes(dependsOnTaskId);
+      if (!dependencyInBatch) {
+        const depTask = await getTaskRowUnscoped(dependsOnTaskId);
+        const depState = (await listReleaseTaskStates([dependsOnTaskId])).get(dependsOnTaskId);
+        const satisfied =
+          Boolean(depTask && ['verified', 'archived'].includes(depTask.status)) ||
+          Boolean(
+            depState &&
+              ['in_main', 'deployment_pending', 'deployed'].includes(depState.releaseState)
+          );
+        if (!satisfied) {
+          reasons.push(
+            `Dependency ${dependsOnTaskId} is not in main yet and is not part of this batch.`
+          );
+        }
+      }
+    }
+
+    const conflicted = mergeable === false;
+    items.push(
+      blockedItem(
+        {
+          ...base,
+          prNumber,
+          prUrl,
+          mergeable,
+          ancestry: ancestry?.status || null,
+          checks: checks
+            ? { status: checks.status, detail: checks.detail, checks: checks.checks }
+            : null,
+          warnings,
+          dependencySatisfied: !reasons.some((reason) => reason.startsWith('Dependency')),
+        },
+        reasons,
+        conflicted ? 'conflict' : reasons.length > 0 ? 'blocked' : 'ready'
+      )
+    );
+  }
+
+  // Surface overlapping files as a warning. The sequential merge still performs
+  // the authoritative conflict check right before each merge.
+  for (const item of items) {
+    if (item.status !== 'ready') continue;
+    for (const other of items) {
+      if (other === item || other.status !== 'ready') continue;
+      const overlap = item.changedFiles.filter((file) => other.changedFiles.includes(file));
+      if (overlap.length > 0) {
+        item.warnings.push(
+          `Shares ${overlap.length} changed file(s) with ${other.title}; the batch is merged sequentially.`
+        );
+      }
+    }
+  }
+
+  const ordered = orderReleaseItems(items);
+  return {
+    ok: items.every((item) => item.status === 'ready') && !ordered.cycle,
+    baseRef: MAIN_BRANCH,
+    baseSha,
+    items: ordered.cycle
+      ? items.map((item) => ({
+          ...item,
+          status: 'blocked' as const,
+          reasons: [...item.reasons, 'The selected tasks contain a dependency cycle.'],
+        }))
+      : ordered.ordered,
+    blocked: items.filter((item) => item.status === 'blocked').length,
+    conflicts: items.filter((item) => item.status === 'conflict').length,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Owner action: Push ready commits
+// ---------------------------------------------------------------------------
+
+type PromoteResult =
+  | {
+      ok: true;
+      status: 'in_main' | 'pushed';
+      mergeSha: string;
+      mainSha: string | null;
+      detail: string;
+      prNumber: number | null;
+      prUrl: string | null;
+    }
+  | {
+      ok: false;
+      status: 'conflict' | 'failed' | 'blocked';
+      code: string;
+      detail: string;
+      prNumber: number | null;
+      prUrl: string | null;
+    };
+
+async function confirmOnMain(input: {
+  repository: string;
+  mergeSha: string | null;
+}): Promise<{ confirmed: boolean; mainSha: string | null; comparison: string | null }> {
+  if (!input.mergeSha) return { confirmed: false, mainSha: null, comparison: null };
+  const mainSha = await getBranchHead(input.repository, MAIN_BRANCH).catch(() => null);
+  if (!mainSha) return { confirmed: false, mainSha: null, comparison: null };
+  if (mainSha.toLowerCase() === input.mergeSha.toLowerCase()) {
+    return { confirmed: true, mainSha, comparison: 'identical' };
+  }
+  const comparison = await compareCommits(input.repository, input.mergeSha, mainSha).catch(
+    () => null
+  );
+  const confirmed = Boolean(
+    comparison && ['ahead', 'identical'].includes(comparison.status)
+  );
+  return { confirmed, mainSha, comparison: comparison?.status || null };
+}
+
+async function promoteItem(input: {
+  task: DevWorkbenchTask;
+  attempt: DevAttempt;
+  releaseId: string;
+}): Promise<PromoteResult> {
+  const { task, attempt } = input;
+  const commitSha = attempt.headSha || '';
+  if (!isFullSha(commitSha)) {
+    return {
+      ok: false,
+      status: 'failed',
+      code: 'RELEASE_COMMIT_MISSING',
+      detail: 'The attempt has no full commit SHA.',
+      prNumber: attempt.prNumber,
+      prUrl: attempt.prUrl,
+    };
+  }
+
+  let prNumber = attempt.prNumber;
+  let prUrl = attempt.prUrl;
+  if (!prNumber) {
+    try {
+      const pr = await createPullRequestForAttempt({
+        repository: task.repository,
+        head: attempt.branch || '',
+        base: task.baseRef || MAIN_BRANCH,
+        title: `[Pierrot] ${task.title}`.slice(0, 240),
+        body: [
+          `Task: ${task.id}`,
+          `Attempt: ${attempt.attemptNumber} (${attempt.id})`,
+          `Commit: ${commitSha}`,
+          '',
+          'Promoted by the owner through the consolidated Push ready commits action.',
+          'This pull request is merged as part of that explicit release batch, not per-task.',
+        ].join('\n'),
+      });
+      prNumber = pr.number;
+      prUrl = pr.url;
+      await patchAttempt(attempt.id, { pr_number: pr.number, pr_url: pr.url });
+      await patchTask(task.id, {
+        pull_requests: [...new Set([...task.pullRequests, pr.url])].slice(-10),
+      }).catch(() => null);
+    } catch (error) {
+      return {
+        ok: false,
+        status: 'blocked',
+        code: 'RELEASE_PR_CREATE_FAILED',
+        detail: error instanceof Error ? error.message : 'Pull request creation failed.',
+        prNumber,
+        prUrl,
+      };
+    }
+  }
+
+  const pr = await getPullRequestStatus(task.repository, prNumber).catch(() => null);
+  if (!pr) {
+    return {
+      ok: false,
+      status: 'blocked',
+      code: 'RELEASE_PR_UNAVAILABLE',
+      detail: `GitHub did not return PR #${prNumber}.`,
+      prNumber,
+      prUrl,
+    };
+  }
+  prUrl = pr.url;
+  if (pr.headSha.toLowerCase() !== commitSha.toLowerCase()) {
+    return {
+      ok: false,
+      status: 'conflict',
+      code: 'RELEASE_PR_STALE',
+      detail: 'The pull request head changed after preflight. Nothing was merged.',
+      prNumber,
+      prUrl,
+    };
+  }
+
+  if (!pr.merged) {
+    const checks = await getCommitChecks(task.repository, commitSha).catch(() => null);
+    if (!checks || checks.status === 'unknown') {
+      return {
+        ok: false,
+        status: 'blocked',
+        code: 'RELEASE_CI_UNKNOWN',
+        detail: 'CI status could not be confirmed immediately before the merge.',
+        prNumber,
+        prUrl,
+      };
+    }
+    if (checks.status === 'failed') {
+      return {
+        ok: false,
+        status: 'failed',
+        code: 'RELEASE_CI_FAILED',
+        detail: checks.detail,
+        prNumber,
+        prUrl,
+      };
+    }
+    if (checks.status === 'pending') {
+      return {
+        ok: false,
+        status: 'blocked',
+        code: 'RELEASE_CI_PENDING',
+        detail: checks.detail,
+        prNumber,
+        prUrl,
+      };
+    }
+    if (pr.mergeable !== true || pr.state !== 'open') {
+      return {
+        ok: false,
+        status: 'conflict',
+        code: 'RELEASE_PR_CONFLICT',
+        detail: `PR #${prNumber} is not mergeable (${pr.mergeableState || pr.state}).`,
+        prNumber,
+        prUrl,
+      };
+    }
+    try {
+      const merged = await mergeVerifiedPullRequest({
+        repository: task.repository,
+        number: prNumber,
+        expectedHeadSha: commitSha,
+      });
+      if (!merged.merged) {
+        return {
+          ok: false,
+          status: 'failed',
+          code: 'RELEASE_MERGE_REJECTED',
+          detail: merged.message || 'GitHub rejected the merge.',
+          prNumber,
+          prUrl,
+        };
+      }
+      const confirmation = await confirmOnMain({
+        repository: task.repository,
+        mergeSha: merged.sha || commitSha,
+      });
+      return {
+        ok: true,
+        status: confirmation.confirmed ? 'in_main' : 'pushed',
+        mergeSha: merged.sha || commitSha,
+        mainSha: confirmation.confirmed ? confirmation.mainSha : null,
+        detail: confirmation.confirmed
+          ? `Merged PR #${prNumber}; main ${confirmation.mainSha?.slice(0, 7)} confirmed by GitHub.`
+          : `Merged PR #${prNumber}, but GitHub has not confirmed the resulting main revision yet.`,
+        prNumber,
+        prUrl,
+      };
+    } catch (error) {
+      const message = error instanceof Error ? error.message : 'The merge request failed.';
+      const conflict = /conflict|not mergeable|405|409/i.test(message);
+      return {
+        ok: false,
+        status: conflict ? 'conflict' : 'failed',
+        code: conflict ? 'RELEASE_MERGE_CONFLICT' : 'RELEASE_MERGE_FAILED',
+        detail: message,
+        prNumber,
+        prUrl,
+      };
+    }
+  }
+
+  const confirmation = await confirmOnMain({
+    repository: task.repository,
+    mergeSha: pr.mergeCommitSha || commitSha,
+  });
+  return {
+    ok: true,
+    status: confirmation.confirmed ? 'in_main' : 'pushed',
+    mergeSha: pr.mergeCommitSha || commitSha,
+    mainSha: confirmation.confirmed ? confirmation.mainSha : null,
+    detail: confirmation.confirmed
+      ? `PR #${prNumber} was already merged; main confirmed by GitHub.`
+      : `PR #${prNumber} was already merged; main confirmation is pending.`,
+    prNumber,
+    prUrl,
+  };
+}
+
+export type PushReadyResult = {
+  release: DevReleaseReport;
+  reused: boolean;
+};
+
+export async function pushReadyCommits(input: {
+  userId: string;
+  taskIds: string[];
+  confirm: boolean;
+  requestKey?: string | null;
+}): Promise<PushReadyResult> {
+  if (input.confirm !== true) {
+    throw new ReleaseError(
+      'RELEASE_CONFIRMATION_REQUIRED',
+      'Push ready commits requires an explicit owner confirmation.',
+      409
+    );
+  }
+  if (!(await isReleaseSchemaReady())) {
+    throw new ReleaseError(
+      'RELEASE_MIGRATION_REQUIRED',
+      `The release pipeline requires the additive migration ${RELEASE_MIGRATION_FILE}.`,
+      503
+    );
+  }
+
+  await failStalePushingReleases().catch(() => 0);
+  const preflight = await preflightRelease({ userId: input.userId, taskIds: input.taskIds });
+  const requestKey =
+    text(input.requestKey, 400) || buildReleaseRequestKey(preflight.items);
+
+  const existing = await getReleaseByRequestKey(requestKey);
+  if (existing) {
+    return { release: existing, reused: true };
+  }
+
+  const active = await getActiveReleaseRow();
+  if (active) {
+    throw new ReleaseError(
+      'RELEASE_IN_PROGRESS',
+      `Release ${active.id.slice(0, 8)} is still pushing. Wait for it to settle before starting another batch.`,
+      409
+    );
+  }
+
+  const created = await insertRelease({
+    user_id: isUuid(input.userId) ? input.userId : null,
+    request_key: requestKey,
+    status: 'preflight',
+    base_ref: preflight.baseRef,
+    base_sha: preflight.baseSha,
+    item_count: preflight.items.length,
+    preflight,
+  });
+  if (!created) {
+    const raced = await getReleaseByRequestKey(requestKey);
+    if (raced) return { release: raced, reused: true };
+    throw new ReleaseError('RELEASE_CREATE_FAILED', 'Unable to create the release.', 500);
+  }
+
+  const ordered = orderReleaseItems(preflight.items);
+  const itemRows = ordered.ordered.map((item, position) => ({
+    release_id: created.id,
+    task_id: item.taskId,
+    attempt_id: item.attemptId,
+    attempt_number: item.attemptNumber,
+    commit_sha: item.commitSha,
+    branch: item.branch,
+    pr_number: item.prNumber,
+    pr_url: item.prUrl,
+    position,
+    depends_on_task_id: item.dependsOnTaskId,
+    status: item.status === 'ready' ? 'ready' : item.status === 'conflict' ? 'conflict' : 'blocked',
+    checks: item.checks || {},
+    changed_files: item.changedFiles,
+    error_code: item.status === 'ready' ? null : `PREFLIGHT_${item.status.toUpperCase()}`,
+    error_message: item.reasons.join(' ') || null,
+  }));
+  if (!(await insertReleaseItems(itemRows))) {
+    const failed = await updateRelease(
+      created.id,
+      {
+        status: 'failed',
+        error_code: 'RELEASE_ITEMS_CREATE_FAILED',
+        error_message: 'Unable to persist release items.',
+        completed_at: nowIso(),
+      },
+      ['preflight']
+    );
+    throw new ReleaseError(
+      'RELEASE_ITEMS_CREATE_FAILED',
+      failed?.errorMessage || 'Unable to persist release items.',
+      500
+    );
+  }
+
+  if (!preflight.ok) {
+    const reason =
+      ordered.cycle
+        ? 'The selected tasks contain a dependency cycle.'
+        : preflight.conflicts > 0
+          ? `${preflight.conflicts} conflict(s) and ${preflight.blocked} blocked item(s) must be resolved before pushing.`
+          : `${preflight.blocked} item(s) failed preflight. No commit was pushed.`;
+    const blocked = await updateRelease(
+      created.id,
+      {
+        status: 'blocked',
+        error_code: ordered.cycle
+          ? 'RELEASE_DEPENDENCY_CYCLE'
+          : preflight.conflicts > 0
+            ? 'RELEASE_PREFLIGHT_CONFLICT'
+            : 'RELEASE_PREFLIGHT_BLOCKED',
+        error_message: reason,
+        failed_count: preflight.blocked + preflight.conflicts,
+        completed_at: nowIso(),
+      },
+      ['preflight']
+    );
+    await appendEvent({
+      type: 'release.blocked',
+      level: 'warn',
+      message: reason,
+      payload: {
+        releaseId: created.id,
+        items: preflight.items.map((item) => ({
+          taskId: item.taskId,
+          status: item.status,
+          reasons: item.reasons,
+        })),
+      },
+      dedupeKey: `release-blocked:${created.id}`,
+    }).catch(() => {});
+    await notifyDevOwner({
+      eventKey: `release-blocked:${created.id}`,
+      title: 'Pierrot Dev · release blocked',
+      lines: [reason, 'No commit was pushed. Resolve the reported items and try again.'],
+    }).catch(() => {});
+    return { release: blocked || (await getReleaseRow(created.id)) || created, reused: false };
+  }
+
+  const pushing = await updateRelease(
+    created.id,
+    { status: 'pushing', error_code: null, error_message: null },
+    ['preflight']
+  );
+  if (!pushing) {
+    const reason = 'Another release started pushing first. This batch was not processed.';
+    const blocked = await updateRelease(
+      created.id,
+      { status: 'blocked', error_code: 'RELEASE_IN_PROGRESS', error_message: reason, completed_at: nowIso() },
+      ['preflight']
+    );
+    throw Object.assign(new ReleaseError('RELEASE_IN_PROGRESS', reason, 409), {
+      release: blocked,
+    });
+  }
+
+  for (const item of pushing.items) {
+    await patchTaskRelease(item.taskId, {
+      release_state: 'pushing',
+      release_detail: `Release ${created.id.slice(0, 8)} is pushing this commit.`,
+      release_id: created.id,
+    });
+  }
+
+  await appendEvent({
+    type: 'release.started',
+    message: `Owner started Push ready commits with ${pushing.items.length} commit(s).`,
+    payload: {
+      releaseId: created.id,
+      taskIds: pushing.items.map((item) => item.taskId),
+      baseSha: preflight.baseSha,
+    },
+    dedupeKey: `release-started:${created.id}`,
+  }).catch(() => {});
+
+  let pushed = 0;
+  let failed = 0;
+  let failureMessage: string | null = null;
+  let failureCode: string | null = null;
+
+  for (let index = 0; index < pushing.items.length; index += 1) {
+    const item = pushing.items[index];
+    const task = await getTaskRow(input.userId, item.taskId);
+    const attempt = item.attemptId ? await getAttempt(item.attemptId) : null;
+    if (!task || !attempt) {
+      await updateReleaseItem(item.id, {
+        status: 'failed',
+        error_code: 'RELEASE_TASK_UNAVAILABLE',
+        error_message: 'The task or attempt disappeared during the release.',
+      });
+      failed += 1;
+      failureCode = 'RELEASE_TASK_UNAVAILABLE';
+      failureMessage = `Task ${item.taskId} disappeared during the release.`;
+      break;
+    }
+
+    await updateReleaseItem(item.id, { status: 'pushing' });
+    const result = await promoteItem({ task, attempt, releaseId: created.id });
+
+    if (result.ok) {
+      pushed += 1;
+      const state: DevReleaseState = result.status === 'in_main' ? 'in_main' : 'committed';
+      const taskState = (await listReleaseTaskStates([task.id])).get(task.id);
+      await updateReleaseItem(item.id, {
+        status: result.status,
+        merge_sha: result.mergeSha,
+        main_sha: result.mainSha,
+        pr_number: result.prNumber,
+        pr_url: result.prUrl,
+        error_code: null,
+        error_message: null,
+        promoted_at: nowIso(),
+        verified_at: result.status === 'in_main' ? nowIso() : null,
+      });
+      await patchTaskRelease(task.id, {
+        release_state: state,
+        release_detail: result.detail,
+        release_id: created.id,
+        committed_at: taskState?.committedAt || nowIso(),
+        validation_state:
+          state === 'in_main'
+            ? 'passed'
+            : taskState?.validationState === 'passed'
+              ? 'passed'
+              : 'unverified',
+        main_sha: result.mainSha,
+        deployment_state: result.mainSha ? 'PENDING' : null,
+        deployed_at: null,
+      });
+      await appendEvent({
+        type: result.status === 'in_main' ? 'release.item_in_main' : 'release.item_pushed',
+        message: result.detail,
+        payload: {
+          releaseId: created.id,
+          taskId: task.id,
+          commitSha: item.commitSha,
+          mergeSha: result.mergeSha,
+          mainSha: result.mainSha,
+        },
+        dedupeKey: `release-item:${created.id}:${item.commitSha}:${result.mergeSha}`,
+      }).catch(() => {});
+      continue;
+    }
+
+    failed += 1;
+    failureCode = result.code;
+    failureMessage = `${task.title}: ${result.detail}`;
+    await updateReleaseItem(item.id, {
+      status: result.status,
+      error_code: result.code,
+      error_message: result.detail,
+      pr_number: result.prNumber,
+      pr_url: result.prUrl,
+    });
+    await patchTaskRelease(task.id, {
+      release_state: 'blocked',
+      release_detail: `Release blocked: ${result.detail}`,
+      release_id: created.id,
+    });
+    for (const rest of pushing.items.slice(index + 1)) {
+      await updateReleaseItem(rest.id, {
+        status: 'blocked',
+        error_code: 'RELEASE_BATCH_STOPPED',
+        error_message: `Not pushed: the batch stopped after ${task.title} failed.`,
+      });
+    }
+    await appendEvent({
+      type: 'release.item_failed',
+      level: result.status === 'conflict' ? 'warn' : 'error',
+      message: failureMessage,
+      payload: {
+        releaseId: created.id,
+        taskId: task.id,
+        commitSha: item.commitSha,
+        code: result.code,
+      },
+      dedupeKey: `release-item-failed:${created.id}:${item.commitSha}`,
+    }).catch(() => {});
+    break;
+  }
+
+  const finalMain = await getBranchHead('newlove', MAIN_BRANCH).catch(() => null);
+  const status =
+    failed === 0
+      ? 'completed'
+      : pushed > 0
+        ? 'partial'
+        : failureCode === 'RELEASE_PR_CONFLICT'
+          ? 'blocked'
+          : 'failed';
+  const final = await updateRelease(
+    created.id,
+    {
+      status,
+      main_sha: finalMain,
+      pushed_count: pushed,
+      failed_count: failed,
+      error_code: failureCode,
+      error_message:
+        failed === 0
+          ? null
+          : `${failureMessage || 'The release did not complete.'}${
+              pushed > 0
+                ? ` ${pushed} commit(s) were already promoted and remain in main.`
+                : ' No commit was promoted.'
+            }`,
+      completed_at: nowIso(),
+    },
+    ['pushing']
+  );
+
+  await appendEvent({
+    type:
+      status === 'completed'
+        ? 'release.completed'
+        : status === 'partial'
+          ? 'release.partial'
+          : 'release.failed',
+    level: status === 'completed' ? 'info' : 'error',
+    message:
+      status === 'completed'
+        ? `Release completed: ${pushed} commit(s) are in main.`
+        : `Release ${status}: ${pushed} promoted, ${failed} failed. ${failureMessage || ''}`.trim(),
+    payload: { releaseId: created.id, pushed, failed, mainSha: finalMain },
+    dedupeKey: `release-final:${created.id}`,
+  }).catch(() => {});
+
+  await notifyDevOwner({
+    eventKey: `release-final:${created.id}`,
+    title:
+      status === 'completed'
+        ? 'Pierrot Dev · release pushed to main'
+        : `Pierrot Dev · release ${status}`,
+    lines: [
+      `${pushed} commit(s) promoted, ${failed} failed.`,
+      failureMessage || 'Every selected commit reached main.',
+      finalMain ? `main: ${finalMain.slice(0, 7)}` : 'main revision unconfirmed.',
+    ],
+  }).catch(() => {});
+
+  return {
+    release: final || (await getReleaseRow(created.id)) || pushing,
+    reused: false,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Recovery: confirm pushed commits and production deployments
+// ---------------------------------------------------------------------------
+
+/**
+ * Confirm items whose merge was accepted but not yet proven to be in main.
+ * Idempotent and read-only; never merges.
+ */
+export async function refreshReleaseConfirmations(limit = 5): Promise<number> {
+  if (!(await isReleaseSchemaReady())) return 0;
+  const items = await listPushedReleaseItems(limit);
+  let confirmed = 0;
+  for (const item of items) {
+    const task = await getTaskRowUnscoped(item.taskId);
+    if (!task) continue;
+    const confirmation = await confirmOnMain({
+      repository: task.repository,
+      mergeSha: item.mergeSha || item.commitSha,
+    });
+    if (!confirmation.confirmed || !confirmation.mainSha) continue;
+    await updateReleaseItem(item.id, {
+      status: 'in_main',
+      main_sha: confirmation.mainSha,
+      verified_at: nowIso(),
+    });
+    await patchTaskRelease(task.id, {
+      release_state: 'in_main',
+      release_detail: `Main ${confirmation.mainSha.slice(0, 7)} confirmed by GitHub.`,
+      main_sha: confirmation.mainSha,
+      deployment_state: 'PENDING',
+    });
+    await appendEvent({
+      type: 'release.item_in_main',
+      message: `Commit ${item.commitSha.slice(0, 7)} confirmed in main at ${confirmation.mainSha.slice(0, 7)}.`,
+      payload: { taskId: task.id, commitSha: item.commitSha, mainSha: confirmation.mainSha },
+      dedupeKey: `release-confirmed:${item.id}:${confirmation.mainSha}`,
+    }).catch(() => {});
+    confirmed += 1;
+  }
+  return confirmed;
+}
+
+/**
+ * Verify Vercel production deployments for tasks that are already in main.
+ * A task becomes Deployed only when Vercel reports READY for a production
+ * deployment whose commit SHA matches the confirmed main revision.
+ */
+export async function refreshReleaseDeployments(
+  limitOrOptions: number | { limit?: number; force?: boolean } = 3
+): Promise<number> {
+  const limit =
+    typeof limitOrOptions === 'number'
+      ? Math.min(Math.max(Math.trunc(limitOrOptions), 1), 20)
+      : Math.min(Math.max(Math.trunc(limitOrOptions?.limit ?? 3), 1), 20);
+  const force =
+    typeof limitOrOptions === 'object' && limitOrOptions?.force === true;
+  if (!force && Date.now() - lastDeploymentRefreshAt < DEPLOYMENT_REFRESH_WINDOW_MS) return 0;
+  lastDeploymentRefreshAt = Date.now();
+  if (!(await isReleaseSchemaReady())) return 0;
+
+  await refreshReleaseConfirmations(3).catch(() => 0);
+  const states = await listDeploymentTaskStates(limit);
+  let updated = 0;
+
+  for (const state of states) {
+    if (!state.mainSha) continue;
+    const task = await getTaskRowUnscoped(state.taskId);
+    if (!task) continue;
+    const deployment = await getVercelDeploymentStatus({
+      repository: task.repository,
+      commitSha: state.mainSha,
+    }).catch(() => null);
+    if (!deployment) continue;
+
+    let releaseState: DevReleaseState = 'deployment_pending';
+    let detail = deployment.reason || 'Waiting for a Vercel production deployment.';
+    if (deployment.state === 'ready') {
+      if (deployment.target === 'production') {
+        releaseState = 'deployed';
+        detail = `Vercel production deployment is READY${
+          deployment.url ? ` at ${deployment.url}` : ''
+        }.`;
+      } else {
+        releaseState = 'deployment_pending';
+        detail = `Vercel reports READY for target ${deployment.target || 'unknown'}, not production. Deployment is not confirmed.`;
+      }
+    } else if (deployment.state === 'error') {
+      releaseState = 'deployment_failed';
+      detail = 'Vercel reported a failed production deployment for the main revision.';
+    } else if (deployment.state === 'building' || deployment.state === 'queued') {
+      releaseState = 'deployment_pending';
+      detail = `Vercel deployment is ${deployment.state}.`;
+    } else {
+      releaseState = 'deployment_pending';
+      detail = deployment.reason || 'Vercel deployment status is not available yet.';
+    }
+
+    await patchTaskRelease(task.id, {
+      release_state: releaseState,
+      release_detail: detail,
+      deployment_state: releaseState === 'deployed' ? 'READY' : deployment.state.toUpperCase(),
+      deployment_url: deployment.url,
+      deployed_at: releaseState === 'deployed' ? nowIso() : null,
+    });
+    await updateLatestReleaseItemDeployment(task.id, {
+      deploymentState: releaseState === 'deployed' ? 'READY' : deployment.state.toUpperCase(),
+      deploymentUrl: deployment.url,
+    });
+    await appendEvent({
+      type:
+        releaseState === 'deployed'
+          ? 'deployment.ready'
+          : releaseState === 'deployment_failed'
+            ? 'deployment.failed'
+            : 'deployment.pending',
+      level: releaseState === 'deployment_failed' ? 'error' : 'info',
+      message: detail,
+      payload: {
+        taskId: task.id,
+        mainSha: state.mainSha,
+        state: deployment.state,
+        target: deployment.target,
+        url: deployment.url,
+      },
+      dedupeKey: `deployment:${releaseState}:${task.id}:${state.mainSha}`,
+    }).catch(() => {});
+    updated += 1;
+  }
+  return updated;
+}
+
+/**
+ * Import the state of unfinished legacy tasks (review/verified with a pull
+ * request) into the release ledger. This is explicitly owner-triggered and
+ * never merges, closes or edits a pull request.
+ */
+export async function reconcileReleaseState(input: {
+  userId: string;
+  limit?: number;
+}): Promise<{ reconciled: number; skipped: number; blocked: number }> {
+  if (!(await isReleaseSchemaReady())) {
+    throw new ReleaseError(
+      'RELEASE_MIGRATION_REQUIRED',
+      `The release pipeline requires the additive migration ${RELEASE_MIGRATION_FILE}.`,
+      503
+    );
+  }
+  const tasks = await listTaskRows({
+    userId: input.userId,
+    statuses: ['review', 'verified'],
+    limit: 200,
+  });
+  const withPrs = tasks.filter((task) => task.pullRequests.length > 0);
+  const states = await listReleaseTaskStates(withPrs.map((task) => task.id));
+  const pending = withPrs
+    .filter((task) => (states.get(task.id)?.releaseState || 'none') === 'none')
+    .slice(0, Math.min(Math.max(input.limit || 5, 1), 20));
+
+  let reconciled = 0;
+  let skipped = 0;
+  let blocked = 0;
+  for (const task of pending) {
+    const attempts = await listAttempts(task.id, 5);
+    const attempt =
+      attempts.find(
+        (item) => item.status === 'completed' && (item.headSha || item.prNumber || item.prUrl)
+      ) || null;
+    const prNumber =
+      attempt?.prNumber || parsePrNumber(attempt?.prUrl || task.pullRequests[0] || '');
+    if (!prNumber) {
+      skipped += 1;
+      continue;
+    }
+    const pr = await getPullRequestStatus(task.repository, prNumber).catch(() => null);
+    if (!pr) {
+      skipped += 1;
+      continue;
+    }
+    const checks = pr.merged
+      ? null
+      : await getCommitChecks(task.repository, pr.headSha).catch(() => null);
+    const commitSha = attempt?.headSha || pr.headSha;
+
+    let releaseState: DevReleaseState = 'committed';
+    let detail = 'Imported from the existing pull request.';
+    let validationState: DevValidationState = 'unverified';
+    let mainSha: string | null = null;
+
+    if (pr.merged) {
+      releaseState = 'in_main';
+      validationState = 'passed';
+      mainSha = pr.mergeCommitSha || pr.headSha;
+      detail = `Pull request #${prNumber} is already merged into main.`;
+    } else if (pr.state !== 'open') {
+      releaseState = 'blocked';
+      detail = `Pull request #${prNumber} is ${pr.state} and not merged.`;
+      blocked += 1;
+    } else if (pr.mergeable === false) {
+      releaseState = 'blocked';
+      detail = `Pull request #${prNumber} has a merge conflict (${pr.mergeableState || 'dirty'}).`;
+      blocked += 1;
+    } else if (checks?.status === 'failed') {
+      releaseState = 'validation_failed';
+      validationState = 'failed';
+      detail = `CI failed: ${checks.detail}`;
+      blocked += 1;
+    } else if (checks?.status === 'passed') {
+      releaseState = 'ready';
+      validationState = 'passed';
+      detail = 'Existing pull request is open, mergeable and its CI passed.';
+    } else if (checks?.status === 'none') {
+      releaseState = 'committed';
+      detail = 'Existing pull request has no CI checks attached. Local validation is required.';
+    } else {
+      releaseState = 'committed';
+      detail = `Existing pull request is waiting for CI (${checks?.status || 'unknown'}).`;
+    }
+
+    await patchTaskRelease(task.id, {
+      release_state: releaseState,
+      release_detail: detail,
+      validation_state: validationState,
+      committed_at: commitSha ? nowIso() : null,
+      main_sha: mainSha,
+      deployment_state: mainSha ? 'PENDING' : null,
+    });
+    await appendEvent({
+      type: 'release.reconciled',
+      message: `Reconciled ${task.title}: ${detail}`,
+      payload: {
+        taskId: task.id,
+        prNumber,
+        commitSha,
+        releaseState,
+        checks: checks?.status || null,
+      },
+      dedupeKey: `release-reconciled:${task.id}:${pr.state}:${checks?.status || 'none'}:${pr.mergeable}`,
+    }).catch(() => {});
+    reconciled += 1;
+  }
+  return { reconciled, skipped, blocked };
+}
+
+export function releaseMigrationFile(): string {
+  return RELEASE_MIGRATION_FILE;
+}
