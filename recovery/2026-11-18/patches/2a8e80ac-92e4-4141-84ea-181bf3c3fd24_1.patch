diff --git a/migrations/2026-12-11_pierrot_dev_release_pipeline.sql b/migrations/2026-12-11_pierrot_dev_release_pipeline.sql
new file mode 100644
index 00000000..195c2a23
--- /dev/null
+++ b/migrations/2026-12-11_pierrot_dev_release_pipeline.sql
@@ -0,0 +1,198 @@
+-- Pierrot Dev — commit-first lifecycle and consolidated release queue
+-- Date: 2026-12-11
+--
+-- ADDITIVE ONLY. Do NOT apply automatically to production.
+--
+-- The execution worker already creates a signed commit on its isolated branch
+-- before it reports a result. This migration adds the durable release ledger
+-- that records that commit, its validation evidence and its promotion path:
+--
+--   pierrot_dev_releases       — one row per owner "Push ready commits" action
+--   pierrot_dev_release_items  — per-task progress inside a release (resumable)
+--
+-- plus release-state columns on public.pierrot_dev_prompts. Existing rows get
+-- safe defaults ('none') and every new column is nullable or defaulted, so the
+-- current workbench keeps working before this file is applied.
+--
+-- Nothing in this migration merges, pushes, deploys or rewrites history.
+-- Existing open pull requests are never touched here.
+
+CREATE EXTENSION IF NOT EXISTS pgcrypto;
+
+-- ---------------------------------------------------------------------------
+-- One owner release action (batch)
+-- ---------------------------------------------------------------------------
+
+CREATE TABLE IF NOT EXISTS public.pierrot_dev_releases (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id UUID,
+  -- Stable client/server idempotency key. A duplicate request returns the
+  -- existing release instead of merging the same commits twice.
+  request_key TEXT NOT NULL UNIQUE,
+  status TEXT NOT NULL DEFAULT 'preflight'
+    CHECK (status IN ('preflight', 'pushing', 'completed', 'partial', 'blocked', 'failed')),
+  base_ref TEXT NOT NULL DEFAULT 'main',
+  base_sha TEXT,
+  main_sha TEXT,
+  item_count INTEGER NOT NULL DEFAULT 0 CHECK (item_count >= 0),
+  pushed_count INTEGER NOT NULL DEFAULT 0 CHECK (pushed_count >= 0),
+  failed_count INTEGER NOT NULL DEFAULT 0 CHECK (failed_count >= 0),
+  preflight JSONB NOT NULL DEFAULT '{}'::jsonb
+    CHECK (jsonb_typeof(preflight) = 'object' AND pg_column_size(preflight) <= 131072),
+  error_code TEXT,
+  error_message TEXT,
+  started_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  completed_at TIMESTAMPTZ
+);
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_releases_created_idx
+  ON public.pierrot_dev_releases (started_at, id);
+CREATE INDEX IF NOT EXISTS pierrot_dev_releases_status_idx
+  ON public.pierrot_dev_releases (status, updated_at DESC);
+
+-- At most one release may be pushing at a time. A crashed release is recovered
+-- explicitly (stale lease) before another batch can take the slot.
+CREATE UNIQUE INDEX IF NOT EXISTS pierrot_dev_releases_single_pushing_idx
+  ON public.pierrot_dev_releases ((1))
+  WHERE status = 'pushing';
+
+-- ---------------------------------------------------------------------------
+-- Per-task progress inside a release
+-- ---------------------------------------------------------------------------
+
+CREATE TABLE IF NOT EXISTS public.pierrot_dev_release_items (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  release_id UUID NOT NULL
+    REFERENCES public.pierrot_dev_releases(id) ON DELETE CASCADE,
+  task_id UUID NOT NULL
+    REFERENCES public.pierrot_dev_prompts(id) ON DELETE CASCADE,
+  attempt_id UUID
+    REFERENCES public.pierrot_dev_attempts(id) ON DELETE SET NULL,
+  attempt_number INTEGER,
+  commit_sha TEXT CHECK (commit_sha IS NULL OR commit_sha ~ '^[0-9a-f]{7,40}$'),
+  branch TEXT,
+  pr_number INTEGER,
+  pr_url TEXT,
+  position INTEGER NOT NULL DEFAULT 0,
+  depends_on_task_id UUID
+    REFERENCES public.pierrot_dev_prompts(id) ON DELETE SET NULL,
+  status TEXT NOT NULL DEFAULT 'ready'
+    CHECK (status IN (
+      'ready',
+      'pushing',
+      'pushed',
+      'in_main',
+      'conflict',
+      'failed',
+      'blocked'
+    )),
+  checks JSONB NOT NULL DEFAULT '{}'::jsonb
+    CHECK (jsonb_typeof(checks) = 'object' AND pg_column_size(checks) <= 65536),
+  changed_files TEXT[] NOT NULL DEFAULT '{}',
+  merge_sha TEXT,
+  main_sha TEXT,
+  deployment_state TEXT,
+  deployment_url TEXT,
+  error_code TEXT,
+  error_message TEXT,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  promoted_at TIMESTAMPTZ,
+  verified_at TIMESTAMPTZ,
+  UNIQUE (release_id, task_id)
+);
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_release_idx
+  ON public.pierrot_dev_release_items (release_id, position);
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_task_idx
+  ON public.pierrot_dev_release_items (task_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_commit_idx
+  ON public.pierrot_dev_release_items (commit_sha);
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_status_idx
+  ON public.pierrot_dev_release_items (status)
+  WHERE status IN ('pushed', 'in_main');
+
+-- ---------------------------------------------------------------------------
+-- Release state on the existing task table (safe defaults, backward compatible)
+-- ---------------------------------------------------------------------------
+
+ALTER TABLE public.pierrot_dev_prompts
+  ADD COLUMN IF NOT EXISTS release_state TEXT NOT NULL DEFAULT 'none',
+  ADD COLUMN IF NOT EXISTS release_detail TEXT,
+  ADD COLUMN IF NOT EXISTS validation_state TEXT NOT NULL DEFAULT 'none',
+  ADD COLUMN IF NOT EXISTS committed_at TIMESTAMPTZ,
+  ADD COLUMN IF NOT EXISTS main_sha TEXT,
+  ADD COLUMN IF NOT EXISTS deployed_at TIMESTAMPTZ,
+  ADD COLUMN IF NOT EXISTS deployment_state TEXT,
+  ADD COLUMN IF NOT EXISTS deployment_url TEXT,
+  ADD COLUMN IF NOT EXISTS release_id UUID
+    REFERENCES public.pierrot_dev_releases(id) ON DELETE SET NULL;
+
+DO $$
+BEGIN
+  ALTER TABLE public.pierrot_dev_prompts
+    ADD CONSTRAINT pierrot_dev_prompts_release_state_check
+    CHECK (release_state IN (
+      'none',
+      'no_changes',
+      'validation_failed',
+      'committed',
+      'ready',
+      'blocked',
+      'pushing',
+      'in_main',
+      'deployment_pending',
+      'deployed',
+      'deployment_failed'
+    ));
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+DO $$
+BEGIN
+  ALTER TABLE public.pierrot_dev_prompts
+    ADD CONSTRAINT pierrot_dev_prompts_validation_state_check
+    CHECK (validation_state IN ('none', 'passed', 'failed', 'unverified'));
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_prompts_release_state_idx
+  ON public.pierrot_dev_prompts (release_state, updated_at DESC)
+  WHERE release_state <> 'none';
+
+-- ---------------------------------------------------------------------------
+-- RLS and privileges: server-only, no SECURITY DEFINER
+-- ---------------------------------------------------------------------------
+
+ALTER TABLE public.pierrot_dev_releases ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.pierrot_dev_release_items ENABLE ROW LEVEL SECURITY;
+
+REVOKE ALL ON TABLE public.pierrot_dev_releases FROM PUBLIC, anon, authenticated;
+REVOKE ALL ON TABLE public.pierrot_dev_release_items FROM PUBLIC, anon, authenticated;
+
+GRANT ALL ON TABLE public.pierrot_dev_releases TO service_role;
+GRANT ALL ON TABLE public.pierrot_dev_release_items TO service_role;
+
+COMMENT ON TABLE public.pierrot_dev_releases IS
+  'Owner-only consolidated release batches. One explicit Push ready commits action per row.';
+COMMENT ON TABLE public.pierrot_dev_release_items IS
+  'Per-commit promotion progress. Persisted before and after every GitHub operation so a crashed batch can be resumed without duplicate merges.';
+COMMENT ON COLUMN public.pierrot_dev_prompts.release_state IS
+  'Release lifecycle: none, no_changes, validation_failed, committed, ready, blocked, pushing, in_main, deployment_pending, deployed, deployment_failed.';
+COMMENT ON COLUMN public.pierrot_dev_prompts.validation_state IS
+  'Validation evidence recorded when the attempt completed: none, passed, failed, unverified.';
+COMMENT ON COLUMN public.pierrot_dev_prompts.main_sha IS
+  'Main revision confirmed by GitHub after the commit was promoted.';
+COMMENT ON COLUMN public.pierrot_dev_prompts.deployment_state IS
+  'Vercel production deployment state for main_sha. Deployed requires READY and target=production.';
+
+-- Manual verification (not executed automatically):
+--   SELECT table_name, row_security FROM pg_class
+--    WHERE relname IN ('pierrot_dev_releases', 'pierrot_dev_release_items');
+--   SELECT column_name, data_type, column_default
+--    FROM information_schema.columns
+--   WHERE table_schema = 'public' AND table_name = 'pierrot_dev_prompts'
+--     AND column_name LIKE 'release%' OR column_name IN
+--       ('validation_state', 'committed_at', 'main_sha', 'deployed_at',
+--        'deployment_state', 'deployment_url');
