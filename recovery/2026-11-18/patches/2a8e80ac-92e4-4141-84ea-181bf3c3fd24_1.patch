+export async function updateLatestReleaseItemDeployment(
+  taskId: string,
+  patch: { deploymentState: string; deploymentUrl: string | null }
+): Promise<boolean> {
+  if (!isUuid(taskId) || !(await isReleaseSchemaReady())) return false;
+  try {
+    const { data, error } = await store()
+      .from('pierrot_dev_release_items')
+      .select('id')
+      .eq('task_id', taskId)
+      .order('created_at', { ascending: false })
+      .limit(1)
+      .maybeSingle();
+    if (error || !data?.id) return false;
+    const { error: updateError } = await store()
+      .from('pierrot_dev_release_items')
+      .update({
+        deployment_state: patch.deploymentState,
+        deployment_url: patch.deploymentUrl,
+        updated_at: new Date().toISOString(),
+      })
+      .eq('id', String(data.id));
+    return !updateError;
+  } catch {
+    return false;
+  }
+}
+
 export { truncateLog };
