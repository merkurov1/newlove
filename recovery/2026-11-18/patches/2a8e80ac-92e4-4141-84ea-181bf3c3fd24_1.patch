+export type CommitComparison = {
+  status: 'ahead' | 'behind' | 'diverged' | 'identical' | 'unknown';
+  aheadBy: number;
+  behindBy: number;
+  files: string[];
+};
+
+/**
+ * Compare two commits/refs. Used for preflight ancestry checks and for proving
+ * that a merge commit is actually contained in the current default branch.
+ * Returns null when GitHub cannot answer; callers must treat that as unknown,
+ * never as success.
+ */
+export async function compareCommits(
+  repository: DevRepositoryKey | string,
+  base: string,
+  head: string
+): Promise<CommitComparison | null> {
+  const config = getDevRepositoryConfig(repoKey(repository));
+  if (!/^[0-9a-f]{7,40}$/i.test(base) || !/^[0-9a-f]{7,40}$/i.test(head)) return null;
+  try {
+    const response = await client().rest.repos.compareCommits({
+      owner: config.owner,
+      repo: config.repo,
+      base,
+      head,
+    });
+    const status = String(response.data.status || 'unknown');
+    return {
+      status: (['ahead', 'behind', 'diverged', 'identical'].includes(status)
+        ? status
+        : 'unknown') as CommitComparison['status'],
+      aheadBy: Number(response.data.ahead_by || 0),
+      behindBy: Number(response.data.behind_by || 0),
+      files: (response.data.files || [])
+        .map((file) => (typeof file.filename === 'string' ? file.filename : ''))
+        .filter(Boolean)
+        .slice(0, 300),
+    };
+  } catch {
+    return null;
+  }
+}
+
+export type CommitInfo = {
+  sha: string;
+  message: string;
+  date: string | null;
+  url: string;
+};
+
+export async function getCommit(
+  repository: DevRepositoryKey | string,
+  sha: string
+): Promise<CommitInfo | null> {
+  const config = getDevRepositoryConfig(repoKey(repository));
+  if (!/^[0-9a-f]{7,40}$/i.test(sha)) return null;
+  try {
+    const response = await client().rest.repos.getCommit({
+      owner: config.owner,
+      repo: config.repo,
+      ref: sha,
+    });
+    return {
+      sha: response.data.sha,
+      message: String(response.data.commit.message || '').slice(0, 4000),
+      date: response.data.commit.author?.date || null,
+      url: response.data.html_url,
+    };
+  } catch {
+    return null;
+  }
+}
