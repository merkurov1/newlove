+  it('makes duplicate release requests idempotent', () => {
+    expect(migration).toContain('request_key TEXT NOT NULL UNIQUE');
+    expect(migration).toContain('UNIQUE (release_id, task_id)');
+    expect(migration).toContain('pierrot_dev_releases_single_pushing_idx');
+    expect(migration).toContain("WHERE status = 'pushing'");
+  });
