@@ -0,0 +1,56 @@
+/** @jest-environment node */
+
+import fs from 'node:fs';
+import path from 'node:path';
+
+import { isLongQuestion } from '../typography';
+
+const css = fs.readFileSync(
+  path.join(process.cwd(), 'components/question/question.module.css'),
+  'utf8'
+);
+
+function cssRule(selector: string): string {
+  const start = css.indexOf(`${selector} {`);
+  expect(start).toBeGreaterThan(-1);
+
+  const end = css.indexOf('}', start);
+  return css.slice(start, end + 1);
+}
+
+describe('Question typography', () => {
+  it('keeps the existing short seeded questions on the display scale', () => {
+    for (const shortQuestion of [
+      'В чём смысл жизни?',
+      'Что делает человека по-настоящему свободным?',
+      'Почему люди продолжают верить в то, что заведомо не соответствует действительности?',
+    ]) {
+      expect(isLongQuestion(shortQuestion)).toBe(false);
+    }
+  });
+
+  it('treats restored long questions and multi-paragraph text as long', () => {
+    expect(isLongQuestion('а'.repeat(180))).toBe(false);
+    expect(isLongQuestion('а'.repeat(181))).toBe(true);
+    expect(isLongQuestion('Первая строка\nВторая строка\nТретья строка\nЧетвёртая строка')).toBe(
+      true
+    );
+    expect(isLongQuestion('Первая строка\r\nВторая строка\r\nТретья строка')).toBe(false);
+  });
+
+  it('preserves source newlines instead of collapsing the question into one line', () => {
+    expect(cssRule('.question')).toContain('white-space: pre-line;');
+  });
+
+  it('defines a calmer long-question scale for desktop and mobile', () => {
+    const longRule = cssRule('.questionLong');
+    expect(longRule).toContain('font-size:');
+    expect(longRule).toContain('line-height:');
+    expect(longRule).toContain('max-width:');
+
+    const mobileStart = css.indexOf('@media (max-width: 640px)');
+    const mobileEnd = css.indexOf('\n}', mobileStart);
+    expect(mobileStart).toBeGreaterThan(-1);
+    expect(css.slice(mobileStart, mobileEnd)).toContain('.questionLong');
+  });
+});
diff --git a/lib/question/typography.ts b/lib/question/typography.ts
new file mode 100644
index 00000000..d7d70b82
--- /dev/null
+++ b/lib/question/typography.ts
@@ -0,0 +1,23 @@
+/** Presentation-only helpers for the verbatim question text. */
+
+/**
+ * Seeded questions are short single lines. Restored verbatim questions are
+ * allowed to be much longer and may contain their original paragraphs, so they
+ * need a calmer scale than the display headline used for short questions.
+ */
+export const QUESTION_LONG_TEXT_MIN_CHARS = 180;
+export const QUESTION_LONG_TEXT_MIN_LINES = 4;
+
+/**
+ * Returns true when the question cannot be shown comfortably as a display
+ * headline. The text is never trimmed, normalized or truncated here.
+ */
+export function isLongQuestion(text: string): boolean {
+  if (typeof text !== 'string' || text.length === 0) return false;
+
+  if (text.length > QUESTION_LONG_TEXT_MIN_CHARS) return true;
+
+  const visibleLines = text.split(/\r?\n/).filter((line) => line.trim().length > 0);
+
+  return visibleLines.length >= QUESTION_LONG_TEXT_MIN_LINES;
+}
diff --git a/migrations/2026-12-11_question_text_limit_2000.sql b/migrations/2026-12-11_question_text_limit_2000.sql
new file mode 100644
index 00000000..d2a35e18
--- /dev/null
+++ b/migrations/2026-12-11_question_text_limit_2000.sql
@@ -0,0 +1,45 @@
+-- ============================================================================
+-- Question — align the repository schema with the production text limit
+-- Date: 2026-12-11
+--
+-- Production already accepts verbatim restored questions up to 2000 characters.
+-- The original 2026-12-07 domain migration documented a stricter 3..500 limit,
+-- so a fresh environment would reject rows that production accepts.
+--
+-- This migration only replaces the question-length CHECK constraint. It does
+-- not read or modify rows, questions, answers or syntheses.
+--
+-- Idempotent: the DO block removes any previous question-length check (whatever
+-- PostgreSQL named it) before the stable constraint is added.
+-- ============================================================================
+
+begin;
+
+do $$
+declare
+  existing_constraint record;
+begin
+  for existing_constraint in
+    select conname
+    from pg_constraint
+    where conrelid = 'public.questions'::regclass
+      and contype = 'c'
+      and pg_get_constraintdef(oid) ilike '%char_length%'
+      and pg_get_constraintdef(oid) ilike '%question%'
+  loop
+    execute format(
+      'alter table public.questions drop constraint %I',
+      existing_constraint.conname
+    );
+  end loop;
+end;
+$$;
+
+alter table public.questions
+  add constraint questions_question_length_check
+  check (char_length(btrim(question)) between 3 and 2000) not valid;
+
+alter table public.questions
+  validate constraint questions_question_length_check;
+
+commit;
