+
+function isDeployedState(state: DevReleaseState | null | undefined): boolean {
+  return state === 'deployed';
+}
+
+function releaseItemToQueueState(state: DevReleaseItemState): DevReleaseState {
+  switch (state) {
+    case 'deployed':
+      return 'deployed';
+    case 'deployment_pending':
+      return 'deployment_pending';
+    case 'deployment_failed':
+      return 'deployment_failed';
+    case 'in_main':
+    case 'already_in_main':
+      return 'in_main';
+    case 'integrated':
+    case 'ready':
+      return 'pushing';
+    case 'conflict':
+    case 'blocked':
+    case 'failed':
+      return 'blocked';
+    default:
+      return 'commit_pending';
+  }
+}
+
+function extractChecks(
+  attempt: DevAttempt | null
+): Array<{ name: string; status: string | null; conclusion: string | null; url: string | null }> {
+  const raw = attempt?.verification?.commitVerification;
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return [];
+  const checks = (raw as { checks?: unknown }).checks;
+  if (!Array.isArray(checks)) return [];
+  return checks
+    .filter((item): item is Record<string, unknown> => Boolean(item) && typeof item === 'object')
+    .slice(0, 60)
+    .map((item) => ({
+      name: String(item.name || 'check').slice(0, 200),
+      status: typeof item.status === 'string' ? item.status : null,
+      conclusion: typeof item.conclusion === 'string' ? item.conclusion : null,
+      url: typeof item.url === 'string' ? item.url : null,
+    }));
+}
+
+function chosenAttempt(attempts: DevAttempt[]): DevAttempt | null {
+  return (
+    attempts.find((attempt) => attempt.status === 'completed' && Boolean(attempt.headSha)) ||
+    attempts.find((attempt) => Boolean(attempt.headSha)) ||
+    attempts.find((attempt) => attempt.status === 'completed') ||
+    null
+  );
+}
+
+function queueStateFor(
+  task: DevWorkbenchTask,
+  attempt: DevAttempt | null,
+  releaseItem: DevReleaseItem | null
+): DevReleaseState {
+  if (task.releaseState === 'deployed') return 'deployed';
+  if (task.releaseState === 'deployment_failed') return 'deployment_failed';
+  if (task.releaseState === 'in_main') return 'in_main';
+  if (releaseItem && ['deployed', 'in_main', 'already_in_main'].includes(releaseItem.state)) {
+    return releaseItemToQueueState(releaseItem.state);
+  }
+  if (task.releaseState) return task.releaseState;
+  if (attempt?.releaseState) return attempt.releaseState;
+  if (['draft', 'ready', 'queued', 'in_progress'].includes(task.status)) return 'in_progress';
+  if (task.status === 'rejected' || task.status === 'cancelled') return 'blocked';
+  if (attempt?.headSha) return 'commit_pending';
+  if (task.status === 'failed' && attempt && attempt.changedFiles.length === 0) return 'no_changes';
+  return 'in_progress';
+}
+
+function releaseRequestKey(taskIds: string[], items: DevReleaseQueueItem[]): string {
+  const payload = taskIds
+    .slice()
+    .sort()
+    .map((taskId) => {
+      const item = items.find((candidate) => candidate.taskId === taskId);
+      return `${taskId}:${item?.commitSha || 'none'}`;
+    })
+    .join('|');
+  return createHash('sha256').update(payload).digest('hex').slice(0, 64);
+}
+
+function taskById(tasks: DevWorkbenchTask[], taskId: string): DevWorkbenchTask | null {
+  return tasks.find((task) => task.id === taskId) || null;
+}
+
+async function patchAttemptRelease(
+  attemptId: string,
+  patch: Record<string, unknown>
+): Promise<void> {
+  await patchAttempt(attemptId, {
+    ...patch,
+    release_updated_at: nowIso(),
+  }).catch(() => null);
+}
+
+async function patchTaskRelease(taskId: string, patch: Record<string, unknown>): Promise<void> {
+  await patchTask(taskId, {
+    ...patch,
+    release_updated_at: nowIso(),
+  }).catch(() => null);
+}
+
+/**
+ * Verify one completed attempt and promote it to committed/ready.
+ *
+ * The worker already committed and pushed to its isolated branch. This check
+ * is what turns that self-reported SHA into a recorded GitHub-confirmed commit:
+ * the branch head must equal the SHA, and no executor-reported command may have
+ * failed. CI may still be pending; the promotion preflight confirms it later.
+ */
+async function verifyAttemptCommit(
+  task: DevWorkbenchTask,
+  attempt: DevAttempt
+): Promise<'ready' | 'failed' | 'pending'> {
+  const repository = repositoryOf(task);
+  const headSha = attempt.headSha;
+
+  if (!headSha || !/^[0-9a-f]{40}$/i.test(headSha)) {
+    await patchAttemptRelease(attempt.id, { release_state: 'validation_failed' });
+    await patchTaskRelease(task.id, {
+      release_state: 'validation_failed',
+      release_error: 'The worker did not report a full commit SHA. No commit was recorded.',
+    });
+    await appendEvent({
+      taskId: task.id,
+      attemptId: attempt.id,
+      type: 'commit.verification_failed',
+      level: 'error',
+      message: 'No commit SHA was reported; the task cannot become ready.',
+      dedupeKey: `commit-verification-failed:${attempt.id}:no-sha`,
+    }).catch(() => {});
+    return 'failed';
+  }
+
+  const expectedBranch = branchNameForAttempt(task.id, attempt.attemptNumber);
+  if (!attempt.branch || attempt.branch !== expectedBranch) {
+    const reason = `Attempt branch ${attempt.branch || '—'} does not match the isolated branch ${expectedBranch}.`;
+    await patchAttemptRelease(attempt.id, { release_state: 'validation_failed' });
+    await patchTaskRelease(task.id, { release_state: 'validation_failed', release_error: reason });
+    await appendEvent({
+      taskId: task.id,
+      attemptId: attempt.id,
+      type: 'commit.verification_failed',
+      level: 'error',
+      message: reason,
+      dedupeKey: `commit-verification-failed:${attempt.id}:branch`,
+    }).catch(() => {});
+    return 'failed';
+  }
+
+  let branchHead: string | null = null;
+  try {
+    branchHead = await getBranchHead(repository, attempt.branch);
+  } catch (error) {
+    const message =
+      error instanceof Error ? error.message.slice(0, 800) : 'GitHub did not return the branch.';
+    await patchTaskRelease(task.id, {
+      release_state: 'commit_pending',
+      release_commit: headSha.toLowerCase(),
+      release_branch: attempt.branch,
+      release_error: `Commit verification is waiting for GitHub: ${message}`,
+    });
+    return 'pending';
+  }
+
+  if (!branchHead) {
+    const reason = `Branch ${attempt.branch} was not found on GitHub. The commit was not recorded.`;
+    await patchAttemptRelease(attempt.id, { release_state: 'validation_failed' });
+    await patchTaskRelease(task.id, {
+      release_state: 'validation_failed',
+      release_commit: headSha.toLowerCase(),
+      release_branch: attempt.branch,
+      release_error: reason,
+    });
+    await appendEvent({
+      taskId: task.id,
+      attemptId: attempt.id,
+      type: 'commit.verification_failed',
+      level: 'error',
+      message: reason,
+      dedupeKey: `commit-verification-failed:${attempt.id}:missing-branch`,
+    }).catch(() => {});
+    return 'failed';
+  }
+
+  if (branchHead.toLowerCase() !== headSha.toLowerCase()) {
+    const reason = `Branch ${attempt.branch} points at ${branchHead.slice(
+      0,
+      7
+    )}, but the attempt reported ${headSha.slice(0, 7)}.`;
+    await patchAttemptRelease(attempt.id, { release_state: 'validation_failed' });
+    await patchTaskRelease(task.id, {
+      release_state: 'validation_failed',
+      release_commit: headSha.toLowerCase(),
+      release_branch: attempt.branch,
+      release_error: reason,
+    });
+    await appendEvent({
+      taskId: task.id,
+      attemptId: attempt.id,
+      type: 'commit.verification_failed',
+      level: 'error',
+      message: reason,
+      dedupeKey: `commit-verification-failed:${attempt.id}:head-mismatch`,
+    }).catch(() => {});
+    return 'failed';
+  }
+
+  const checks = await getCommitChecks(repository, branchHead);
+  const failedCommands = attempt.commands.filter((command) => command.status === 'failed');
+  const verifiedAt = nowIso();
+
+  if (failedCommands.length > 0) {
+    const reason = `Executor-reported checks failed: ${failedCommands
+      .map((command) => command.name)
+      .slice(0, 5)
+      .join(', ')}. The commit is preserved but the task is not ready.`;
+    await patchAttemptRelease(attempt.id, {
+      commit_verified_at: verifiedAt,
+      commit_verified_sha: branchHead.toLowerCase(),
+      release_state: 'validation_failed',
+      verification: {
+        ...(attempt.verification || {}),
+        commitVerification: {
+          verifiedAt,
+          branchHead,
+          checks: checks.checks,
+          status: 'validation_failed',
+          reason,
+        },
+      },
+    });
+    await patchTaskRelease(task.id, {
+      release_state: 'validation_failed',
+      release_commit: branchHead.toLowerCase(),
+      release_branch: attempt.branch,
+      release_error: reason,
+    });
+    await appendEvent({
+      taskId: task.id,
+      attemptId: attempt.id,
+      type: 'commit.verification_failed',
+      level: 'error',
+      message: reason,
+      payload: { commitSha: branchHead, branch: attempt.branch },
+      dedupeKey: `commit-verification-failed:${attempt.id}:commands`,
+    }).catch(() => {});
+    return 'failed';
+  }
+
+  await patchAttemptRelease(attempt.id, {
+    commit_verified_at: verifiedAt,
+    commit_verified_sha: branchHead.toLowerCase(),
+    release_state: 'committed',
+    verification: {
+      ...(attempt.verification || {}),
+      commitVerification: {
+        verifiedAt,
+        branchHead,
+        checks: checks.checks,
+        status: checks.status,
+        detail: checks.detail,
+      },
+    },
+  });
+  await patchTaskRelease(task.id, {
+    release_state: 'ready_to_push',
+    release_commit: branchHead.toLowerCase(),
+    release_branch: attempt.branch,
+    release_error: null,
+  });
+  await appendEvent({
+    taskId: task.id,
+    attemptId: attempt.id,
+    type: 'commit.verified',
+    message: `GitHub confirmed commit ${branchHead.slice(0, 7)} on ${attempt.branch}.`,
+    payload: {
+      commitSha: branchHead,
+      branch: attempt.branch,
+      checks: checks.status,
+      changedFiles: attempt.changedFiles.length,
+    },
+    dedupeKey: `commit-verified:${attempt.id}:${branchHead.toLowerCase()}`,
+  }).catch(() => {});
+  await appendEvent({
+    taskId: task.id,
+    attemptId: attempt.id,
+    type: 'release.ready',
+    message: `Task is Ready to Push as ${branchHead.slice(0, 7)}.`,
+    payload: { commitSha: branchHead, branch: attempt.branch },
+    dedupeKey: `release-ready:${attempt.id}:${branchHead.toLowerCase()}`,
+  }).catch(() => {});
+  return 'ready';
+}
+
+/**
+ * Bounded reconciliation. Called after a worker completion and from the Admin
+ * overview, so a transient GitHub outage is retried naturally without a
+ * background retry loop. Only tasks that still need verification are checked.
+ */
+export async function reconcileReleaseQueue(input: {
+  userId?: string;
+  trigger: string;
+  taskId?: string;
+  maxTasks?: number;
+}): Promise<void> {
+  if (!(await isReleaseSchemaReady())) return;
+  const maxTasks = Math.min(Math.max(input.maxTasks || 5, 1), 20);
+
+  let tasks: DevWorkbenchTask[] = [];
+  if (input.taskId) {
+    const rows = await listTaskRows({ userId: input.userId || '', limit: 200 });
+    tasks = rows.filter((task) => task.id === input.taskId);
+  } else {
+    tasks = await listTaskRows({ userId: input.userId || '', limit: 200 });
+  }
+
+  const candidates = tasks.filter(
+    (task) =>
+      !['draft', 'queued', 'in_progress', 'cancelled', 'rejected'].includes(task.status) &&
+      !isDeployedState(task.releaseState)
+  );
+  if (candidates.length === 0) return;
+
+  const attemptsByTask = await listAttemptsForTasks(
+    candidates.map((task) => task.id),
+    5
+  );
+
+  let checked = 0;
+  for (const task of candidates) {
+    if (checked >= maxTasks) break;
+    const attempts = attemptsByTask.get(task.id) || [];
+    const attempt = chosenAttempt(attempts);
+    if (!attempt) continue;
+
+    if (!attempt.headSha) {
+      if (task.releaseState === 'no_changes' || task.releaseState === 'validation_failed') continue;
+      const reason =
+        attempt.changedFiles.length > 0
+          ? 'The worker reported changed files but no commit SHA. No commit was recorded.'
+          : 'No changes were produced, so no commit was created. This task is not ready.';
+      await patchAttemptRelease(attempt.id, {
+        release_state: attempt.changedFiles.length > 0 ? 'validation_failed' : 'no_changes',
+      });
+      await patchTaskRelease(task.id, {
+        release_state: attempt.changedFiles.length > 0 ? 'validation_failed' : 'no_changes',
+        release_error: reason,
+      });
+      await appendEvent({
+        taskId: task.id,
+        attemptId: attempt.id,
+        type: 'commit.not_created',
+        level: 'warn',
+        message: reason,
+        dedupeKey: `commit-not-created:${attempt.id}`,
+      }).catch(() => {});
+      checked += 1;
+      continue;
+    }
+
+    if (
+      attempt.commitVerifiedSha &&
+      attempt.commitVerifiedSha.toLowerCase() === attempt.headSha.toLowerCase() &&
+      task.releaseState
+    ) {
+      continue;
+    }
+    if (task.releaseState === 'in_main' || isFinalReleaseState(task.releaseState)) continue;
+
+    checked += 1;
+    await verifyAttemptCommit(task, attempt);
+  }
+}
+
+function dependenciesForTasks(
+  batches: Awaited<ReturnType<typeof listBatches>>
+): Map<string, string | null> {
+  const map = new Map<string, string | null>();
+  for (const batch of batches) {
+    for (const item of batch.items) {
+      if (!map.has(item.taskId)) map.set(item.taskId, item.dependsOnTaskId);
+    }
+  }
+  return map;
+}
+
+async function enrichRelease(
+  release: DevReleaseRecord,
+  tasks: DevWorkbenchTask[]
+): Promise<DevReleaseRecord> {
+  const titles = new Map(tasks.map((task) => [task.id, task.title]));
+  const items = release.items || [];
+  const attemptsByTask = await listAttemptsForTasks(
+    items.map((item) => item.taskId),
+    5
+  );
+  return {
+    ...release,
+    items: items.map((item) => {
+      const attempt = (attemptsByTask.get(item.taskId) || []).find(
+        (candidate) => candidate.id === item.attemptId
+      );
+      return {
+        ...item,
+        taskTitle: item.taskTitle || titles.get(item.taskId) || item.taskId,
+        attemptNumber: item.attemptNumber ?? attempt?.attemptNumber ?? null,
+      };
+    }),
+  };
+}
+
+/** Build the Ready to Push queue and the latest promotion report. */
+export async function buildReleaseQueue(input: {
+  userId: string;
+}): Promise<DevReleaseQueue> {
+  const updatedAt = nowIso();
+  const schemaReady = await isReleaseSchemaReady();
+  if (!schemaReady) {
+    return {
+      schemaReady: false,
+      migrationFile: RELEASE_MIGRATION_FILE,
+      mainSha: null,
+      production: { state: null, url: null, checkedAt: null },
+      readyCount: 0,
+      blockedCount: 0,
+      inMainCount: 0,
+      deployedCount: 0,
+      items: [],
+      latest: null,
+      recent: [],
+      updatedAt,
+    };
+  }
+
+  const [tasks, batches, recent] = await Promise.all([
+    listTaskRows({ userId: input.userId, limit: 200 }),
+    listBatches(input.userId),
+    listReleaseRecords(6),
+  ]);
+  const attemptIds = tasks
+    .filter((task) => !['draft', 'queued', 'in_progress', 'cancelled'].includes(task.status))
+    .map((task) => task.id);
+  const attemptsByTask = await listAttemptsForTasks(attemptIds, 5);
+  const releaseItems = await listReleaseItemRecordsForTasks(tasks.map((task) => task.id));
+  const dependencies = dependenciesForTasks(batches);
+
+  const latestItemByTask = new Map<string, DevReleaseItem>();
+  for (const item of releaseItems) {
+    if (!latestItemByTask.has(item.taskId)) latestItemByTask.set(item.taskId, item);
+  }
+
+  const items: DevReleaseQueueItem[] = [];
+  for (const task of tasks) {
+    const attempts = attemptsByTask.get(task.id) || [];
+    const attempt = chosenAttempt(attempts);
+    const releaseItem = latestItemByTask.get(task.id) || null;
+    const state = queueStateFor(task, attempt, releaseItem);
+    if (state === 'in_progress' && !attempt?.headSha) {
+      continue;
+    }
+    if (['draft', 'cancelled'].includes(task.status) && !task.releaseState) continue;
+    const dependsOnTaskId = dependencies.get(task.id) || null;
+    const dependencyTask = dependsOnTaskId ? taskById(tasks, dependsOnTaskId) : null;
+    const dependencyState = dependencyTask
+      ? queueStateFor(
+          dependencyTask,
+          chosenAttempt(attemptsByTask.get(dependencyTask.id) || []),
+          latestItemByTask.get(dependencyTask.id) || null
+        )
+      : null;
+
+    const item: DevReleaseQueueItem = {
+      taskId: task.id,
+      taskTitle: task.title,
+      attemptId: attempt?.id || releaseItem?.attemptId || null,
+      attemptNumber: attempt?.attemptNumber || releaseItem?.attemptNumber || null,
+      commitSha: task.releaseCommit || attempt?.headSha || releaseItem?.commitSha || null,
+      branch: task.releaseBranch || attempt?.branch || releaseItem?.branch || null,
+      prUrl: attempt?.prUrl || task.pullRequests.slice(-1)[0] || null,
+      changedFiles: attempt?.changedFiles || [],
+      checks: extractChecks(attempt),
+      completedAt: attempt?.finishedAt || attempt?.createdAt || task.updatedAt,
+      state,
+      error: task.releaseError || releaseItem?.error || null,
+      dependsOnTaskId,
+      dependencyTitle: dependencyTask?.title || null,
+      dependencyState,
+      selectable: state === 'ready_to_push' && Boolean(task.releaseCommit || attempt?.headSha),
+      releaseId:
+        releaseItem && recent.some((release) => release.id === releaseItem.releaseId)
+          ? releaseItem.releaseId
+          : null,
+    };
+    items.push(item);
+  }
+
+  const recentWithItems = await Promise.all(
+    recent.map(async (release) => ({
+      ...release,
+      items: await listReleaseItemRecords(release.id),
+    }))
+  );
+  const latestRow = recentWithItems[0] || null;
+  const latest = latestRow ? await enrichRelease(latestRow, tasks) : null;
+
+  return {
+    schemaReady: true,
+    migrationFile: RELEASE_MIGRATION_FILE,
+    mainSha: latest?.mainShaAfter || latest?.mainShaBefore || null,
+    production: {
+      state: latest?.deploymentState || null,
+      url: latest?.deploymentUrl || null,
+      checkedAt: latest?.deploymentCheckedAt || null,
+    },
+    readyCount: items.filter((item) => item.state === 'ready_to_push').length,
+    blockedCount: items.filter((item) =>
+      ['blocked', 'validation_failed', 'deployment_failed'].includes(item.state)
+    ).length,
+    inMainCount: items.filter((item) => item.state === 'in_main').length,
+    deployedCount: items.filter((item) => item.state === 'deployed').length,
+    items,
+    latest,
+    recent: await Promise.all(
+      recentWithItems.map((release) => enrichRelease(release, tasks))
+    ),
+    updatedAt,
+  };
+}
+
+export async function startReleaseBatch(input: {
+  userId: string;
+  taskIds: string[];
+  requestKey?: string;
+  trigger: string;
+}): Promise<DevReleaseRecord> {
+  if (!(await isReleaseSchemaReady())) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_MIGRATION_REQUIRED',
+      `Ready to Push requires the additive migration ${RELEASE_MIGRATION_FILE}.`,
+      503
+    );
+  }
+  const taskIds = [...new Set(input.taskIds.filter(Boolean))].slice(0, MAX_RELEASE_ITEMS);
+  if (taskIds.length === 0) {
+    throw new DevReleaseError('DEV_RELEASE_EMPTY', 'Select at least one ready commit.', 400);
+  }
+
+  const tasks = await listTaskRows({ userId: input.userId, limit: 200 });
+  const selectedTasks = taskIds
+    .map((taskId) => tasks.find((task) => task.id === taskId))
+    .filter((task): task is DevWorkbenchTask => Boolean(task));
+  if (selectedTasks.length !== taskIds.length) {
+    throw new DevReleaseError('DEV_RELEASE_TASK_NOT_FOUND', 'A selected task disappeared.', 404);
+  }
+  const repoKeys = new Set(selectedTasks.map(repositoryOf));
+  if (repoKeys.size > 1) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_MIXED_REPOSITORIES',
+      'A promotion batch must target one repository.',
+      409
+    );
+  }
+  const repositoryKey = [...repoKeys][0] || 'newlove';
+
+  // Idempotency is checked before selectability: a network retry of the same
+  // owner click must return the existing promotion, not report that the now
+  // `pushing` tasks are no longer selectable.
+  const requestKey =
+    input.requestKey && input.requestKey.trim().length >= 8
+      ? input.requestKey.trim().slice(0, 200)
+      : releaseRequestKey(
+          taskIds,
+          selectedTasks.map(
+            (task) =>
+              ({
+                taskId: task.id,
+                commitSha: task.releaseCommit || task.resultCommit,
+              }) as DevReleaseQueueItem
+          )
+        );
+  const existing = await findActiveReleaseByRequestKey(input.userId, requestKey);
+  if (existing) return existing;
+
+  const queue = await buildReleaseQueue({ userId: input.userId });
+  const selected = taskIds.map((taskId) => ({
+    taskId,
+    item: queue.items.find((candidate) => candidate.taskId === taskId),
+  }));
+  const missing = selected.filter((entry) => !entry.item);
+  if (missing.length > 0) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_TASK_NOT_FOUND',
+      'One or more selected tasks are not visible in this workspace.',
+      404,
+      { taskIds: missing.map((entry) => entry.taskId) }
+    );
+  }
+  const notReady = selected.filter((entry) => !entry.item?.selectable);
+  if (notReady.length > 0) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_NOT_READY',
+      'Every selected commit must be committed, validated and Ready to Push.',
+      409,
+      {
+        reasons: notReady.map((entry) => ({
+          taskId: entry.taskId,
+          state: entry.item?.state,
+          error: entry.item?.error,
+        })),
+      }
+    );
+  }
+
+  const missingDependencies = selected.filter((entry) => {
+    const item = entry.item!;
+    if (!item.dependsOnTaskId) return false;
+    if (taskIds.includes(item.dependsOnTaskId)) return false;
+    const dependency = queue.items.find((candidate) => candidate.taskId === item.dependsOnTaskId);
+    return !dependency || !['in_main', 'deployed'].includes(dependency.state);
+  });
+  if (missingDependencies.length > 0) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_DEPENDENCY_MISSING',
+      'A dependency is not in main and is not part of this batch.',
+      409,
+      {
+        reasons: missingDependencies.map((entry) => ({
+          taskId: entry.taskId,
+          dependency: entry.item?.dependsOnTaskId,
+        })),
+      }
+    );
+  }
+
+  const mainSha = await getBranchHead(repositoryKey, MAIN_BRANCH);
+  if (!mainSha) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_MAIN_UNAVAILABLE',
+      'GitHub did not return the main branch revision. No release was created.',
+      502
+    );
+  }
+
+  const releaseId = randomUUID();
+  const integrationBranch = `pierrot/release/${releaseId}`;
+  try {
+    await createBranchRef({ repository: repositoryKey, branch: integrationBranch, sha: mainSha });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Unable to create the release branch.';
+    throw new DevReleaseError('DEV_RELEASE_BRANCH_FAILED', message, 502);
+  }
+
+  const release = await createReleaseRecord({
+    id: releaseId,
+    userId: input.userId,
+    requestKey,
+    baseBranch: MAIN_BRANCH,
+    integrationBranch,
+    mainShaBefore: mainSha,
+  });
+  if (!release) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_CREATE_FAILED',
+      'The promotion record could not be persisted.',
+      500
+    );
+  }
+
+  const rows = selected.map((entry) => {
+    const item = entry.item!;
+    const task = selectedTasks.find((candidate) => candidate.id === entry.taskId)!;
+    return {
+      releaseId,
+      taskId: entry.taskId,
+      attemptId: item.attemptId,
+      commitSha: item.commitSha || task.resultCommit || '',
+      baseCommit: null,
+      branch: item.branch || '',
+    };
+  });
+  const created = await createReleaseItemRecords(rows);
+  if (created.length !== rows.length) {
+    await updateReleaseRecord(releaseId, {
+      status: 'failed',
+      error: 'The promotion items could not all be persisted. No main change was attempted.',
+      completed_at: nowIso(),
+    });
+    throw new DevReleaseError(
+      'DEV_RELEASE_ITEMS_FAILED',
+      'The promotion items could not all be persisted.',
+      500
+    );
+  }
+
+  for (const taskId of taskIds) {
+    await patchTaskRelease(taskId, { release_state: 'pushing', release_error: null });
+  }
+  await appendEvent({
+    type: 'release.started',
+    message: `Owner requested Push ready commits for ${taskIds.length} commit(s).`,
+    payload: { releaseId, taskIds, requestKey, mainSha, integrationBranch, trigger: input.trigger },
+    dedupeKey: `release-started:${releaseId}`,
+  }).catch(() => {});
+
+  return (await getReleaseRecord(releaseId)) || release;
+}
+
+async function blockRelease(
+  release: DevReleaseRecord,
+  reason: string,
+  taskIds: string[] = []
+): Promise<DevReleaseRecord> {
+  const updated =
+    (await updateReleaseRecord(
+      release.id,
+      { status: 'blocked', error: reason },
+      ['pushing', 'in_main', 'deployment_pending', 'deployment_failed']
+    )) || { ...release, status: 'blocked' as const, error: reason };
+  for (const taskId of taskIds) {
+    await patchTaskRelease(taskId, { release_state: 'blocked', release_error: reason });
+  }
+  await appendEvent({
+    type: 'release.blocked',
+    level: 'error',
+    message: reason,
+    payload: { releaseId: release.id, taskIds },
+    dedupeKey: `release-blocked:${release.id}:${createHash('sha1').update(reason).digest('hex').slice(0, 10)}`,
+  }).catch(() => {});
+  return (await getReleaseRecord(release.id)) || updated;
+}
+
+async function preflightItem(input: {
+  release: DevReleaseRecord;
+  item: DevReleaseItem;
+  mainSha: string;
+  repository: string;
+  tasks: DevWorkbenchTask[];
+  queueItems: DevReleaseQueueItem[];
+  selectedTaskIds: Set<string>;
+}): Promise<{ ok: boolean; waiting: boolean; reason?: string }> {
+  const { item, release, repository, mainSha } = input;
+  const task = input.tasks.find((candidate) => candidate.id === item.taskId);
+  if (!task) return { ok: false, waiting: false, reason: 'Task disappeared from the workspace.' };
+  if (!item.commitSha || !/^[0-9a-f]{40}$/i.test(item.commitSha)) {
+    return { ok: false, waiting: false, reason: 'The recorded commit SHA is invalid.' };
+  }
+  if (item.commitSha.toLowerCase() !== (task.releaseCommit || '').toLowerCase()) {
+    return {
+      ok: false,
+      waiting: false,
+      reason: 'The recorded commit no longer matches the task release commit.',
+    };
+  }
+  if (!item.branch) return { ok: false, waiting: false, reason: 'The release branch is missing.' };
+
+  const branchHead = await getBranchHead(repository, item.branch);
+  if (!branchHead) {
+    return {
+      ok: false,
+      waiting: false,
+      reason: `Branch ${item.branch} is not available on GitHub.`,
+    };
+  }
+  if (branchHead.toLowerCase() !== item.commitSha.toLowerCase()) {
+    return {
+      ok: false,
+      waiting: false,
+      reason: `Branch ${item.branch} moved to ${branchHead.slice(
+        0,
+        7
+      )}; the recorded commit is ${item.commitSha.slice(0, 7)}.`,
+    };
+  }
+
+  const alreadyInMain = await isAncestor(repository, item.commitSha, mainSha);
+  if (alreadyInMain === null) {
+    return {
+      ok: false,
+      waiting: false,
+      reason: 'GitHub could not verify whether the commit is already in main.',
+    };
+  }
+  if (alreadyInMain) return { ok: true, waiting: false };
+
+  if (item.baseCommit) {
+    const ancestry = await isAncestor(repository, item.baseCommit, item.commitSha);
+    if (ancestry !== true) {
+      return {
+        ok: false,
+        waiting: false,
+        reason: `Invalid ancestry: commit ${item.commitSha.slice(
+          0,
+          7
+        )} does not descend from its recorded base ${item.baseCommit.slice(0, 7)}.`,
+      };
+    }
+  }
+
+  const checks = await getCommitChecks(repository, item.commitSha);
+  if (checks.status === 'failed') {
+    return { ok: false, waiting: false, reason: `Preflight CI failed: ${checks.detail}` };
+  }
+  if (checks.status === 'pending') {
+    return { ok: true, waiting: true, reason: checks.detail };
+  }
+  if (checks.status === 'unknown') {
+    return {
+      ok: false,
+      waiting: false,
+      reason: `Preflight could not confirm CI checks: ${checks.detail}`,
+    };
+  }
+
+  const dependency = input.queueItems.find(
+    (candidate) => candidate.taskId === task.id
+  )?.dependsOnTaskId;
+  if (dependency && !input.selectedTaskIds.has(dependency)) {
+    const dependencyTask = input.tasks.find((candidate) => candidate.id === dependency);
+    if (
+      !dependencyTask ||
+      (!['verified', 'archived'].includes(dependencyTask.status) &&
+        !['in_main', 'deployed'].includes(dependencyTask.releaseState || ''))
+    ) {
+      return {
+        ok: false,
+        waiting: false,
+        reason: 'A required dependency is not in main and is not part of this batch.',
+      };
+    }
+  }
+
+  void release;
+  return { ok: true, waiting: false };
+}
+
+async function advanceReleaseLocked(input: {
+  release: DevReleaseRecord;
+  trigger: string;
+  force: boolean;
+  maxSteps: number;
+}): Promise<DevReleaseRecord> {
+  let release = input.release;
+  if (['deployed', 'failed'].includes(release.status)) return release;
+  if (release.status === 'blocked' && !input.force) return release;
+  // A conflict or a commit that GitHub refused cannot be fixed by polling.
+  // Everything else (a transient CI/GitHub preflight block) may be retried.
+  if (release.status === 'blocked') {
+    if (release.items.some((item) => ['conflict', 'failed'].includes(item.state))) return release;
+    for (const item of release.items.filter((candidate) => candidate.state === 'blocked')) {
+      await updateReleaseItemRecord(item.id, { state: 'pending', error: null }, ['blocked']);
+    }
+    release = (await getReleaseRecord(release.id)) || release;
+  }
+
+  const tasks = await listTaskRows({ userId: '', limit: 200 });
+  const selectedTasks = tasks.filter((task) =>
+    release.items.some((item) => item.taskId === task.id)
+  );
+  const repository = selectedTasks[0] ? repositoryOf(selectedTasks[0]) : 'newlove';
+
+  if (release.items.length === 0) {
+    return blockRelease(release, 'The promotion has no items.');
+  }
+
+  const queue = await buildReleaseQueue({ userId: '' });
+  const selectedTaskIds = new Set(release.items.map((item) => item.taskId));
+
+  // ---- Preflight --------------------------------------------------------
+  if (release.items.some((item) => item.state === 'pending')) {
+    const mainSha = release.mainShaBefore || (await getBranchHead(repository, MAIN_BRANCH));
+    if (!mainSha) {
+      return blockRelease(release, 'GitHub did not return the main branch revision.');
+    }
+    for (const item of release.items.filter((candidate) => candidate.state === 'pending')) {
+      let result: { ok: boolean; waiting: boolean; reason?: string };
+      try {
+        result = await preflightItem({
+          release,
+          item,
+          mainSha,
+          repository,
+          tasks,
+          queueItems: queue.items,
+          selectedTaskIds,
+        });
+      } catch (error) {
+        const message =
+          error instanceof WorkbenchGitHubError
+            ? error.message
+            : error instanceof Error
+              ? error.message.slice(0, 800)
+              : 'Preflight failed.';
+        result = { ok: false, waiting: false, reason: `Preflight failed: ${message}` };
+      }
+      if (!result.ok) {
+        await updateReleaseItemRecord(item.id, {
+          state: 'blocked',
+          error: result.reason || 'Preflight blocked this commit.',
+        });
+        return blockRelease(
+          release,
+          `Preflight blocked ${item.taskTitle || item.taskId.slice(0, 8)}: ${
+            result.reason || 'unknown reason'
+          }`,
+          release.items.map((candidate) => candidate.taskId)
+        );
+      }
+      if (result.waiting) {
+        await updateReleaseRecord(release.id, {
+          ci_status: 'pending',
+          ci_detail: result.reason || 'CI is still running.',
+        });
+        return (await getReleaseRecord(release.id)) || release;
+      }
+      const already = await isAncestor(repository, item.commitSha, mainSha);
+      if (already === true) {
+        await updateReleaseItemRecord(item.id, {
+          state: 'already_in_main',
+          main_sha: mainSha,
+        });
+        await patchTaskRelease(item.taskId, {
+          release_state: 'in_main',
+          release_commit: item.commitSha,
+          release_branch: item.branch,
+          release_error: null,
+        });
+      } else {
+        await updateReleaseItemRecord(item.id, {
+          state: 'ready',
+          error: null,
+          main_sha: mainSha,
+        });
+      }
+    }
+    release = (await getReleaseRecord(release.id)) || release;
+  }
+
+  // ---- Integrate into the release branch --------------------------------
+  let steps = 0;
+  for (const item of release.items.filter((candidate) => candidate.state === 'ready')) {
+    if (steps >= input.maxSteps) break;
+    steps += 1;
+    try {
+      const merged = await mergeBranchIntoRelease({
+        repository,
+        base: release.integrationBranch,
+        head: item.branch,
+        commitMessage: `pierrot(release): include ${item.taskTitle || item.taskId} ${item.commitSha.slice(0, 7)}`,
+      });
+      await updateReleaseItemRecord(
+        item.id,
+        {
+          state: 'integrated',
+          github_merge_sha: merged.sha || item.commitSha,
+          error: null,
+        },
+        ['ready']
+      );
+    } catch (error) {
+      const conflict =
+        error instanceof WorkbenchGitHubError && error.code === 'GITHUB_RELEASE_CONFLICT';
+      const message =
+        error instanceof Error ? error.message.slice(0, 800) : 'GitHub merge failed.';
+      await updateReleaseItemRecord(item.id, {
+        state: conflict ? 'conflict' : 'blocked',
+        error: message,
+      });
+      return blockRelease(
+        release,
+        `${conflict ? 'Conflict' : 'Integration failed'} for ${
+          item.taskTitle || item.taskId.slice(0, 8)
+        }: ${message}. Main was not changed.`,
+        [item.taskId]
+      );
+    }
+  }
+  release = (await getReleaseRecord(release.id)) || release;
+
+  const remainingReady = release.items.filter((item) => item.state === 'ready');
+  if (remainingReady.length > 0) {
+    await updateReleaseRecord(release.id, {
+      ci_status: 'pending',
+      ci_detail: 'Release branch is being prepared.',
+    });
+    return (await getReleaseRecord(release.id)) || release;
+  }
+
+  const integrated = release.items.filter((item) => item.state === 'integrated');
+  const alreadyInMain = release.items.filter((item) => item.state === 'already_in_main');
+
+  if (integrated.length === 0 && alreadyInMain.length === release.items.length) {
+    const mainSha = (await getBranchHead(repository, MAIN_BRANCH)) || release.mainShaBefore;
+    await updateReleaseRecord(release.id, {
+      status: 'deployment_pending',
+      main_sha_after: mainSha,
+      ci_status: 'none',
+      ci_detail: 'All selected commits were already confirmed in main.',
+    });
+    release = (await getReleaseRecord(release.id)) || release;
+  } else {
+    // ---- Create one release pull request --------------------------------
+    if (!release.prNumber) {
+      try {
+        const pr = await createPullRequestForAttempt({
+          repository,
+          head: release.integrationBranch,
+          base: MAIN_BRANCH,
+          title: `[Pierrot] Push ${release.items.length} ready commit(s)`.slice(0, 240),
+          body: [
+            'Owner-triggered Ready to Push promotion.',
+            '',
+            ...release.items.map(
+              (item) => `- ${item.taskTitle || item.taskId}: ${item.commitSha.slice(0, 7)} (${item.branch})`
+            ),
+            '',
+            'This release pull request is merged only by the explicit Push ready commits action.',
+            'Individual task PRs are left untouched.',
+          ].join('\n'),
+        });
+        await updateReleaseRecord(release.id, {
+          pr_number: pr.number,
+          pr_url: pr.url,
+          ci_status: 'pending',
+          ci_detail: 'Release pull request created; waiting for checks.',
+        });
+        await appendEvent({
+          type: 'release.pull_request_created',
+          message: `Release PR #${pr.number} created for ${release.items.length} commit(s).`,
+          payload: { releaseId: release.id, prNumber: pr.number, url: pr.url },
+          dedupeKey: `release-pr-created:${release.id}`,
+        }).catch(() => {});
+        return (await getReleaseRecord(release.id)) || release;
+      } catch (error) {
+        const message =
+          error instanceof Error ? error.message.slice(0, 800) : 'Release PR creation failed.';
+        return blockRelease(
+          release,
+          `The release pull request could not be created: ${message}`,
+          release.items.map((item) => item.taskId)
+        );
+      }
+    }
+
+    // ---- Wait for checks, then merge the release PR ---------------------
+    const status = await getPullRequestStatus(repository, release.prNumber);
+    if (!status) {
+      await updateReleaseRecord(release.id, {
+        ci_status: 'unknown',
+        ci_detail: 'GitHub did not return the release pull request status.',
+      });
+      return (await getReleaseRecord(release.id)) || release;
+    }
+    if (status.merged) {
+      // A PR merged outside this process (or in an earlier attempt) still has
+      // to be anchored to the real main revision, not the PR head.
+      const mainHead = (await getBranchHead(repository, MAIN_BRANCH)) || null;
+      await updateReleaseRecord(release.id, {
+        status: 'in_main',
+        main_sha_after: mainHead || release.mainShaAfter,
+      });
+      release = (await getReleaseRecord(release.id)) || release;
+    } else if (status.state !== 'open') {
+      return blockRelease(
+        release,
+        `Release PR #${release.prNumber} is ${status.state}, not open. Main was not changed.`,
+        release.items.map((item) => item.taskId)
+      );
+    } else {
+      const checks = await getCommitChecks(repository, status.headSha);
+      if (checks.status === 'failed') {
+        await updateReleaseRecord(release.id, {
+          ci_status: 'failed',
+          ci_detail: checks.detail,
+        });
+        return blockRelease(
+          release,
+          `Release CI failed: ${checks.detail}. No merge was attempted.`,
+          release.items.map((item) => item.taskId)
+        );
+      }
+      if (checks.status === 'pending') {
+        await updateReleaseRecord(release.id, {
+          ci_status: 'pending',
+          ci_detail: checks.detail,
+        });
+        return (await getReleaseRecord(release.id)) || release;
+      }
+      if (checks.status === 'unknown') {
+        await updateReleaseRecord(release.id, {
+          ci_status: 'unknown',
+          ci_detail: checks.detail,
+        });
+        return blockRelease(
+          release,
+          `Release CI status could not be confirmed: ${checks.detail}`,
+          release.items.map((item) => item.taskId)
+        );
+      }
+      try {
+        const merged = await mergeVerifiedPullRequest({
+          repository,
+          number: release.prNumber,
+          expectedHeadSha: status.headSha,
+          mergeMethod: 'merge',
+        });
+        if (!merged.merged) {
+          return blockRelease(
+            release,
+            `GitHub did not merge the release PR: ${merged.message || 'unknown reason'}.`,
+            release.items.map((item) => item.taskId)
+          );
+        }
+        await updateReleaseRecord(release.id, {
+          status: 'in_main',
+          ci_status: checks.status,
+          ci_detail: checks.detail,
+          main_sha_after: merged.sha,
+        });
+        await appendEvent({
+          type: 'release.merged',
+          message: `Release PR #${release.prNumber} merged at ${merged.sha?.slice(0, 7) || 'unknown'}.`,
+          payload: { releaseId: release.id, prNumber: release.prNumber, sha: merged.sha },
+          dedupeKey: `release-merged:${release.id}`,
+        }).catch(() => {});
+        release = (await getReleaseRecord(release.id)) || release;
+      } catch (error) {
+        const message =
+          error instanceof Error ? error.message.slice(0, 800) : 'GitHub merge failed.';
+        return blockRelease(
+          release,
+          `The release PR could not be merged: ${message}. No force push or branch-protection bypass was attempted.`,
+          release.items.map((item) => item.taskId)
+        );
+      }
+    }
+  }
+
+  // ---- Confirm every commit is in main ---------------------------------
+  if (release.status === 'in_main') {
+    const mainSha =
+      release.mainShaAfter || (await getBranchHead(repository, MAIN_BRANCH)) || null;
+    if (!mainSha) {
+      return blockRelease(release, 'GitHub did not return the main revision after the merge.');
+    }
+    const mainChecks = await getCommitChecks(repository, mainSha);
+    if (mainChecks.status === 'failed') {
+      await updateReleaseRecord(release.id, {
+        status: 'failed',
+        main_sha_after: mainSha,
+        ci_status: 'failed',
+        ci_detail: mainChecks.detail,
+        error: `CI on main failed after the promotion: ${mainChecks.detail}`,
+      });
+      return (await getReleaseRecord(release.id)) || release;
+    }
+    if (mainChecks.status === 'pending') {
+      await updateReleaseRecord(release.id, {
+        status: 'in_main',
+        main_sha_after: mainSha,
+        ci_status: 'pending',
+        ci_detail: mainChecks.detail,
+      });
+      return (await getReleaseRecord(release.id)) || release;
+    }
+    const failed: DevReleaseItem[] = [];
+    for (const item of release.items) {
+      if (item.state === 'deployed' || item.state === 'deployment_pending') continue;
+      const included = await isAncestor(repository, item.commitSha, mainSha);
+      if (included !== true) {
+        failed.push(item);
+        await updateReleaseItemRecord(item.id, {
+          state: 'failed',
+          main_sha: mainSha,
+          error: `Commit ${item.commitSha.slice(0, 7)} is not an ancestor of main ${mainSha.slice(
+            0,
+            7
+          )}.`,
+        });
+        continue;
+      }
+      await updateReleaseItemRecord(item.id, {
+        state: 'in_main',
+        main_sha: mainSha,
+        error: null,
+      });
+      const task = selectedTasks.find((candidate) => candidate.id === item.taskId);
+      await patchTaskRelease(item.taskId, {
+        release_state: 'in_main',
+        release_commit: item.commitSha,
+        release_branch: item.branch,
+        release_error: null,
+        ...(task?.status === 'review' ? { status: 'verified' } : {}),
+      });
+    }
+    if (failed.length > 0) {
+      await updateReleaseRecord(release.id, {
+        status: 'failed',
+        main_sha_after: mainSha,
+        error: 'GitHub could not confirm every selected commit in main.',
+      });
+      return (await getReleaseRecord(release.id)) || release;
+    }
+    await updateReleaseRecord(release.id, {
+      status: 'deployment_pending',
+      main_sha_after: mainSha,
+      ci_status: release.ciStatus === 'none' ? 'none' : release.ciStatus,
+    });
+    await appendEvent({
+      type: 'release.in_main',
+      message: `GitHub confirmed ${release.items.length} commit(s) in main ${mainSha.slice(0, 7)}.`,
+      payload: { releaseId: release.id, mainSha, commits: release.items.map((i) => i.commitSha) },
+      dedupeKey: `release-in-main:${release.id}:${mainSha}`,
+    }).catch(() => {});
+    release = (await getReleaseRecord(release.id)) || release;
+  }
+
+  // ---- Verify the matching production deployment -----------------------
+  if (['deployment_pending', 'deployment_failed'].includes(release.status)) {
+    const mainSha = release.mainShaAfter || release.mainShaBefore;
+    const deployment = await getVercelDeploymentStatus({
+      repository,
+      commitSha: mainSha,
+    });
+    const patch: Record<string, unknown> = {
+      deployment_state: deployment.state,
+      deployment_url: deployment.url,
+      deployment_checked_at: deployment.checkedAt,
+    };
+    if (deployment.state === 'ready') {
+      Object.assign(patch, {
+        status: 'deployed',
+        completed_at: nowIso(),
+        error: null,
+      });
+      await updateReleaseRecord(release.id, patch);
+      for (const item of release.items) {
+        await updateReleaseItemRecord(item.id, {
+          state: 'deployed',
+          main_sha: mainSha,
+          error: null,
+        });
+        await patchTaskRelease(item.taskId, {
+          release_state: 'deployed',
+          release_commit: item.commitSha,
+          release_branch: item.branch,
+          release_error: null,
+        });
+      }
+      await appendEvent({
+        type: 'release.deployed',
+        message: `Vercel confirmed production READY for main ${mainSha?.slice(0, 7) || 'unknown'}.`,
+        payload: {
+          releaseId: release.id,
+          mainSha,
+          url: deployment.url,
+          target: deployment.target,
+        },
+        dedupeKey: `release-deployed:${release.id}:${mainSha}`,
+      }).catch(() => {});
+    } else if (deployment.state === 'error') {
+      Object.assign(patch, {
+        status: 'deployment_failed',
+        error: deployment.reason || 'The production deployment failed.',
+      });
+      await updateReleaseRecord(release.id, patch);
+      for (const item of release.items) {
+        await updateReleaseItemRecord(item.id, {
+          state: 'deployment_failed',
+          main_sha: mainSha,
+          error: deployment.reason,
+        });
+        await patchTaskRelease(item.taskId, {
+          release_state: 'deployment_failed',
+          release_commit: item.commitSha,
+          release_branch: item.branch,
+          release_error: deployment.reason,
+        });
+      }
+      await appendEvent({
+        type: 'release.deployment_failed',
+        level: 'error',
+        message: deployment.reason || 'The production deployment failed.',
+        payload: { releaseId: release.id, mainSha, url: deployment.url },
+        dedupeKey: `release-deployment-failed:${release.id}:${mainSha}`,
+      }).catch(() => {});
+    } else {
+      Object.assign(patch, {
+        status: 'deployment_pending',
+        error: null,
+      });
+      await updateReleaseRecord(release.id, patch);
+      for (const item of release.items) {
+        await updateReleaseItemRecord(item.id, {
+          state: 'deployment_pending',
+          main_sha: mainSha,
+          error: null,
+        });
+        await patchTaskRelease(item.taskId, {
+          release_state: 'deployment_pending',
+          release_commit: item.commitSha,
+          release_branch: item.branch,
+          release_error: null,
