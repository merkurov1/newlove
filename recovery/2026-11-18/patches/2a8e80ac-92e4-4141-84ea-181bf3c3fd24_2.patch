+    return getReleaseRecord(input.releaseId);
+  }
+  const release = await getReleaseRecord(input.releaseId);
+  if (!release) return null;
+  try {
+    return await advanceReleaseLocked({
+      release,
+      trigger: input.trigger,
+      force: input.force === true,
+      maxSteps: Math.min(Math.max(input.maxSteps || DEFAULT_MAX_STEPS, 1), 20),
+    });
+  } catch (error) {
+    const message =
+      error instanceof Error ? error.message.slice(0, 1800) : 'Release advancement failed.';
