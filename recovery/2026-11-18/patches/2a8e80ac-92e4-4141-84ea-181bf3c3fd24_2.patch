+// ---------------------------------------------------------------------------
+// Release promotion primitives
+// ---------------------------------------------------------------------------
+
+function fullSha(value: unknown): string {
+  const sha = typeof value === 'string' ? value.trim().toLowerCase() : '';
+  if (!/^[0-9a-f]{40}$/.test(sha)) {
+    throw new WorkbenchGitHubError('GITHUB_INVALID_SHA', 'A full 40-character commit SHA is required.');
+  }
+  return sha;
+}
+
+export async function createBranchRef(input: {
+  repository: DevRepositoryKey | string;
+  branch: string;
+  sha: string;
+}): Promise<string> {
+  const config = getDevRepositoryConfig(repoKey(input.repository));
+  const branch = safeBranch(input.branch);
+  const sha = fullSha(input.sha);
+  try {
+    const response = await client().request('POST /repos/{owner}/{repo}/git/refs', {
+      owner: config.owner,
+      repo: config.repo,
+      ref: `refs/heads/${branch}`,
+      sha,
+    });
+    return String((response.data as { object?: { sha?: unknown } }).object?.sha || sha);
+  } catch (error) {
+    // An existing integration branch is safe to reuse only when it points at
+    // the same base. Otherwise the caller gets an explicit error.
+    if (statusOf(error) === 422) {
+      const head = await getBranchHead(config.key, branch);
+      if (head && head.toLowerCase() === sha) return head;
+      throw new WorkbenchGitHubError(
+        'GITHUB_BRANCH_EXISTS',
+        `Integration branch ${branch} already exists at a different revision.`,
+        422
+      );
+    }
+    throw toError(error, 'GITHUB_BRANCH_CREATE_FAILED');
+  }
+}
+
+/**
+ * Server-side merge of one task branch into the release integration branch.
+ * GitHub performs the merge; the app never checks out or force-pushes a branch.
+ * A conflict is reported as a distinct code so preflight can block the batch
+ * without touching main.
+ */
+export async function mergeBranchIntoRelease(input: {
+  repository: DevRepositoryKey | string;
+  base: string;
+  head: string;
+  commitMessage: string;
+}): Promise<{ sha: string | null; alreadyUpToDate: boolean }> {
+  const config = getDevRepositoryConfig(repoKey(input.repository));
+  const base = safeBranch(input.base);
+  const head = safeBranch(input.head);
+  if (base === head) {
+    throw new WorkbenchGitHubError('GITHUB_INVALID_BRANCH', 'Base and head must differ.');
+  }
+  try {
+    const response = await client().request('POST /repos/{owner}/{repo}/merges', {
+      owner: config.owner,
+      repo: config.repo,
+      base,
+      head,
+      commit_message: input.commitMessage.slice(0, 500),
+    });
+    if ((response.status as number) === 204) return { sha: null, alreadyUpToDate: true };
+    const data = response.data as { sha?: unknown } | undefined;
+    return { sha: typeof data?.sha === 'string' ? data.sha : null, alreadyUpToDate: false };
+  } catch (error) {
+    if (statusOf(error) === 204) return { sha: null, alreadyUpToDate: true };
+    if (statusOf(error) === 409) {
+      throw new WorkbenchGitHubError(
+        'GITHUB_RELEASE_CONFLICT',
+        `GitHub reported a merge conflict between ${head} and ${base}.`,
+        409
+      );
+    }
+    throw toError(error, 'GITHUB_RELEASE_MERGE_FAILED');
+  }
+}
+
+/** True when `ancestor` is reachable from `descendant` (or is the same commit). */
+export async function isAncestor(
+  repository: DevRepositoryKey | string,
+  ancestor: string,
+  descendant: string
+): Promise<boolean | null> {
+  const config = getDevRepositoryConfig(repoKey(repository));
+  const a = fullSha(ancestor);
+  const d = fullSha(descendant);
+  if (a === d) return true;
+  try {
+    const response = await client().request('GET /repos/{owner}/{repo}/compare/{basehead}', {
+      owner: config.owner,
+      repo: config.repo,
+      basehead: `${d}...${a}`,
+    });
+    const status = String((response.data as { status?: unknown }).status || '');
+    return status === 'behind' || status === 'identical';
+  } catch (error) {
+    if (statusOf(error) === 404) return false;
+    return null;
+  }
+}
