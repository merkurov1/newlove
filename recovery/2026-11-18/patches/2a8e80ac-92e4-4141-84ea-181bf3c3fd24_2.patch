+-- Pierrot Dev — commit-first lifecycle and Ready to Push promotion
+-- Date: 2026-12-11
+--
+-- ADDITIVE ONLY. Do NOT apply automatically to production.
+--
+-- This migration completes the existing Workbench architecture:
+--   * tasks and attempts get an explicit release state, so a commit is never
+--     called ready before GitHub confirmed it exists on its isolated branch;
+--   * pierrot_dev_releases records one owner-triggered promotion request;
+--   * pierrot_dev_release_items records per-commit progress, which makes a
+--     partially advanced batch recoverable without losing or duplicating work.
+--
+-- The existing tables pierrot_dev_prompts, pierrot_dev_attempts,
+-- pierrot_dev_batches, pierrot_dev_events and pierrot_dev_settings are reused.
+-- No existing row is rewritten or deleted. A missing migration disables only
+-- the release screen; the Workbench itself keeps working.
+
+-- ---------------------------------------------------------------------------
+-- Release state on tasks and attempts
+-- ---------------------------------------------------------------------------
+
+ALTER TABLE public.pierrot_dev_prompts
+  ADD COLUMN IF NOT EXISTS release_state TEXT NOT NULL DEFAULT 'in_progress',
+  ADD COLUMN IF NOT EXISTS release_commit TEXT,
+  ADD COLUMN IF NOT EXISTS release_branch TEXT,
+  ADD COLUMN IF NOT EXISTS release_error TEXT,
+  ADD COLUMN IF NOT EXISTS release_updated_at TIMESTAMPTZ;
+
+ALTER TABLE public.pierrot_dev_attempts
+  ADD COLUMN IF NOT EXISTS commit_verified_at TIMESTAMPTZ,
+  ADD COLUMN IF NOT EXISTS commit_verified_sha TEXT,
+  ADD COLUMN IF NOT EXISTS release_state TEXT NOT NULL DEFAULT 'in_progress',
+  ADD COLUMN IF NOT EXISTS release_updated_at TIMESTAMPTZ;
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'pierrot_dev_prompts_release_state_check'
+  ) THEN
+    ALTER TABLE public.pierrot_dev_prompts
+      ADD CONSTRAINT pierrot_dev_prompts_release_state_check
+      CHECK (release_state IN (
+        'in_progress',
+        'commit_pending',
+        'validation_failed',
+        'committed',
+        'ready_to_push',
+        'blocked',
+        'pushing',
+        'in_main',
+        'deployment_pending',
+        'deployed',
+        'deployment_failed',
+        'no_changes'
+      ));
+  END IF;
+
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'pierrot_dev_attempts_release_state_check'
+  ) THEN
+    ALTER TABLE public.pierrot_dev_attempts
+      ADD CONSTRAINT pierrot_dev_attempts_release_state_check
+      CHECK (release_state IN (
+        'in_progress',
+        'commit_pending',
+        'validation_failed',
+        'committed',
+        'ready_to_push',
+        'blocked',
+        'pushing',
+        'in_main',
+        'deployment_pending',
+        'deployed',
+        'deployment_failed',
+        'no_changes'
+      ));
+  END IF;
+END $$;
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_prompts_release_idx
+  ON public.pierrot_dev_prompts (release_state, release_updated_at DESC NULLS LAST);
+CREATE INDEX IF NOT EXISTS pierrot_dev_attempts_commit_idx
+  ON public.pierrot_dev_attempts (commit_verified_sha)
+  WHERE commit_verified_sha IS NOT NULL;
+
+-- ---------------------------------------------------------------------------
+-- One durable promotion request
+-- ---------------------------------------------------------------------------
+
+CREATE TABLE IF NOT EXISTS public.pierrot_dev_releases (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id UUID,
+  status TEXT NOT NULL DEFAULT 'pushing'
+    CHECK (status IN (
+      'pushing',
+      'blocked',
+      'in_main',
+      'deployment_pending',
+      'deployed',
+      'deployment_failed',
+      'failed'
+    )),
+  request_key TEXT NOT NULL CHECK (length(btrim(request_key)) BETWEEN 8 AND 200),
+  base_branch TEXT NOT NULL DEFAULT 'main',
+  integration_branch TEXT NOT NULL,
+  main_sha_before TEXT,
+  main_sha_after TEXT,
+  pr_number INTEGER,
+  pr_url TEXT,
+  ci_status TEXT NOT NULL DEFAULT 'unknown',
+  ci_detail TEXT,
+  deployment_state TEXT,
+  deployment_url TEXT,
+  deployment_checked_at TIMESTAMPTZ,
+  error TEXT,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  completed_at TIMESTAMPTZ
+);
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_releases_status_idx
+  ON public.pierrot_dev_releases (status, created_at DESC);
+CREATE INDEX IF NOT EXISTS pierrot_dev_releases_request_idx
+  ON public.pierrot_dev_releases (request_key, created_at DESC);
+
+CREATE TABLE IF NOT EXISTS public.pierrot_dev_release_items (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  release_id UUID NOT NULL
+    REFERENCES public.pierrot_dev_releases(id) ON DELETE CASCADE,
+  task_id UUID NOT NULL
+    REFERENCES public.pierrot_dev_prompts(id) ON DELETE CASCADE,
+  attempt_id UUID
+    REFERENCES public.pierrot_dev_attempts(id) ON DELETE SET NULL,
+  commit_sha TEXT NOT NULL CHECK (commit_sha ~ '^[0-9a-f]{40}$'),
+  base_commit TEXT,
+  branch TEXT NOT NULL CHECK (length(btrim(branch)) BETWEEN 1 AND 200),
+  state TEXT NOT NULL DEFAULT 'pending'
+    CHECK (state IN (
+      'pending',
+      'ready',
+      'integrated',
+      'in_main',
+      'deployed',
+      'blocked',
+      'conflict',
+      'failed',
+      'deployment_pending',
+      'deployment_failed',
+      'already_in_main'
+    )),
+  github_merge_sha TEXT,
+  main_sha TEXT,
+  error TEXT,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  UNIQUE (release_id, task_id)
+);
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_release_idx
+  ON public.pierrot_dev_release_items (release_id, created_at ASC);
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_task_idx
+  ON public.pierrot_dev_release_items (task_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_state_idx
+  ON public.pierrot_dev_release_items (state, updated_at DESC);
+
+-- ---------------------------------------------------------------------------
+-- Server-only access, exactly like the existing Workbench tables
+-- ---------------------------------------------------------------------------
+
+ALTER TABLE public.pierrot_dev_releases ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.pierrot_dev_release_items ENABLE ROW LEVEL SECURITY;
+
+REVOKE ALL ON TABLE public.pierrot_dev_releases FROM PUBLIC, anon, authenticated;
+REVOKE ALL ON TABLE public.pierrot_dev_release_items FROM PUBLIC, anon, authenticated;
+
+GRANT ALL ON TABLE public.pierrot_dev_releases TO service_role;
+GRANT ALL ON TABLE public.pierrot_dev_release_items TO service_role;
+
+COMMENT ON TABLE public.pierrot_dev_releases IS
+  'One owner-triggered Ready to Push promotion. Server access only.';
+COMMENT ON TABLE public.pierrot_dev_release_items IS
+  'Per-commit progress for a promotion. Enables recovery after a partial GitHub failure.';
+COMMENT ON COLUMN public.pierrot_dev_prompts.release_state IS
+  'Commit/release lifecycle. A task cannot be ready_to_push before commit_verified_sha exists.';
+
