+  const active = await listActiveReleaseRecords(5);
+  const release = active.find((candidate) =>
+    ['pushing', 'in_main', 'deployment_pending', 'deployment_failed'].includes(candidate.status)
+  );
+  if (!release) return null;
+  if (
+    !input.force &&
+    release.updatedAt &&
+    Date.now() - new Date(release.updatedAt).getTime() < OVERVIEW_THROTTLE_MS
+  ) {
+    return release;
+  }
+  return advanceRelease({
+    releaseId: release.id,
+    trigger: input.trigger,
+    force: input.force,
+    maxSteps: 4,
+  });
+}
+
+export async function refreshReleaseState(input: {
+  userId: string;
+  releaseId?: string;
+}): Promise<{ inventory: DevReleaseQueue; release: DevReleaseRecord | null }> {
+  await reconcileReleaseQueue({ userId: input.userId, trigger: 'admin:refresh', maxTasks: 10 });
+  if (input.releaseId) {
+    await advanceRelease({
+      releaseId: input.releaseId,
+      trigger: 'admin:refresh',
+      force: true,
+      maxSteps: 4,
+    }).catch(() => null);
+  } else {
+    await advanceActiveRelease({ trigger: 'admin:refresh', force: true }).catch(() => null);
+  }
+  const inventory = await buildReleaseQueue({ userId: input.userId });
+  return { inventory, release: inventory.latest };
+}
+
+export async function releaseCommitUrl(
+  repository: string,
+  sha: string | null
+): Promise<string | null> {
+  if (!sha) return null;
+  try {
+    return commitUrl(repository, sha);
+  } catch {
+    return null;
+  }
+}
+
+// Kept for callers that want a stable display key without importing crypto.
+export function releaseDedupeKey(releaseId: string, suffix: string): string {
+  return `release:${releaseId}:${suffix.slice(0, 80)}`;
+}
