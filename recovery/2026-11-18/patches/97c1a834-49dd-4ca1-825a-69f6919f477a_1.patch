+  // A worker can claim work or recover between the decision and the lock. The
+  // stop is destructive, so re-read every racing signal once more and cancel
+  // instead of interrupting an attempt that just started.
+  const [workersAfterLock, queueAfterLock, attemptAfterLock, intentAfterLock] = await Promise.all([
+    listWorkers(),
+    getQueueSnapshot(),
+    getActiveAttempt(),
+    readIntent(),
+  ]);
+  const workerAfterLock = chooseWorker(workersAfterLock, codespace.name);
+  const executingAfterLock = Boolean(
+    attemptAfterLock ||
+      queueAfterLock.active > 0 ||
+      queueAfterLock.activeTasks > 0 ||
+      workerAfterLock?.currentAttemptId
+  );
+  const intentAfterLockFresh = Boolean(
+    intentAfterLock && Date.now() - new Date(intentAfterLock.at).getTime() < 180_000
+  );
+  if (
+    workerAfterLock?.online ||
+    executingAfterLock ||
+    queueAfterLock.paused ||
+    queueAfterLock.queued <= 0 ||
+    intentAfterLockFresh
+  ) {
+    await appendEvent({
+      type: 'codespace.worker_recovery_cancelled',
+      level: 'info',
+      message:
+        'Worker recovery was cancelled because the worker, queue or shutdown state changed after the decision.',
+      payload: {
+        source,
+        workerOnline: Boolean(workerAfterLock?.online),
+        executing: executingAfterLock,
+        queued: queueAfterLock.queued,
+        paused: queueAfterLock.paused,
+        shutdownIntent: intentAfterLockFresh,
+      },
+      dedupeKey: `worker-recovery-cancelled:${codespace.name}:${Math.floor(Date.now() / 60_000)}`,
+    }).catch(() => {});
+    return null;
+  }
