+/**
+ * A worker may only be recorded as ready when the detailed readiness proof
+ * agrees with the top-level flag. This prevents a contradictory payload
+ * (ready=true with authOk=false) from producing a false Ready state in Admin.
+ */
+function readinessIsReady(capabilities: Record<string, unknown>): boolean {
+  const readiness = capabilities.readiness;
+  if (!readiness || typeof readiness !== 'object' || Array.isArray(readiness)) {
+    return capabilities.ready === true;
+  }
+  const value = readiness as Record<string, unknown>;
+  return (
+    (capabilities.ready === true || value.ready === true) &&
+    value.authOk !== false &&
+    value.opencodeOk !== false
+  );
+}
