+jest.mock('@/lib/serverAuth', () => {
+  const db: Record<string, Array<Record<string, unknown>>> = {
+    pierrot_dev_releases: [],
+    pierrot_dev_release_batches: [],
+    pierrot_dev_release_items: [],
+    pierrot_dev_batch_items: [],
+  };
+  let counter = 0;
+
+  const matches = (row: Record<string, unknown>, filters: Array<[string, unknown]>) =>
+    filters.every(([key, value]) => {
+      if (Array.isArray(value)) return value.includes(row[key]);
+      return row[key] === value;
+    });
+
+  const builder = (table: string) => {
+    let operation: 'select' | 'insert' | 'update' | 'upsert' = 'select';
+    let payload: Record<string, unknown> | null = null;
+    let conflict: string[] = [];
+    const filters: Array<[string, unknown]> = [];
+
+    const rows = () => {
+      if (!db[table]) db[table] = [];
+      return db[table];
+    };
+
+    const api = {
+      select() {
+        return api;
+      },
+      insert(value: Record<string, unknown>) {
+        operation = 'insert';
+        payload = value;
+        return api;
+      },
+      update(value: Record<string, unknown>) {
+        operation = 'update';
+        payload = value;
+        return api;
+      },
+      upsert(value: Record<string, unknown>, options?: { onConflict?: string }) {
+        operation = 'upsert';
+        payload = value;
+        conflict = String(options?.onConflict || '')
+          .split(',')
+          .map((part) => part.trim())
+          .filter(Boolean);
+        return api;
+      },
+      eq(key: string, value: unknown) {
+        filters.push([key, value]);
+        return api;
+      },
+      in(key: string, value: unknown[]) {
+        filters.push([key, value]);
+        return api;
+      },
+      not() {
+        return api;
+      },
+      order() {
+        return api;
+      },
+      limit() {
+        return api;
+      },
+      maybeSingle() {
+        return Promise.resolve(resolve(false));
+      },
+      single() {
+        return Promise.resolve(resolve(false));
+      },
+      then(onFulfilled: (value: unknown) => unknown, onRejected?: (reason: unknown) => unknown) {
+        return Promise.resolve(resolve(true)).then(onFulfilled, onRejected);
+      },
+    };
+
+    function resolve(asList: boolean) {
+      if (operation === 'insert') {
+        const row = { id: `id-${++counter}`, created_at: new Date().toISOString(), ...payload };
+        rows().push(row);
+        return { data: asList ? [row] : row, error: null };
+      }
+      if (operation === 'upsert') {
+        const existing = rows().find((row) =>
+          conflict.every((key) => row[key] === (payload || {})[key])
+        );
+        if (existing) {
+          Object.assign(existing, payload, { id: existing.id });
+          return { data: asList ? [existing] : existing, error: null };
+        }
+        const row = { id: `id-${++counter}`, created_at: new Date().toISOString(), ...payload };
+        rows().push(row);
+        return { data: asList ? [row] : row, error: null };
+      }
+      if (operation === 'update') {
+        const updated = rows().filter((row) => matches(row, filters));
+        for (const row of updated) Object.assign(row, payload);
+        return { data: asList ? updated : updated[0] || null, error: null };
+      }
+      const selected = rows().filter((row) => matches(row, filters));
+      return { data: asList ? selected : selected[0] || null, error: null };
+    }
+
+    return api;
+  };
+
+  return {
+    getServerSupabaseClient: () => ({ from: (table: string) => builder(table) }),
+    __db: db,
+  };
+});
