diff --git a/migrations/2026-12-11_pierrot_dev_release.sql b/migrations/2026-12-11_pierrot_dev_release.sql
new file mode 100644
index 00000000..168b6378
--- /dev/null
+++ b/migrations/2026-12-11_pierrot_dev_release.sql
@@ -0,0 +1,155 @@
+-- Pierrot Dev Release — Ready to Push release ledger
+-- Date: 2026-12-11
+--
+-- ADDITIVE ONLY. Do NOT apply automatically to production.
+--
+-- The execution workbench already records attempts, commits and events. This
+-- migration adds the missing release ledger that answers one question:
+-- "which validated task commits have not reached main / production yet?"
+--
+-- It intentionally does not re-implement execution, attempts, worker leases or
+-- the event journal. It only extends the existing workbench with:
+--   * pierrot_dev_releases        — current release state per task/attempt
+--   * pierrot_dev_release_batches — one explicit owner "Push ready commits"
+--   * pierrot_dev_release_items   — per-commit progress inside a batch
+--
+-- All tables are server-only (RLS enabled, no anon/authenticated grants). No
+-- destructive statement and no column is removed.
+
+-- ---------------------------------------------------------------------------
+-- Release batches (one row per explicit owner action)
+-- ---------------------------------------------------------------------------
+
+CREATE TABLE IF NOT EXISTS public.pierrot_dev_release_batches (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id UUID,
+  -- Stable hash of the selected task/commit set. Makes a duplicate push
+  -- request return the existing batch instead of merging twice.
+  request_key TEXT NOT NULL UNIQUE
+    CHECK (length(btrim(request_key)) BETWEEN 1 AND 200),
+  status TEXT NOT NULL DEFAULT 'preflight'
+    CHECK (status IN ('preflight', 'blocked', 'pushing', 'completed', 'partial', 'failed')),
+  task_ids UUID[] NOT NULL DEFAULT '{}',
+  main_sha_before TEXT,
+  main_sha_after TEXT,
+  note TEXT,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  completed_at TIMESTAMPTZ
+);
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_batches_status_idx
+  ON public.pierrot_dev_release_batches (status, created_at DESC);
+
+-- ---------------------------------------------------------------------------
+-- Per-commit progress inside a release batch
+-- ---------------------------------------------------------------------------
+
+CREATE TABLE IF NOT EXISTS public.pierrot_dev_release_items (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  batch_id UUID NOT NULL
+    REFERENCES public.pierrot_dev_release_batches(id) ON DELETE CASCADE,
+  task_id UUID NOT NULL
+    REFERENCES public.pierrot_dev_prompts(id) ON DELETE CASCADE,
+  attempt_id UUID
+    REFERENCES public.pierrot_dev_attempts(id) ON DELETE SET NULL,
+  commit_sha TEXT,
+  status TEXT NOT NULL DEFAULT 'pending'
+    CHECK (status IN ('pending', 'pushing', 'pushed', 'failed', 'skipped')),
+  main_sha TEXT,
+  deployment_state TEXT,
+  deployment_url TEXT,
+  error TEXT,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  UNIQUE (batch_id, task_id)
+);
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_batch_idx
+  ON public.pierrot_dev_release_items (batch_id, created_at);
+CREATE INDEX IF NOT EXISTS pierrot_dev_release_items_task_idx
+  ON public.pierrot_dev_release_items (task_id);
+
+-- ---------------------------------------------------------------------------
+-- Current release state per task
+-- ---------------------------------------------------------------------------
+--
+-- One row per task is the current state. Prior attempts, commits and branches
+-- are never mutated or deleted: every attempt remains in pierrot_dev_attempts,
+-- and every state transition is appended to pierrot_dev_events.
+
+CREATE TABLE IF NOT EXISTS public.pierrot_dev_releases (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id UUID,
+  task_id UUID NOT NULL UNIQUE
+    REFERENCES public.pierrot_dev_prompts(id) ON DELETE CASCADE,
+  attempt_id UUID
+    REFERENCES public.pierrot_dev_attempts(id) ON DELETE SET NULL,
+  attempt_number INTEGER,
+  repository TEXT NOT NULL DEFAULT 'newlove',
+  branch TEXT,
+  commit_sha TEXT,
+  pr_url TEXT,
+  changed_files TEXT[] NOT NULL DEFAULT '{}',
+  checks JSONB NOT NULL DEFAULT '[]'::jsonb
+    CHECK (jsonb_typeof(checks) = 'array' AND pg_column_size(checks) <= 65536),
+  validation_status TEXT NOT NULL DEFAULT 'not_run'
+    CHECK (validation_status IN ('passed', 'failed', 'not_run')),
+  validation_detail TEXT,
+  status TEXT NOT NULL DEFAULT 'committed'
+    CHECK (status IN (
+      'not_committed',
+      'validation_failed',
+      'committed',
+      'ready',
+      'blocked',
+      'pushing',
+      'in_main',
+      'deployment_pending',
+      'deployed',
+      'deployment_failed'
+    )),
+  blocked_reasons TEXT[] NOT NULL DEFAULT '{}',
+  release_batch_id UUID
+    REFERENCES public.pierrot_dev_release_batches(id) ON DELETE SET NULL,
+  main_sha TEXT,
+  deployment_state TEXT,
+  deployment_url TEXT,
+  committed_at TIMESTAMPTZ,
+  released_at TIMESTAMPTZ,
+  deployed_at TIMESTAMPTZ,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS pierrot_dev_releases_status_idx
+  ON public.pierrot_dev_releases (status, committed_at DESC);
+
+-- ---------------------------------------------------------------------------
+-- RLS and privileges: server-only
+-- ---------------------------------------------------------------------------
+
+ALTER TABLE public.pierrot_dev_release_batches ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.pierrot_dev_release_items ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.pierrot_dev_releases ENABLE ROW LEVEL SECURITY;
+
+REVOKE ALL ON TABLE public.pierrot_dev_release_batches FROM PUBLIC, anon, authenticated;
+REVOKE ALL ON TABLE public.pierrot_dev_release_items FROM PUBLIC, anon, authenticated;
+REVOKE ALL ON TABLE public.pierrot_dev_releases FROM PUBLIC, anon, authenticated;
+
+GRANT ALL ON TABLE public.pierrot_dev_release_batches TO service_role;
+GRANT ALL ON TABLE public.pierrot_dev_release_items TO service_role;
+GRANT ALL ON TABLE public.pierrot_dev_releases TO service_role;
+
+COMMENT ON TABLE public.pierrot_dev_releases IS
+  'Current per-task release state: validated commit, ready/blocked, in main, deployment verification. Attempt history stays in pierrot_dev_attempts.';
+COMMENT ON TABLE public.pierrot_dev_release_batches IS
+  'One explicit owner Push ready commits action. request_key makes duplicate requests idempotent.';
+COMMENT ON TABLE public.pierrot_dev_release_items IS
+  'Per-commit progress and recovery state inside a release batch.';
+
+-- Manual verification (not executed automatically):
+--   SELECT table_name FROM information_schema.tables
+--    WHERE table_schema = 'public' AND table_name LIKE 'pierrot_dev_release%';
+--   SELECT relname, relrowsecurity FROM pg_class
+--    WHERE relname LIKE 'pierrot_dev_release%';
