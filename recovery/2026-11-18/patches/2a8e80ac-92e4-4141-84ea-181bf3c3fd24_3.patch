--- /dev/null
+++ b/lib/pierrot/dev/workbench/release.ts
@@ -0,0 +1,1613 @@
+import { createHash } from 'crypto';
+import { assertServerOnly } from '@/lib/serverOnly';
+import { getServerSupabaseClient } from '@/lib/serverAuth';
+import { resolveDevRepository } from '../repositories';
+import {
+  appendEvent,
+  getSetting,
+  listAttemptsForTasks,
+  listTaskRows,
+  patchTask,
+  setSetting,
+} from './store';
+import {
+  commitUrl,
+  compareCommits,
+  createPullRequestForAttempt,
+  getBranchHead,
+  getCommitChecks,
+  getPullRequestStatus,
+  getVercelDeploymentStatus,
+  mergeVerifiedPullRequest,
+} from './github';
+import { notifyDevOwner } from './notifications';
+import type {
+  DevDeploymentStatus,
+  DevReleaseBatch,
+  DevReleaseBatchItem,
+  DevReleaseCheck,
+  DevReleaseItem,
+  DevReleaseQueue,
+  DevReleaseStatus,
+  DevWorkbenchTask,
+  DevAttempt,
+} from './types';
+
+assertServerOnly('lib/pierrot/dev/workbench/release');
+
+export const RELEASE_MIGRATION_FILE = '2026-12-11_pierrot_dev_release.sql';
+export const RELEASE_SCHEMA_ERROR = 'DEV_RELEASE_MIGRATION_REQUIRED';
+
+const UUID_PATTERN =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const SHA_PATTERN = /^[0-9a-f]{40}$/i;
+const MAX_BATCH_TASKS = 50;
+const IDEMPOTENCY_WINDOW_MS = 5 * 60_000;
+
+const RELEASE_STATUSES: DevReleaseStatus[] = [
+  'not_committed',
+  'validation_failed',
+  'committed',
+  'ready',
+  'blocked',
+  'pushing',
+  'in_main',
+  'deployment_pending',
+  'deployed',
+  'deployment_failed',
+];
+
+export class DevReleaseError extends Error {
+  readonly code: string;
+  readonly status: number;
+
+  constructor(code: string, message: string, status = 409) {
+    super(message);
+    this.name = 'DevReleaseError';
+    this.code = code;
+    this.status = status;
+  }
+}
+
+function store() {
+  return getServerSupabaseClient({ useServiceRole: true });
+}
+
+function nowIso(): string {
+  return new Date().toISOString();
+}
+
+function text(value: unknown, limit = 2000): string {
+  return typeof value === 'string' ? value.trim().slice(0, limit) : '';
+}
+
+function strings(value: unknown, limit = 50): string[] {
+  return Array.isArray(value)
+    ? value
+        .filter((item): item is string => typeof item === 'string')
+        .map((item) => item.trim().slice(0, 2000))
+        .filter(Boolean)
+        .slice(0, limit)
+    : [];
+}
+
+export function isUuid(value: unknown): value is string {
+  return typeof value === 'string' && UUID_PATTERN.test(value);
+}
+
+export function isFullSha(value: unknown): value is string {
+  return typeof value === 'string' && SHA_PATTERN.test(value);
+}
+
+// ---------------------------------------------------------------------------
+// Schema probe
+// ---------------------------------------------------------------------------
+
+let schemaCache: { ready: boolean; expiresAt: number } | null = null;
+
+export async function isReleaseSchemaReady(force = false): Promise<boolean> {
+  if (!force && schemaCache && schemaCache.expiresAt > Date.now()) return schemaCache.ready;
+  try {
+    const checks = await Promise.all(
+      ['pierrot_dev_releases', 'pierrot_dev_release_batches', 'pierrot_dev_release_items'].map(
+        (table) => store().from(table).select('*', { head: true, count: 'exact' }).limit(1)
+      )
+    );
+    const ready = checks.every((check) => !check.error);
+    schemaCache = { ready, expiresAt: Date.now() + 60_000 };
+    return ready;
+  } catch {
+    schemaCache = { ready: false, expiresAt: Date.now() + 30_000 };
+    return false;
+  }
+}
+
+async function requireReleaseSchema(): Promise<void> {
+  if (!(await isReleaseSchemaReady())) {
+    throw new DevReleaseError(
+      RELEASE_SCHEMA_ERROR,
+      `Ready to Push requires the additive migration ${RELEASE_MIGRATION_FILE}.`,
+      503
+    );
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Pure helpers (unit-tested without a database)
+// ---------------------------------------------------------------------------
+
+const PASSED = new Set(['passed', 'success']);
+const FAILED = new Set(['failed', 'failure', 'error', 'timed_out', 'cancelled']);
+
+/**
+ * A commit is only releasable when at least one real verification command
+ * passed and nothing failed. Self-reported prose is not a check.
+ */
+export function classifyValidation(commands: unknown): {
+  status: 'passed' | 'failed' | 'not_run';
+  detail: string;
+  checks: DevReleaseCheck[];
+} {
+  const checks: DevReleaseCheck[] = Array.isArray(commands)
+    ? commands
+        .filter((item): item is Record<string, unknown> => Boolean(item) && typeof item === 'object')
+        .slice(0, 40)
+        .map((item) => {
+          const raw = String(item.status || 'unknown').toLowerCase();
+          const status: DevReleaseCheck['status'] = FAILED.has(raw)
+            ? 'failed'
+            : PASSED.has(raw)
+              ? 'passed'
+              : raw === 'skipped'
+                ? 'skipped'
+                : 'unknown';
+          return {
+            name: text(item.name, 300) || 'check',
+            status,
+            detail: text(item.detail, 1000),
+          };
+        })
+    : [];
+
+  const failed = checks.filter((check) => check.status === 'failed');
+  const passed = checks.filter((check) => check.status === 'passed');
+  if (failed.length > 0) {
+    return {
+      status: 'failed',
+      detail: `${failed.length} verification check(s) failed: ${failed
+        .map((check) => check.name)
+        .slice(0, 5)
+        .join(', ')}`,
+      checks,
+    };
+  }
+  if (passed.length === 0) {
+    return {
+      status: 'not_run',
+      detail: 'No passing test, lint, typecheck or build result is attached to this attempt.',
+      checks,
+    };
+  }
+  return {
+    status: 'passed',
+    detail: `${passed.length} verification check(s) passed.`,
+    checks,
+  };
+}
+
+/** Blocker text used by both preflight and the UI. */
+export function releaseStatusLabel(status: DevReleaseStatus): string {
+  const labels: Record<DevReleaseStatus, string> = {
+    not_committed: 'Not committed',
+    validation_failed: 'Validation failed',
+    committed: 'Committed',
+    ready: 'Ready to Push',
+    blocked: 'Blocked',
+    pushing: 'Pushing',
+    in_main: 'In main',
+    deployment_pending: 'Deployment pending',
+    deployed: 'Deployed',
+    deployment_failed: 'Deployment failed',
+  };
+  return labels[status] || status;
+}
+
+export function deploymentReleaseStatus(
+  deployment: DevDeploymentStatus | null
+): 'deployed' | 'deployment_pending' | 'deployment_failed' {
+  if (deployment?.state === 'ready') return 'deployed';
+  if (deployment?.state === 'error') return 'deployment_failed';
+  return 'deployment_pending';
+}
+
+export function requestKeyFor(taskIds: string[], commits: string[], now = Date.now()): string {
+  const hash = createHash('sha256')
+    .update([...taskIds].sort().join(','))
+    .update('|')
+    .update([...commits].sort().join(','))
+    .digest('hex')
+    .slice(0, 40);
+  const bucket = Math.floor(now / IDEMPOTENCY_WINDOW_MS);
+  return `push:${bucket}:${hash}`;
+}
+
+/** Topologically order selected tasks so a dependency is promoted first. */
+export function orderByDependencies(
+  taskIds: string[],
+  dependencies: Map<string, string[]>
+): string[] {
+  const selected = new Set(taskIds);
+  const result: string[] = [];
+  const visiting = new Set<string>();
+  const visited = new Set<string>();
+
+  const visit = (taskId: string) => {
+    if (visited.has(taskId) || !selected.has(taskId)) return;
+    if (visiting.has(taskId)) return; // A cycle is reported by preflight.
+    visiting.add(taskId);
+    for (const dependency of dependencies.get(taskId) || []) {
+      if (selected.has(dependency)) visit(dependency);
+    }
+    visiting.delete(taskId);
+    visited.add(taskId);
+    result.push(taskId);
+  };
+
+  for (const taskId of taskIds) visit(taskId);
+  return result;
+}
+
+// ---------------------------------------------------------------------------
+// Row mapping
+// ---------------------------------------------------------------------------
+
+function mapChecks(value: unknown): DevReleaseCheck[] {
+  if (!Array.isArray(value)) return [];
+  return value
+    .filter((item): item is Record<string, unknown> => Boolean(item) && typeof item === 'object')
+    .slice(0, 40)
+    .map((item) => {
+      const status = String(item.status || 'unknown').toLowerCase();
+      return {
+        name: text(item.name, 300) || 'check',
+        status: (['passed', 'failed', 'skipped', 'unknown'].includes(status)
+          ? status
+          : 'unknown') as DevReleaseCheck['status'],
+        detail: text(item.detail, 1000),
+      };
+    });
+}
+
+function mapDeployment(row: Record<string, unknown>): DevDeploymentStatus | null {
+  const state = text(row.deployment_state, 30);
+  if (!state) return null;
+  const mapped =
+    state === 'ready'
+      ? 'ready'
+      : state === 'error'
+        ? 'error'
+        : state === 'building'
+          ? 'building'
+          : state === 'queued'
+            ? 'queued'
+            : state === 'unavailable'
+              ? 'unavailable'
+              : 'unknown';
+  return {
+    state: mapped,
+    url: text(row.deployment_url, 1000) || null,
+    target: null,
+    commitSha: text(row.main_sha, 40) || null,
+    checkedAt: text(row.updated_at, 40) || nowIso(),
+    reason: null,
+  };
+}
+
+type ReleaseRow = Record<string, unknown>;
+
+function mapReleaseRow(row: ReleaseRow, task: DevWorkbenchTask | null): DevReleaseItem {
+  const commit = text(row.commit_sha, 40) || null;
+  const checks = mapChecks(row.checks);
+  return {
+    taskId: String(row.task_id || ''),
+    title: task?.title || 'Задача',
+    repository: text(row.repository, 120) || task?.repository || 'newlove',
+    attemptId: text(row.attempt_id, 40) || null,
+    attemptNumber:
+      typeof row.attempt_number === 'number' && Number.isFinite(row.attempt_number)
+        ? Math.trunc(row.attempt_number)
+        : null,
+    branch: text(row.branch, 300) || null,
+    commitSha: commit,
+    commitUrl: commit ? commitUrl(text(row.repository, 120) || 'newlove', commit) : null,
+    prUrl: text(row.pr_url, 1000) || null,
+    changedFiles: strings(row.changed_files, 200),
+    checks,
+    validationStatus: (['passed', 'failed', 'not_run'].includes(
+      text(row.validation_status, 20)
+    )
+      ? text(row.validation_status, 20)
+      : 'not_run') as DevReleaseItem['validationStatus'],
+    validationDetail: text(row.validation_detail, 2000),
+    completedAt: text(row.committed_at, 40) || null,
+    status: (RELEASE_STATUSES.includes(text(row.status, 40) as DevReleaseStatus)
+      ? text(row.status, 40)
+      : 'committed') as DevReleaseStatus,
+    blockedReasons: strings(row.blocked_reasons, 20),
+    releaseBatchId: text(row.release_batch_id, 40) || null,
+    mainSha: text(row.main_sha, 40) || null,
+    deployment: mapDeployment(row),
+    dependencies: [],
+    legacy: false,
+  };
+}
+
+function legacyItem(
+  task: DevWorkbenchTask,
+  attempt: DevAttempt | null,
+  dependencies: string[]
+): DevReleaseItem {
+  const commit =
+    (attempt?.headSha && isFullSha(attempt.headSha) ? attempt.headSha : null) ||
+    (task.resultCommit && isFullSha(task.resultCommit) ? task.resultCommit : null);
+  const changedFiles = attempt?.changedFiles?.length
+    ? attempt.changedFiles
+    : commit
+      ? ['(recorded by a pre-release attempt)']
+      : [];
+  const validation = classifyValidation(attempt?.commands);
+  let status: DevReleaseStatus = 'not_committed';
+  if (!commit || changedFiles.length === 0) status = 'not_committed';
+  else if (validation.status === 'failed') status = 'validation_failed';
+  else if (validation.status === 'passed') status = 'ready';
+  else status = 'committed';
+  return {
+    taskId: task.id,
+    title: task.title,
+    repository: task.repository,
+    attemptId: attempt?.id || null,
+    attemptNumber: attempt?.attemptNumber || null,
+    branch: attempt?.branch || null,
+    commitSha: commit,
+    commitUrl: commit ? commitUrl(task.repository, commit) : null,
+    prUrl: attempt?.prUrl || task.pullRequests.slice(-1)[0] || null,
+    changedFiles,
+    checks: validation.checks,
+    validationStatus: validation.status,
+    validationDetail: validation.detail,
+    completedAt: attempt?.finishedAt || task.updatedAt || null,
+    status,
+    blockedReasons: [],
+    releaseBatchId: null,
+    mainSha: null,
+    deployment: null,
+    dependencies,
+    legacy: true,
+  };
+}
+
+function emptyCounts(): Record<DevReleaseStatus, number> {
+  return RELEASE_STATUSES.reduce(
+    (counts, status) => ({ ...counts, [status]: 0 }),
+    {} as Record<DevReleaseStatus, number>
+  );
+}
+
+function defaultQueue(schemaReady: boolean): DevReleaseQueue {
+  return {
+    schemaReady,
+    migrationFile: RELEASE_MIGRATION_FILE,
+    items: [],
+    counts: emptyCounts(),
+    readyCount: 0,
+    blockedCount: 0,
+    inMainCount: 0,
+    deployedCount: 0,
+    pendingDeploymentCount: 0,
+    mainSha: null,
+    mainShaCheckedAt: null,
+    production: null,
+    activeBatch: null,
+    lastBatch: null,
+    limitation:
+      'GitHub does not provide a transactional multi-commit merge. Promotion is sequential with per-commit progress; a failure stops the batch and leaves the already promoted commits In main.',
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Reads
+// ---------------------------------------------------------------------------
+
+export type ReleaseQueueOptions = {
+  tasks?: DevWorkbenchTask[];
+  includeLegacy?: boolean;
+};
+
+async function readDependencies(taskIds: string[]): Promise<Map<string, string[]>> {
+  const map = new Map<string, string[]>();
+  if (taskIds.length === 0) return map;
+  try {
+    const { data } = await store()
+      .from('pierrot_dev_batch_items')
+      .select('task_id,depends_on_task_id')
+      .in('task_id', taskIds)
+      .not('depends_on_task_id', 'is', null);
+    for (const row of data || []) {
+      const taskId = String(row.task_id || '');
+      const dependency = String(row.depends_on_task_id || '');
+      if (!taskId || !dependency) continue;
+      map.set(taskId, [...(map.get(taskId) || []), dependency]);
+    }
+  } catch {
+    // Dependencies are best effort when the workbench migration is partial.
+  }
+  return map;
+}
+
+async function readBatch(batch: Record<string, unknown>): Promise<DevReleaseBatch> {
+  let items: DevReleaseBatchItem[] = [];
+  try {
+    const { data } = await store()
+      .from('pierrot_dev_release_items')
+      .select(
+        'task_id,commit_sha,status,main_sha,deployment_state,deployment_url,error,created_at'
+      )
+      .eq('batch_id', String(batch.id))
+      .order('created_at', { ascending: true });
+    items = (data || []).map((row) => ({
+      taskId: String(row.task_id || ''),
+      commitSha: text(row.commit_sha, 40) || null,
+      status: (['pending', 'pushing', 'pushed', 'failed', 'skipped'].includes(
+        String(row.status)
+      )
+        ? String(row.status)
+        : 'pending') as DevReleaseBatchItem['status'],
+      mainSha: text(row.main_sha, 40) || null,
+      deploymentState: text(row.deployment_state, 30) || null,
+      deploymentUrl: text(row.deployment_url, 1000) || null,
+      error: text(row.error, 2000) || null,
+    }));
+  } catch {
+    items = [];
+  }
+  return {
+    id: String(batch.id),
+    status: (['preflight', 'blocked', 'pushing', 'completed', 'partial', 'failed'].includes(
+      String(batch.status)
+    )
+      ? String(batch.status)
+      : 'preflight') as DevReleaseBatch['status'],
+    taskIds: strings(batch.task_ids, MAX_BATCH_TASKS),
+    mainShaBefore: text(batch.main_sha_before, 40) || null,
+    mainShaAfter: text(batch.main_sha_after, 40) || null,
+    note: text(batch.note, 2000) || null,
+    createdAt: text(batch.created_at, 40) || nowIso(),
+    updatedAt: text(batch.updated_at, 40) || nowIso(),
+    completedAt: text(batch.completed_at, 40) || null,
+    items,
+  };
+}
+
+export async function getReleaseQueue(
+  userId: string,
+  options: ReleaseQueueOptions = {}
+): Promise<DevReleaseQueue> {
+  const schemaReady = await isReleaseSchemaReady();
+  const [mainSetting, productionSetting] = await Promise.all([
+    getSetting<{ sha?: string; checkedAt?: string }>('release:main_head', {}),
+    getSetting<DevDeploymentStatus | null>('release:production', null),
+  ]);
+
+  if (!schemaReady) {
+    return {
+      ...defaultQueue(false),
+      mainSha: text(mainSetting?.sha, 40) || null,
+      mainShaCheckedAt: text(mainSetting?.checkedAt, 40) || null,
+      production: productionSetting || null,
+    };
+  }
+
+  const tasks =
+    options.tasks ||
+    (await listTaskRows({ userId: isUuid(userId) ? userId : '', limit: 200 }));
+  const taskById = new Map(tasks.map((task) => [task.id, task]));
+  const taskIds = tasks.map((task) => task.id);
+  const dependencies = await readDependencies(taskIds);
+
+  let rows: ReleaseRow[] = [];
+  try {
+    const { data } = await store()
+      .from('pierrot_dev_releases')
+      .select('*')
+      .order('updated_at', { ascending: false })
+      .limit(300);
+    rows = Array.isArray(data) ? data : [];
+  } catch {
+    rows = [];
+  }
+  const persistedIds = new Set(rows.map((row) => String(row.task_id || '')));
+
+  const items: DevReleaseItem[] = [];
+  for (const row of rows) {
+    const task = taskById.get(String(row.task_id || ''));
+    if (!task) continue;
+    const item = mapReleaseRow(row, task);
+    item.dependencies = dependencies.get(item.taskId) || [];
+    items.push(item);
+  }
+
+  const includeLegacy = options.includeLegacy !== false;
+  if (includeLegacy) {
+    const legacyTasks = tasks.filter(
+      (task) =>
+        !persistedIds.has(task.id) &&
+        ['review', 'verified', 'archived', 'failed'].includes(task.status) &&
+        (task.resultCommit || task.pullRequests.length > 0)
+    );
+    if (legacyTasks.length > 0) {
+      const attemptsByTask = await listAttemptsForTasks(
+        legacyTasks.map((task) => task.id),
+        5
+      );
+      for (const task of legacyTasks) {
+        const attempts = attemptsByTask.get(task.id) || [];
+        const attempt =
+          attempts.find((item) => item.status === 'completed') || attempts[0] || null;
+        const item = legacyItem(task, attempt, dependencies.get(task.id) || []);
+        if (item.status !== 'not_committed' || item.commitSha) items.push(item);
+      }
+    }
+  }
+
+  let activeBatch: DevReleaseBatch | null = null;
+  let lastBatch: DevReleaseBatch | null = null;
+  try {
+    const { data } = await store()
+      .from('pierrot_dev_release_batches')
+      .select('*')
+      .order('created_at', { ascending: false })
+      .limit(10);
+    for (const batch of data || []) {
+      const mapped = await readBatch(batch);
+      if (!activeBatch && ['preflight', 'blocked', 'pushing'].includes(mapped.status)) {
+        activeBatch = mapped;
+      }
+      if (!lastBatch && ['completed', 'partial', 'failed'].includes(mapped.status)) {
+        lastBatch = mapped;
+      }
+    }
+  } catch {
+    activeBatch = null;
+    lastBatch = null;
+  }
+
+  const counts = emptyCounts();
+  for (const item of items) counts[item.status] += 1;
+
+  return {
+    schemaReady: true,
+    migrationFile: RELEASE_MIGRATION_FILE,
+    items,
+    counts,
+    readyCount: counts.ready,
+    blockedCount: counts.blocked + counts.validation_failed + counts.deployment_failed,
+    inMainCount: counts.in_main,
+    deployedCount: counts.deployed,
+    pendingDeploymentCount: counts.deployment_pending,
+    mainSha: text(mainSetting?.sha, 40) || lastBatch?.mainShaAfter || null,
+    mainShaCheckedAt: text(mainSetting?.checkedAt, 40) || null,
+    production: productionSetting || null,
+    activeBatch,
+    lastBatch,
+    limitation:
+      'GitHub has no transactional multi-commit merge. Push ready commits promotes sequentially, records every step and stops on the first failure; already merged commits stay In main and are never rolled back silently.',
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Release state writes
+// ---------------------------------------------------------------------------
+
+export async function recordReleaseReady(input: {
+  task: DevWorkbenchTask;
+  attempt: DevAttempt;
+  validation: ReturnType<typeof classifyValidation>;
+}): Promise<void> {
+  if (!(await isReleaseSchemaReady())) return;
+  const commit = input.attempt.headSha;
+  if (!isFullSha(commit)) return;
+  try {
+    const { data: existing } = await store()
+      .from('pierrot_dev_releases')
+      .select('id,commit_sha,status')
+      .eq('task_id', input.task.id)
+      .maybeSingle();
+
+    const currentStatus = text(existing?.status, 40);
+    const keepStatus =
+      existing &&
+      String(existing.commit_sha || '') === commit &&
+      ['pushing', 'in_main', 'deployment_pending', 'deployed'].includes(currentStatus);
+
+    const row = {
+      user_id: null,
+      task_id: input.task.id,
+      attempt_id: input.attempt.id,
+      attempt_number: input.attempt.attemptNumber,
+      repository: input.task.repository,
+      branch: input.attempt.branch,
+      commit_sha: commit,
+      pr_url: input.attempt.prUrl || input.task.pullRequests.slice(-1)[0] || null,
+      changed_files: input.attempt.changedFiles.slice(0, 200),
+      checks: input.validation.checks,
+      validation_status: input.validation.status,
+      validation_detail: input.validation.detail,
+      status: keepStatus ? currentStatus : 'ready',
+      blocked_reasons: [],
+      committed_at: input.attempt.finishedAt || nowIso(),
+      updated_at: nowIso(),
+    };
+    const { error } = await store()
+      .from('pierrot_dev_releases')
+      .upsert(row, { onConflict: 'task_id' });
+    if (error) {
+      console.error('[dev-release] record ready failed', { code: error.code });
+      return;
+    }
+    if (!keepStatus) {
+      await appendEvent({
+        taskId: input.task.id,
+        attemptId: input.attempt.id,
+        type: 'release.ready',
+        message: `Commit ${commit.slice(0, 7)} on ${input.attempt.branch || 'branch'} is validated and Ready to Push.`,
+        payload: {
+          commitSha: commit,
+          branch: input.attempt.branch,
+          changedFiles: input.attempt.changedFiles.length,
+          validation: input.validation.status,
+        },
+        dedupeKey: `release-ready:${input.attempt.id}:${commit}`,
+      }).catch(() => {});
+    }
+  } catch (error) {
+    console.error('[dev-release] record ready threw', {
+      code: error instanceof Error ? error.name : 'unknown',
+    });
+  }
+}
+
+export async function recordReleaseFailure(input: {
+  task: DevWorkbenchTask;
+  attempt: DevAttempt;
+  status: 'validation_failed' | 'not_committed';
+  reason: string;
+  validation: ReturnType<typeof classifyValidation>;
+}): Promise<void> {
+  if (!(await isReleaseSchemaReady())) return;
+  try {
+    const { error } = await store()
+      .from('pierrot_dev_releases')
+      .upsert(
+        {
+          task_id: input.task.id,
+          attempt_id: input.attempt.id,
+          attempt_number: input.attempt.attemptNumber,
+          repository: input.task.repository,
+          branch: input.attempt.branch,
+          commit_sha: isFullSha(input.attempt.headSha) ? input.attempt.headSha : null,
+          pr_url: input.attempt.prUrl || null,
+          changed_files: input.attempt.changedFiles.slice(0, 200),
+          checks: input.validation.checks,
+          validation_status: input.validation.status,
+          validation_detail: text(input.reason, 2000),
+          status: input.status,
+          blocked_reasons: [text(input.reason, 1000)],
+          committed_at: input.attempt.finishedAt || nowIso(),
+          updated_at: nowIso(),
+        },
+        { onConflict: 'task_id' }
+      );
+    if (error) {
+      console.error('[dev-release] record failure failed', { code: error.code });
+      return;
+    }
+    await appendEvent({
+      taskId: input.task.id,
+      attemptId: input.attempt.id,
+      type: input.status === 'validation_failed' ? 'release.validation_failed' : 'release.no_changes',
+      level: 'error',
+      message: text(input.reason, 2000),
+      payload: {
+        commitSha: input.attempt.headSha,
+        changedFiles: input.attempt.changedFiles.length,
+        validation: input.validation.status,
+      },
+      dedupeKey: `release-failed:${input.attempt.id}`,
+    }).catch(() => {});
+  } catch {
+    // Release bookkeeping must never hide the task failure itself.
+  }
+}
+
+async function ensurePersistedRelease(
+  task: DevWorkbenchTask,
+  item: DevReleaseItem
+): Promise<void> {
+  if (!item.legacy || !item.commitSha) return;
+  const validation = classifyValidation(item.checks);
+  await store()
+    .from('pierrot_dev_releases')
+    .upsert(
+      {
+        task_id: task.id,
+        attempt_id: item.attemptId,
+        attempt_number: item.attemptNumber,
+        repository: task.repository,
+        branch: item.branch,
+        commit_sha: item.commitSha,
+        pr_url: item.prUrl,
+        changed_files: item.changedFiles.slice(0, 200),
+        checks: item.checks,
+        validation_status: validation.status,
+        validation_detail: validation.detail,
+        status: item.status === 'ready' ? 'ready' : 'committed',
+        blocked_reasons: [],
+        committed_at: item.completedAt || nowIso(),
+        updated_at: nowIso(),
+      },
+      { onConflict: 'task_id' }
+    );
+}
+
+async function updateRelease(
+  taskId: string,
+  patch: Record<string, unknown>
+): Promise<void> {
+  try {
+    await store()
+      .from('pierrot_dev_releases')
+      .update({ ...patch, updated_at: nowIso() })
+      .eq('task_id', taskId);
+  } catch {
+    // The batch item remains the durable per-commit progress record.
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Preflight
+// ---------------------------------------------------------------------------
+
+type PreflightResult = {
+  ok: boolean;
+  reasons: string[];
+  mainHead: string | null;
+  merged: boolean;
+  mergeSha: string | null;
+  prNumber: number | null;
+  prUrl: string | null;
+  ciStatus: 'passed' | 'failed' | 'pending' | 'none' | 'unknown';
+};
+
+function parsePrNumber(url: string | null): number | null {
+  const match = String(url || '').match(/\/pull\/(\d+)(?:\b|$)/);
+  if (!match) return null;
+  const number = Number(match[1]);
+  return Number.isSafeInteger(number) && number > 0 ? number : null;
+}
+
+async function preflightItem(input: {
+  item: DevReleaseItem;
+  task: DevWorkbenchTask;
+  dependencyItems: Map<string, DevReleaseItem>;
+}): Promise<PreflightResult> {
+  const reasons: string[] = [];
+  const repository = input.item.repository;
+  const config = resolveDevRepository(repository);
+  const commit = input.item.commitSha;
+  let mainHead: string | null = null;
+  let merged = false;
+  let mergeSha: string | null = null;
+  const prNumber: number | null = parsePrNumber(input.item.prUrl);
+  let prUrl = input.item.prUrl;
+  let ciStatus: PreflightResult['ciStatus'] = 'unknown';
+  let mergeable: boolean | null = null;
+
+  if (!commit || !isFullSha(commit)) {
+    reasons.push('No full commit SHA is recorded for this task.');
+  }
+  if (input.item.validationStatus === 'failed') {
+    reasons.push('Validation failed; the commit cannot be promoted.');
+  }
+  if (input.item.validationStatus === 'not_run') {
+    reasons.push('No passing validation command is recorded.');
+  }
+  if (['not_committed', 'validation_failed'].includes(input.item.status)) {
+    reasons.push(`Release state is ${releaseStatusLabel(input.item.status)}.`);
+  }
+
+  for (const dependencyId of input.item.dependencies) {
+    const dependency = input.dependencyItems.get(dependencyId);
+    if (!dependency || !['in_main', 'deployed'].includes(dependency.status)) {
+      reasons.push(
+        `Dependency ${dependency?.title || dependencyId} is not confirmed In main yet.`
+      );
+    }
+  }
+
+  if (commit && isFullSha(commit)) {
+    const branchHead = input.item.branch
+      ? await getBranchHead(repository, input.item.branch)
+      : null;
+
+    if (prNumber) {
+      const status = await getPullRequestStatus(repository, prNumber);
+      if (!status) {
+        reasons.push(`Could not read pull request #${prNumber}.`);
+      } else {
+        prUrl = status.url;
+        merged = status.merged;
+        mergeSha = status.mergeCommitSha;
+        if (status.merged) {
+          ciStatus = 'passed';
+        } else if (status.state !== 'open') {
+          reasons.push(`Pull request #${prNumber} is ${status.state}, not open.`);
+        } else {
+          if (status.headSha.toLowerCase() !== commit.toLowerCase()) {
+            reasons.push('The pull request head moved since the commit was recorded.');
+          }
+          if (status.mergeable === false) {
+            reasons.push(
+              `Merge conflict detected (${status.mergeableState || 'dirty'}). Rebase the branch and retry.`
+            );
+          } else if (status.mergeable === null) {
+            reasons.push('GitHub has not finished computing mergeability yet.');
+          }
+          mergeable = status.mergeable;
+        }
+      }
+    } else if (branchHead && branchHead.toLowerCase() !== commit.toLowerCase()) {
+      reasons.push('The working branch head no longer matches the recorded commit.');
+    }
+
+    if (!merged) {
+      const checks = await getCommitChecks(repository, commit);
+      ciStatus = checks.status;
+      if (checks.status === 'failed') reasons.push(`CI failed: ${checks.detail}`);
+      else if (checks.status === 'pending') reasons.push('Required CI checks are still running.');
+      else if (checks.status === 'unknown') {
+        reasons.push(`CI status is unknown: ${checks.detail}`);
+      }
+      // `none` is allowed: a repository may not attach checks to task branches.
+      // The local validation result is still required.
+    }
+
+    mainHead = await getBranchHead(repository, config.defaultBranch);
+    if (!mainHead) {
+      reasons.push(`Could not read ${config.defaultBranch}.`);
+    } else if (!merged) {
+      const comparison = await compareCommits(repository, mainHead, commit);
+      if (!comparison) {
+        reasons.push('Could not verify commit ancestry against main.');
+      } else if (!['ahead', 'identical', 'behind', 'diverged'].includes(comparison.status)) {
+        reasons.push('Commit ancestry against main is unknown.');
+      } else if (
+        ['behind', 'diverged'].includes(comparison.status) &&
+        mergeable !== true
+      ) {
+        // A batch may advance main after the first merge. That is safe only
+        // when GitHub confirms the pull request is still mergeable; otherwise
+        // the commit must be rebased or the conflict resolved first.
+        reasons.push(
+          `Commit ${commit.slice(0, 7)} is ${comparison.status} relative to ${config.defaultBranch} and mergeability is not confirmed; rebase onto the current main.`
+        );
+      }
+    }
+  }
+
+  return {
+    ok: reasons.length === 0,
+    reasons: [...new Set(reasons)],
+    mainHead,
+    merged,
+    mergeSha,
+    prNumber,
+    prUrl,
+    ciStatus,
+  };
+}
+
+async function createBatch(input: {
+  requestKey: string;
+  userId: string;
+  taskIds: string[];
+  status: 'blocked' | 'pushing';
+  mainHead: string | null;
+  note: string;
+}): Promise<Record<string, unknown> | null> {
+  const { data, error } = await store()
+    .from('pierrot_dev_release_batches')
+    .insert({
+      user_id: isUuid(input.userId) ? input.userId : null,
+      request_key: input.requestKey,
+      status: input.status,
+      task_ids: input.taskIds,
+      main_sha_before: input.mainHead,
+      note: text(input.note, 2000),
+      updated_at: nowIso(),
+    })
+    .select('*')
+    .single();
+  if (error || !data) return null;
+  return data;
+}
+
+async function setBatchItem(input: {
+  batchId: string;
+  taskId: string;
+  attemptId: string | null;
+  commitSha: string | null;
+  status: DevReleaseBatchItem['status'];
+  mainSha?: string | null;
+  deploymentState?: string | null;
+  deploymentUrl?: string | null;
+  error?: string | null;
+}): Promise<void> {
+  try {
+    await store()
+      .from('pierrot_dev_release_items')
+      .upsert(
+        {
+          batch_id: input.batchId,
+          task_id: input.taskId,
+          attempt_id: input.attemptId,
+          commit_sha: input.commitSha,
+          status: input.status,
+          main_sha: input.mainSha ?? null,
+          deployment_state: input.deploymentState ?? null,
+          deployment_url: input.deploymentUrl ?? null,
+          error: input.error ?? null,
+          updated_at: nowIso(),
+        },
+        { onConflict: 'batch_id,task_id' }
+      );
+  } catch {
+    // Progress is also written to the event journal.
+  }
+}
+
+async function finishBatch(
+  batchId: string,
+  status: DevReleaseBatch['status'],
+  input: { mainShaAfter: string | null; note: string }
+): Promise<void> {
+  try {
+    await store()
+      .from('pierrot_dev_release_batches')
+      .update({
+        status,
+        main_sha_after: input.mainShaAfter,
+        note: text(input.note, 2000),
+        completed_at: nowIso(),
+        updated_at: nowIso(),
+      })
+      .eq('id', batchId);
+  } catch {
+    // The event journal still records the outcome.
+  }
+}
+
+async function findExistingBatch(requestKey: string): Promise<Record<string, unknown> | null> {
+  try {
+    const { data } = await store()
+      .from('pierrot_dev_release_batches')
+      .select('*')
+      .eq('request_key', requestKey)
+      .maybeSingle();
+    return data || null;
+  } catch {
+    return null;
+  }
+}
+
+async function updateMainSetting(repository: string): Promise<{
+  sha: string | null;
+  deployment: DevDeploymentStatus | null;
+}> {
+  const config = resolveDevRepository(repository);
+  const sha = await getBranchHead(repository, config.defaultBranch);
+  let deployment: DevDeploymentStatus | null = null;
+  if (sha) {
+    deployment = await getVercelDeploymentStatus({ repository, commitSha: sha });
+    await setSetting('release:main_head', { sha, checkedAt: nowIso() }).catch(() => {});
+    if (deployment) {
+      await setSetting('release:production', deployment).catch(() => {});
+    }
+  }
+  return { sha, deployment };
+}
+
+async function applyDeployment(
+  taskId: string,
+  repository: string,
+  mainSha: string
+): Promise<DevDeploymentStatus> {
+  const deployment = await getVercelDeploymentStatus({ repository, commitSha: mainSha });
+  const status = deploymentReleaseStatus(deployment);
+  await updateRelease(taskId, {
+    status,
+    main_sha: mainSha,
+    deployment_state: deployment.state,
+    deployment_url: deployment.url,
+    released_at: nowIso(),
+    ...(status === 'deployed' ? { deployed_at: nowIso() } : {}),
+  });
+  await appendEvent({
+    taskId,
+    type:
+      status === 'deployed'
+        ? 'release.deployed'
+        : status === 'deployment_failed'
+          ? 'release.deployment_failed'
+          : 'release.deployment_pending',
+    level: status === 'deployed' ? 'info' : status === 'deployment_failed' ? 'error' : 'warn',
+    message:
+      status === 'deployed'
+        ? `Vercel deployment for ${mainSha.slice(0, 7)} is READY.`
+        : status === 'deployment_failed'
+          ? `Vercel deployment for ${mainSha.slice(0, 7)} failed: ${deployment.reason || deployment.state}.`
+          : `Vercel deployment for ${mainSha.slice(0, 7)} is ${deployment.state}; not marked deployed.`,
+    payload: {
+      mainSha,
+      deploymentState: deployment.state,
+      deploymentUrl: deployment.url,
+      reason: deployment.reason,
+    },
+    dedupeKey: `release-deployment:${taskId}:${mainSha}:${deployment.state}`,
+  }).catch(() => {});
+  return deployment;
+}
+
+export type PushReadyResult = {
+  ok: boolean;
+  status: DevReleaseBatch['status'];
+  batchId: string | null;
+  mergedTaskIds: string[];
+  blocked: Array<{ taskId: string; reasons: string[] }>;
+  note: string;
+  queue: DevReleaseQueue;
+};
+
+export async function pushReadyCommits(input: {
+  userId: string;
+  taskIds: string[];
+  trigger?: string;
+}): Promise<PushReadyResult> {
+  await requireReleaseSchema();
+  if (!input.userId) {
+    throw new DevReleaseError('DEV_RELEASE_FORBIDDEN', 'Owner authorization is required.', 403);
+  }
+  const requested = [...new Set(input.taskIds.filter(isUuid))].slice(0, MAX_BATCH_TASKS);
+  if (requested.length === 0) {
+    throw new DevReleaseError('DEV_RELEASE_EMPTY', 'Select at least one ready commit.', 400);
+  }
+
+  const queue = await getReleaseQueue(input.userId, { includeLegacy: true });
+  const byTask = new Map(queue.items.map((item) => [item.taskId, item]));
+  const tasks = await listTaskRows({ userId: isUuid(input.userId) ? input.userId : '', limit: 200 });
+  const taskById = new Map(tasks.map((task) => [task.id, task]));
+  const missing = requested.filter((taskId) => !byTask.has(taskId) || !taskById.has(taskId));
+  if (missing.length > 0) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_TASK_NOT_FOUND',
+      `Task(s) not found: ${missing.join(', ')}`,
+      404
+    );
+  }
+
+  // Persist legacy candidates before touching GitHub so a crash never loses
+  // the link between task, attempt and commit.
+  for (const taskId of requested) {
+    const item = byTask.get(taskId)!;
+    if (item.legacy) await ensurePersistedRelease(taskById.get(taskId)!, item);
+  }
+
+  const commits = requested.map((taskId) => byTask.get(taskId)?.commitSha || '');
+  const repositories = new Set(
+    requested.map((taskId) => byTask.get(taskId)?.repository || 'newlove')
+  );
+  if (repositories.size > 1) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_MIXED_REPOSITORIES',
+      'A release batch must target one repository. Select commits from newlove or Pierrot separately.',
+      400
+    );
+  }
+  const batchRepository = [...repositories][0] || 'newlove';
+  let requestKey = requestKeyFor(requested, commits);
+  let existing = await findExistingBatch(requestKey);
+  // A blocked/failed/partial batch never claimed the whole selection was
+  // published. Allow an explicit retry without weakening idempotency for a
+  // successful batch: completed batches always return the existing result.
+  if (existing && ['blocked', 'failed', 'partial'].includes(String(existing.status))) {
+    requestKey = `${requestKey}:retry:${Date.now()}`;
+    existing = null;
+  }
+  if (existing) {
+    const batch = await readBatch(existing);
+    const mergedTaskIds = batch.items
+      .filter((item) => item.status === 'pushed')
+      .map((item) => item.taskId);
+    return {
+      ok: batch.status === 'completed',
+      status: batch.status,
+      batchId: batch.id,
+      mergedTaskIds,
+      blocked: batch.items
+        .filter((item) => item.status === 'failed' || item.status === 'skipped')
+        .map((item) => ({ taskId: item.taskId, reasons: [item.error || batch.note || 'Blocked.'] })),
+      note: 'Duplicate Push ready commits request returned the existing batch.',
+      queue: await getReleaseQueue(input.userId),
+    };
+  }
+
+  const dependencyItems = new Map(queue.items.map((item) => [item.taskId, item]));
+  const preflights = new Map<string, PreflightResult>();
+  const blockedReasons = new Map<string, string[]>();
+  let mainHead: string | null = null;
+
+  for (const taskId of requested) {
+    const item = byTask.get(taskId)!;
+    const task = taskById.get(taskId)!;
+    const preflight = await preflightItem({ item, task, dependencyItems });
+    preflights.set(taskId, preflight);
+    if (!preflight.ok) blockedReasons.set(taskId, preflight.reasons);
+    if (preflight.mainHead) mainHead = preflight.mainHead;
+  }
+
+  if (blockedReasons.size > 0) {
+    const batchRow = await createBatch({
+      requestKey,
+      userId: input.userId,
+      taskIds: requested,
+      status: 'blocked',
+      mainHead,
+      note: 'Preflight blocked the batch. No merge was attempted.',
+    });
+    if (!batchRow) {
+      throw new DevReleaseError('DEV_RELEASE_BATCH_FAILED', 'Unable to create release batch.', 500);
+    }
+    const batchId = String(batchRow.id);
+    for (const taskId of requested) {
+      const item = byTask.get(taskId)!;
+      const reasons = blockedReasons.get(taskId) || [];
+      await setBatchItem({
+        batchId,
+        taskId,
+        attemptId: item.attemptId,
+        commitSha: item.commitSha,
+        status: 'skipped',
+        error: reasons.join(' ') || 'Blocked by preflight.',
+      });
+      await updateRelease(taskId, {
+        status: 'blocked',
+        blocked_reasons: reasons,
+        release_batch_id: batchId,
+      });
+      await appendEvent({
+        taskId,
+        type: 'release.blocked',
+        level: 'warn',
+        message: `Push blocked: ${reasons.join(' ') || 'preflight failed.'}`,
+        payload: { batchId, reasons, commitSha: item.commitSha },
+        dedupeKey: `release-blocked:${batchId}:${taskId}`,
+      }).catch(() => {});
+    }
+    await finishBatch(batchId, 'blocked', {
+      mainShaAfter: mainHead,
+      note: 'Preflight blocked the batch. No merge was attempted.',
+    });
+    await notifyDevOwner({
+      eventKey: `release-blocked:${batchId}`,
+      title: 'Pierrot Dev · Push blocked',
+      lines: [
+        `${blockedReasons.size} of ${requested.length} selected commit(s) failed preflight.`,
+        ...[...blockedReasons.values()].flat().slice(0, 8),
+      ],
+    }).catch(() => {});
+    return {
+      ok: false,
+      status: 'blocked',
+      batchId,
+      mergedTaskIds: [],
+      blocked: [...blockedReasons.entries()].map(([taskId, reasons]) => ({ taskId, reasons })),
+      note: 'Preflight blocked the batch. No merge was attempted.',
+      queue: await getReleaseQueue(input.userId),
+    };
+  }
+
+  const ordered = orderByDependencies(
+    requested,
+    new Map(
+      requested.map((taskId) => [taskId, byTask.get(taskId)?.dependencies || []])
+    )
+  );
+
+  const batchRow = await createBatch({
+    requestKey,
+    userId: input.userId,
+    taskIds: ordered,
+    status: 'pushing',
+    mainHead,
+    note: 'Owner triggered Push ready commits.',
+  });
+  if (!batchRow) {
+    throw new DevReleaseError('DEV_RELEASE_BATCH_FAILED', 'Unable to create release batch.', 500);
+  }
+  const batchId = String(batchRow.id);
+  await appendEvent({
+    type: 'release.batch.started',
+    message: `Push ready commits started for ${ordered.length} commit(s).`,
+    payload: { batchId, taskIds: ordered, mainShaBefore: mainHead },
+    dedupeKey: `release-batch-started:${batchId}`,
+  }).catch(() => {});
+
+  const mergedTaskIds: string[] = [];
+  const blocked: Array<{ taskId: string; reasons: string[] }> = [];
+  let stoppedByFailure = false;
+
+  for (const taskId of ordered) {
+    const item = byTask.get(taskId)!;
+    const task = taskById.get(taskId)!;
+    if (stoppedByFailure) {
+      await setBatchItem({
+        batchId,
+        taskId,
+        attemptId: item.attemptId,
+        commitSha: item.commitSha,
+        status: 'skipped',
+        error: 'Skipped because an earlier commit in this batch failed.',
+      });
+      await updateRelease(taskId, {
+        status: 'blocked',
+        blocked_reasons: ['Skipped because an earlier commit in this batch failed.'],
+        release_batch_id: batchId,
+      });
+      blocked.push({
+        taskId,
+        reasons: ['Skipped because an earlier commit in this batch failed.'],
+      });
+      continue;
+    }
+
+    await setBatchItem({
+      batchId,
+      taskId,
+      attemptId: item.attemptId,
+      commitSha: item.commitSha,
+      status: 'pushing',
+    });
+    await updateRelease(taskId, { status: 'pushing', release_batch_id: batchId });
+
+    // Re-run the expensive safety checks immediately before merging. A stale
+    // preflight result must never be used for a real merge.
+    const fresh = await preflightItem({ item, task, dependencyItems });
+    if (!fresh.ok) {
+      const reason = fresh.reasons.join(' ') || 'Preflight failed before merge.';
+      await setBatchItem({
+        batchId,
+        taskId,
+        attemptId: item.attemptId,
+        commitSha: item.commitSha,
+        status: 'failed',
+        error: reason,
+      });
+      await updateRelease(taskId, { status: 'blocked', blocked_reasons: [reason] });
+      await appendEvent({
+        taskId,
+        type: 'release.blocked',
+        level: 'warn',
+        message: reason,
+        payload: { batchId, reasons: fresh.reasons },
+        dedupeKey: `release-recheck-blocked:${batchId}:${taskId}`,
+      }).catch(() => {});
+      blocked.push({ taskId, reasons: fresh.reasons });
+      stoppedByFailure = true;
+      continue;
+    }
+
+    try {
+      let mergeSha = fresh.merged ? fresh.mergeSha : null;
+
+      if (!fresh.merged) {
+        let prNumber = fresh.prNumber;
+        if (!prNumber) {
+          const created = await createPullRequestForAttempt({
+            repository: item.repository,
+            head: item.branch || '',
+            base: resolveDevRepository(item.repository).defaultBranch,
+            title: `[Pierrot] ${task.title}`.slice(0, 240),
+            body: [
+              `Task: ${task.id}`,
+              `Attempt: ${item.attemptNumber ?? '—'} (${item.attemptId ?? '—'})`,
+              `Commit: ${item.commitSha}`,
+              '',
+              'Promoted by the owner with Push ready commits.',
+              'This pull request is merged as part of a selected release batch, not individually approved.',
+            ].join('\n'),
+          });
+          prNumber = created.number;
+          await updateRelease(taskId, { pr_url: created.url });
+        }
+
+        const merged = await mergeVerifiedPullRequest({
+          repository: item.repository,
+          number: prNumber,
+          expectedHeadSha: item.commitSha || '',
+        });
+        if (!merged.merged) {
+          throw new DevReleaseError(
+            'DEV_RELEASE_MERGE_FAILED',
+            `GitHub did not merge PR #${prNumber}: ${merged.message || 'unknown reason'}.`
+          );
+        }
+        mergeSha = merged.sha;
+      }
+
+      const confirmedMain = await getBranchHead(
+        item.repository,
+        resolveDevRepository(item.repository).defaultBranch
+      );
+      if (!confirmedMain) {
+        throw new DevReleaseError(
+          'DEV_RELEASE_MAIN_UNREADABLE',
+          'Could not read main after the merge; the commit stays Pushing until verified.'
+        );
+      }
+      // A squash merge creates a new SHA. Confirm that SHA is an ancestor of
+      // (or equal to) the new main head. Never claim In main from a 200 alone.
+      const reachable = mergeSha
+        ? await compareCommits(item.repository, mergeSha, confirmedMain)
+        : null;
+      if (!mergeSha || !reachable || !['ahead', 'identical'].includes(reachable.status)) {
+        throw new DevReleaseError(
+          'DEV_RELEASE_UNCONFIRMED',
+          'GitHub did not confirm the promoted revision in main. Retry verification; no second merge will be attempted.'
+        );
+      }
+
+      await updateRelease(taskId, {
+        status: 'deployment_pending',
+        main_sha: mergeSha,
+        released_at: nowIso(),
+        blocked_reasons: [],
+        deployment_state: null,
+        deployment_url: null,
+      });
+      const deployment = await applyDeployment(taskId, item.repository, mergeSha);
+      await setBatchItem({
+        batchId,
+        taskId,
+        attemptId: item.attemptId,
+        commitSha: item.commitSha,
+        status: 'pushed',
+        mainSha: mergeSha,
+        deploymentState: deployment.state,
+        deploymentUrl: deployment.url,
+      });
+      mergedTaskIds.push(taskId);
+      await appendEvent({
+        taskId,
+        type: 'release.pushed',
+        message: `Commit ${item.commitSha?.slice(0, 7)} promoted; main now contains ${mergeSha.slice(0, 7)}.`,
+        payload: {
+          batchId,
+          commitSha: item.commitSha,
+          mainSha: mergeSha,
+          previousMain: fresh.mainHead,
+        },
+        dedupeKey: `release-pushed:${batchId}:${taskId}:${mergeSha}`,
+      }).catch(() => {});
+    } catch (error) {
+      const reason =
+        error instanceof Error ? error.message.slice(0, 800) : 'The promotion failed.';
+      await setBatchItem({
+        batchId,
+        taskId,
+        attemptId: item.attemptId,
+        commitSha: item.commitSha,
+        status: 'failed',
+        error: reason,
+      });
+      await updateRelease(taskId, {
+        status: 'blocked',
+        blocked_reasons: [reason],
+        release_batch_id: batchId,
+      });
+      await appendEvent({
+        taskId,
+        type: 'release.failed',
+        level: 'error',
+        message: reason,
+        payload: { batchId, commitSha: item.commitSha, mainShaBefore: fresh.mainHead },
+        dedupeKey: `release-failed:${batchId}:${taskId}`,
+      }).catch(() => {});
+      blocked.push({ taskId, reasons: [reason] });
+      stoppedByFailure = true;
+    }
+  }
+
+  const { sha: finalMain, deployment: production } = await updateMainSetting(batchRepository);
+  const status: DevReleaseBatch['status'] =
+    blocked.length === 0 && mergedTaskIds.length === ordered.length
+      ? 'completed'
+      : mergedTaskIds.length > 0
+        ? 'partial'
+        : 'failed';
+  const note =
+    status === 'completed'
+      ? `All ${mergedTaskIds.length} commit(s) confirmed In main.`
+      : `Promoted ${mergedTaskIds.length}/${ordered.length} commit(s). ${
+          blocked.length
+        } blocked. Already promoted commits remain In main; no rollback was attempted.`;
+  await finishBatch(batchId, status, { mainShaAfter: finalMain, note });
+  await appendEvent({
+    type: 'release.batch.completed',
+    level: status === 'completed' ? 'info' : 'warn',
+    message: note,
+    payload: {
+      batchId,
+      status,
+      mergedTaskIds,
+      blocked,
+      mainShaBefore: mainHead,
+      mainShaAfter: finalMain,
+      production: production?.state || null,
+    },
+    dedupeKey: `release-batch-completed:${batchId}`,
+  }).catch(() => {});
+  await notifyDevOwner({
+    eventKey: `release-batch:${batchId}`,
+    title:
+      status === 'completed'
+        ? 'Pierrot Dev · batch pushed to main'
+        : 'Pierrot Dev · batch partially pushed',
+    lines: [
+      note,
+      `main: ${finalMain ? finalMain.slice(0, 7) : 'unknown'}`,
+      `Vercel: ${production?.state || 'unknown'}`,
+    ],
+  }).catch(() => {});
+
+  return {
+    ok: status === 'completed',
+    status,
+    batchId,
+    mergedTaskIds,
+    blocked,
+    note,
+    queue: await getReleaseQueue(input.userId),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Verification / recovery
+// ---------------------------------------------------------------------------
+
+/**
+ * Explicit, bounded verification. It never merges anything. It confirms which
+ * recorded commits are in main and re-reads the matching Vercel deployment, so
+ * a crash after a merge can be recovered without merging twice.
+ */
+export async function verifyReleases(input: {
+  userId: string;
+  taskIds?: string[];
+}): Promise<DevReleaseQueue> {
+  if (!(await isReleaseSchemaReady())) {
+    return getReleaseQueue(input.userId);
+  }
+  const queue = await getReleaseQueue(input.userId, { includeLegacy: false });
+  const wanted = new Set((input.taskIds || []).filter(isUuid));
+  const items = queue.items.filter(
+    (item) =>
+      (wanted.size === 0 || wanted.has(item.taskId)) &&
+      ['pushing', 'in_main', 'deployment_pending', 'deployment_failed', 'blocked', 'ready'].includes(
+        item.status
+      )
+  );
+
+  for (const item of items) {
+    const config = resolveDevRepository(item.repository);
+    const mainHead = await getBranchHead(item.repository, config.defaultBranch);
+    if (mainHead) {
+      await setSetting('release:main_head', {
+        sha: mainHead,
+        checkedAt: nowIso(),
+      }).catch(() => {});
+    }
+
+    if (!item.mainSha && item.commitSha && isFullSha(item.commitSha)) {
+      // A merged PR may have completed while the process died. Detect that
+      // before retrying a merge.
+      const prNumber = parsePrNumber(item.prUrl);
+      if (prNumber) {
+        const pr = await getPullRequestStatus(item.repository, prNumber);
+        if (pr?.merged && pr.mergeCommitSha) {
+          await updateRelease(item.taskId, {
+            status: 'deployment_pending',
+            main_sha: pr.mergeCommitSha,
+            released_at: nowIso(),
+          });
+          const deployment = await applyDeployment(
+            item.taskId,
+            item.repository,
+            pr.mergeCommitSha
+          );
+          await appendEvent({
+            taskId: item.taskId,
+            type: 'release.recovered',
+            message: `Recovered a merged PR and recorded main ${pr.mergeCommitSha.slice(0, 7)} (Vercel ${deployment.state}).`,
+            payload: { commitSha: item.commitSha, mainSha: pr.mergeCommitSha },
+            dedupeKey: `release-recovered:${item.taskId}:${pr.mergeCommitSha}`,
+          }).catch(() => {});
+        }
+      }
+      continue;
+    }
+
+    if (!item.mainSha) continue;
+    const reachable = await compareCommits(item.repository, item.mainSha, mainHead || item.mainSha);
+    if (!reachable || !['ahead', 'identical'].includes(reachable.status)) {
+      await updateRelease(item.taskId, {
+        status: 'blocked',
+        blocked_reasons: ['The recorded main commit is no longer reachable from main.'],
+      });
+      continue;
+    }
+    const deployment = await applyDeployment(item.taskId, item.repository, item.mainSha);
+    if (deployment.state !== 'ready' && item.status === 'deployed') {
+      // Never keep Deployed after Vercel stops reporting READY.
+      await updateRelease(item.taskId, {
+        status: deploymentReleaseStatus(deployment),
+      });
+    }
+  }
+
+  if (items.length > 0) {
+    const { deployment } = await updateMainSetting('newlove');
+    if (!deployment) {
+      const mainHead = await getBranchHead('newlove', 'main');
+      if (mainHead) {
+        const prod = await getVercelDeploymentStatus({ repository: 'newlove', commitSha: mainHead });
+        await setSetting('release:production', prod).catch(() => {});
+      }
+    }
+  }
+  return getReleaseQueue(input.userId);
+}
+
+export async function retryReleaseDeployment(input: {
+  userId: string;
+  taskId: string;
+}): Promise<DevReleaseQueue> {
+  await requireReleaseSchema();
+  const queue = await getReleaseQueue(input.userId, { includeLegacy: false });
+  const item = queue.items.find((entry) => entry.taskId === input.taskId);
+  if (!item) {
+    throw new DevReleaseError('DEV_RELEASE_NOT_FOUND', 'Release item not found.', 404);
+  }
+  if (!item.mainSha) {
+    throw new DevReleaseError(
+      'DEV_RELEASE_NOT_IN_MAIN',
+      'This task has no confirmed main commit to verify yet.',
+      409
+    );
+  }
+  const deployment = await applyDeployment(input.taskId, item.repository, item.mainSha);
+  if (deployment.state === 'error') {
+    await patchTask(input.taskId, {
+      last_error_code: 'DEPLOYMENT_FAILED',
+      last_error_message: deployment.reason || 'Vercel deployment failed.',
+    }).catch(() => null);
+  }
+  return getReleaseQueue(input.userId);
+}
