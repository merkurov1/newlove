+/** @jest-environment node */
+
+import { describe, expect, it } from '@jest/globals';
+import fs from 'fs';
+import path from 'path';
+
+const migration = fs.readFileSync(
+  path.join(process.cwd(), 'migrations', '2026-12-11_pierrot_dev_release.sql'),
+  'utf8'
+);
+
+describe('release migration', () => {
+  it('is additive and keeps execution history intact', () => {
+    expect(migration).toContain('CREATE TABLE IF NOT EXISTS public.pierrot_dev_releases');
+    expect(migration).toContain('CREATE TABLE IF NOT EXISTS public.pierrot_dev_release_batches');
+    expect(migration).toContain('CREATE TABLE IF NOT EXISTS public.pierrot_dev_release_items');
+    expect(migration).not.toMatch(/\bDROP\s+TABLE\b/i);
+    expect(migration).not.toMatch(/\bDROP\s+COLUMN\b/i);
+    expect(migration).not.toMatch(/\bDELETE\s+FROM\b/i);
+    expect(migration).not.toMatch(/ALTER\s+TABLE\s+public\.pierrot_dev_attempts/i);
+  });
+
+  it('is server-only and makes duplicate push requests idempotent', () => {
+    for (const table of [
+      'pierrot_dev_releases',
+      'pierrot_dev_release_batches',
+      'pierrot_dev_release_items',
+    ]) {
+      expect(migration).toContain(`ALTER TABLE public.${table} ENABLE ROW LEVEL SECURITY`);
+      expect(migration).toContain(`REVOKE ALL ON TABLE public.${table} FROM PUBLIC, anon, authenticated`);
+      expect(migration).toContain(`GRANT ALL ON TABLE public.${table} TO service_role`);
+    }
+    expect(migration).toMatch(/request_key TEXT NOT NULL UNIQUE/);
+    expect(migration).toContain('UNIQUE (batch_id, task_id)');
+    expect(migration).toContain('task_id UUID NOT NULL UNIQUE');
+  });
+
+  it('defines an explicit release state machine including deployment verification', () => {
+    for (const status of [
+      'not_committed',
+      'validation_failed',
+      'committed',
+      'ready',
+      'blocked',
+      'pushing',
+      'in_main',
+      'deployment_pending',
+      'deployed',
+      'deployment_failed',
+    ]) {
+      expect(migration).toContain(`'${status}'`);
+    }
+    expect(migration).toContain("deployed_at TIMESTAMPTZ");
+    expect(migration).toContain("deployment_state TEXT");
+  });
+});
