--- a/scripts/pierrot/dev-worker-lib.mjs
+++ b/scripts/pierrot/dev-worker-lib.mjs
@@ -237,3 +237,81 @@ export const BOOT_PHASES = Object.freeze([
   'failed',
   'stopping',
 ]);
+
+/**
+ * Decide which repository checks the worker must run before a commit can be
+ * marked Ready. The intent is real, relevant checks, not a simulated pass:
+ *   * typecheck and lint run when the repository defines them;
+ *   * tests run when defined and not explicitly disabled;
+ *   * build is opt-in because it is environment-heavy and slow.
+ *
+ * `PIERROT_DEV_VALIDATION_COMMANDS` overrides the list, e.g. "typecheck,lint".
+ * Unknown or unavailable scripts are returned as skipped with a reason.
+ */
+export function selectValidationCommands(packageJson, options = {}) {
+  const scripts =
+    packageJson && typeof packageJson.scripts === 'object' && packageJson.scripts
+      ? packageJson.scripts
+      : {};
+  const env = options.env && typeof options.env === 'object' ? options.env : {};
+  const explicit = String(env.PIERROT_DEV_VALIDATION_COMMANDS || '').trim();
+  const disabled = String(env.PIERROT_DEV_VALIDATION_DISABLED || '') === 'true';
+  const includeBuild =
+    String(env.PIERROT_DEV_VALIDATION_BUILD || '') === 'true' || Boolean(options.includeBuild);
+
+  if (disabled) {
+    return {
+      commands: [],
+      skipped: [
+        {
+          name: 'validation',
+          reason: 'PIERROT_DEV_VALIDATION_DISABLED=true; no check was executed.',
+        },
+      ],
+    };
+  }
+
+  const requested = explicit
+    ? explicit
+        .split(',')
+        .map((item) => item.trim())
+        .filter(Boolean)
+    : ['typecheck', 'lint', 'test', ...(includeBuild ? ['build'] : [])];
+
+  const commands = [];
+  const skipped = [];
+  const seen = new Set();
+  for (const name of requested) {
+    if (seen.has(name)) continue;
+    seen.add(name);
+    if (name === 'build' && !includeBuild && !explicit) {
+      skipped.push({
+        name,
+        reason: 'Production build is opt-in via PIERROT_DEV_VALIDATION_BUILD=true.',
+      });
+      continue;
+    }
+    if (typeof scripts[name] !== 'string' || !scripts[name].trim()) {
+      skipped.push({ name, reason: `No "${name}" script is defined in package.json.` });
+      continue;
+    }
+    commands.push({ name, script: scripts[name] });
+  }
+  return { commands, skipped };
+}
+
+export function summarizeValidation(results) {
+  const checks = Array.isArray(results) ? results : [];
+  const failed = checks.filter((item) => item.status === 'failed');
+  const passed = checks.filter((item) => item.status === 'passed');
+  return {
+    status: failed.length > 0 ? 'failed' : passed.length > 0 ? 'passed' : 'not_run',
+    detail:
+      failed.length > 0
+        ? `${failed.length} check(s) failed: ${failed.map((item) => item.name).join(', ')}`
+        : passed.length > 0
+          ? `${passed.length} check(s) passed.`
+          : 'No validation command was executed.',
+    checks,
+  };
+}
