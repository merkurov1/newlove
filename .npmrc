# Native binaries
unsafe-perm=true
engine-strict=false
fetch-retries=3

loglevel=error
fund=false
audit=false

# Kept for compatibility with packages that do not declare every transitive
# dependency they import (legacy admin editors, web3 wallets). Removing this
# requires a full runtime verification pass, not only a successful build.
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
