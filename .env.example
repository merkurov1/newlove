# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Meta crossposting (server-side only; never expose these as NEXT_PUBLIC_*)
# Facebook Page: "Ретроградный Меркуров"
META_GRAPH_API_VERSION=v26.0
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=
# Facebook Page crossposting is enabled by default.
META_FACEBOOK_CROSSPOST_ENABLED=true
# Threads crossposting remains disabled unless explicitly enabled.
META_THREADS_CROSSPOST_ENABLED=false

# Threads OAuth app (server-side only; used by /admin/meta/threads)
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=
# Threads publishing: a separate token from the Facebook Page token
META_THREADS_USER_ID=
META_THREADS_ACCESS_TOKEN=
# Optional override; defaults to v1.0 for graph.threads.net publishing
# META_THREADS_API_VERSION=v1.0

# Telegram
TELEGRAM_WEBHOOK_SECRET=your-secret-token
# Set to 1 only after registering the webhook with secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_WEBHOOK_ENFORCE_SECRET=0
TELEGRAM_ALLOWED_USER_IDS=123456789
# Optional Mini App URL used by scripts/telegram/configure-bot.mjs.
# TELEGRAM_MINI_APP_URL=https://www.merkurov.love/lobby
# Legacy/split bot webhook enforcement (only if /api/bot uses its own token).
# TELEGRAM_BOT_WEBHOOK_ENFORCE_SECRET=0

# AI — Gemini is primary for Pierrot and Flow; DeepSeek is the automatic fallback.
GEMINI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key
# Optional: Telegram voice transcription uses the existing OpenAI provider.
# OPENAI_API_KEY=
# Optional overrides
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# UNFRAMED RAG embeddings (OpenRouter, server-side only)
# Verified model: baai/bge-m3 (1024 dimensions, multilingual)
OPENROUTER_API_KEY=your-openrouter-key
UNFRAMED_EMBEDDING_MODEL=baai/bge-m3
# Optional: pin one OpenRouter provider for consistent vectors (e.g. deepinfra, parasail)
# UNFRAMED_EMBEDDING_PROVIDER=

# Disabled by default. Keep false until migration, ingestion and C4 evaluation pass.
PIERROT_RAG_ENABLED=false
# Provisional and uncalibrated; select on the frozen C4 calibration split first.
UNFRAMED_RAG_MIN_SIMILARITY=0.45

# Source-aware Brain retrieval v2. Set false to use the retained vector-only path.
PIERROT_BRAIN_RETRIEVAL_V2=true
# Provisional; explicit source/document questions use 80% of this value.
BRAIN_RAG_MIN_SIMILARITY=0.32
# Queue graph extraction after each completed Brain ingestion run.
BRAIN_AUTO_GRAPH=true

# Autonomous server-side workers (external scheduler / admin / pg_cron tick)
# vercel.json intentionally has no crons; see docs/production-operations.md.
CRON_SECRET=your-cron-secret
BRAIN_WORKER_MAX_JOBS=5
BRAIN_WORKER_MAX_DURATION_MS=240000
BRAIN_WORKER_LEASE_SECONDS=900
BRAIN_GRAPH_WORKER_MAX_JOBS=5
BRAIN_GRAPH_WORKER_MAX_DURATION_MS=240000
BRAIN_GRAPH_WORKER_LEASE_SECONDS=900
# Optional AI model overrides
# BRAIN_GRAPH_MODEL=deepseek-chat
# MEDIA_ANALYSIS_MODEL=deepseek-chat

# Resource-safety guard. OPS_* takes precedence over legacy BRAIN_* limits.
OPS_WORKERS_ENABLED=true
OPS_KILL_SWITCH=false
OPS_WORKER_LOCK_TTL_SECONDS=900
OPS_WORKER_LOCK_HEARTBEAT_MS=60000
OPS_MAX_ENQUEUE_PER_REQUEST=50
OPS_CIRCUIT_FAILURE_THRESHOLD=3
OPS_CIRCUIT_COOLDOWN_SECONDS=300
OPS_CIRCUIT_MAX_COOLDOWN_SECONDS=3600
OPS_BRAIN_MAX_JOBS=5
OPS_BRAIN_MAX_DURATION_MS=240000
OPS_BRAIN_MAX_QUEUE=500
OPS_BRAIN_MAX_QUEUE_AGE_HOURS=168
OPS_BRAIN_MAX_JOBS_PER_HOUR=60
OPS_BRAIN_MAX_JOBS_PER_DAY=300
OPS_GRAPH_MAX_JOBS=5
OPS_GRAPH_MAX_DURATION_MS=240000
OPS_GRAPH_MAX_QUEUE=500
OPS_GRAPH_MAX_QUEUE_AGE_HOURS=168
OPS_GRAPH_MAX_JOBS_PER_HOUR=60
OPS_GRAPH_MAX_JOBS_PER_DAY=300
OPS_MEDIA_MAX_QUEUE=100
OPS_MEDIA_MAX_QUEUE_AGE_HOURS=168
OPS_MEDIA_MAX_JOBS=3
OPS_MEDIA_MAX_DURATION_MS=180000
OPS_MEDIA_MAX_JOBS_PER_HOUR=30
OPS_MEDIA_MAX_JOBS_PER_DAY=120
OPS_NEWSLETTER_MAX_DURATION_MS=45000
OPS_NEWSLETTER_MAX_EMAILS=25
OPS_NEWSLETTER_MAX_EMAILS_PER_DAY=1000
OPS_PIERROT_LLM_TIMEOUT_MS=25000
OPS_PIERROT_LLM_MAX_TOKENS=700
OPS_FLOW_LLM_TIMEOUT_MS=20000
OPS_FLOW_LLM_MAX_TOKENS=600

# Public-only Brain RAG for Flow AI context. This never enables owner documents
# by itself; documents require an explicit public_retrieval_allowed approval.
FLOW_AI_RAG_ENABLED=true
FLOW_AI_RAG_MIN_SIMILARITY=0.34

# Optional explicit start of the Flow project for the "Flow active days" issue
# metric. When unset, the very first item ever created in `items` is used.
# FLOW_STARTED_AT=2024-01-01T00:00:00.000Z

# Public Pierrot retrieval is opt-in and uses only explicitly allowed public
# documents. Owner Brain retrieval is controlled by PIERROT_RAG_ENABLED.
PIERROT_PUBLIC_RAG_ENABLED=false

# Autonomous web evidence (Exa). Server-side only: EXA_API_KEY must never be
# exposed as NEXT_PUBLIC_*. Web search is disabled unless the flag is true and
# the key is present; a missing key never breaks chat.
PIERROT_WEB_SEARCH_ENABLED=false
EXA_API_KEY=your-exa-key
# Optional bounds (defaults: 6000 ms, 5 results, maximum 6).
# PIERROT_WEB_SEARCH_TIMEOUT_MS=6000
# PIERROT_WEB_SEARCH_MAX_RESULTS=5

# Optional fallback overrides for Pierrot offer policy when the DB policy table
# is unavailable. Admin UI is at /admin/pierrot/offers.
# PIERROT_OFFER_POLICY_JSON={"heart_angel_postcard":{"maxShowsPerConversation":3}}

# Owner commercial reporting. Both are optional.
PIERROT_OWNER_TIMEZONE=Europe/London
# First day of the 90-day commercial experiment (YYYY-MM-DD).
PIERROT_EXPERIMENT_START_DATE=2026-11-02

# PRIVATE FOOD & BEVERAGE TRACKER (owner-only)
# IANA timezone used for "today"/"yesterday" boundaries. If unset, day
# boundaries fall back to UTC and Pierrot says they are approximate.
PIERROT_INTAKE_TIMEZONE=Europe/London
# Optional LLM fallback for complex phrasing. Uses DEEPSEEK_API_KEY or
# OPENROUTER_API_KEY; no new provider is introduced. Deterministic rules are
# used first and low-confidence results are never saved automatically.
PIERROT_INTAKE_LLM_ENABLED=false
# PIERROT_INTAKE_MODEL=deepseek-chat
# PIERROT_INTAKE_OPENROUTER_MODEL=deepseek/deepseek-chat

# Server-to-server Pierrot adapter (Telegram -> /api/pierrot-web)
PIERO_API_SECRET=your-internal-secret

# PIERO HUMAN PRESENCE (uses the existing PIERROT_BOT_TOKEN bot)
# Numeric Telegram user id of Anton. Only this account can accept requests,
# send human replies or close a conversation. Falls back to MY_TELEGRAM_ID,
# then the first TELEGRAM_ALLOWED_USER_IDS entry.
PIERROT_OWNER_TELEGRAM_ID=123456789
# Optional. Pending human requests expire after this many minutes (default 20, max 60).
PIERROT_HUMAN_REQUEST_TTL_MINUTES=20
# Optional. An accepted human session closes itself after this many minutes
# without activity (default 180, min 15, max 1440). Prevents a stale Telegram
# conversation from receiving replies meant for a newer visitor.
PIERROT_HUMAN_SESSION_IDLE_MINUTES=180

# Optional
NEXT_PUBLIC_SITE_NAME=merkurov.love

# PIERROT DEV MODE (owner-only engineering environment)
# Server-only fine-grained GitHub token. Never expose it to the browser.
# A read-only token is enough for Dev inspection. GitHub write confirmations
# additionally require Contents / Issues / Pull requests write permission.
GITHUB_TOKEN=
GITHUB_OWNER=merkurov1
GITHUB_REPO=newlove
# Default branch used by read tools.
GITHUB_DEFAULT_BRANCH=main

# Two independent repositories. The model must choose one explicitly.
PIERROT_DEV_REPO_NEWLOVE=merkurov1/newlove
PIERROT_DEV_REPO_PIERROT=merkurov1/Pierrot
# Optional working branches (default to each repository's default branch).
# PIERROT_DEV_BRANCH_NEWLOVE=main
# PIERROT_DEV_BRANCH_PIERROT=main

# Read-only policy. Writes are disabled unless this is exactly "true".
# Dev Mode still does not expose write tools to the model. Keep it unset/false.
PIERROT_DEV_WRITE_ENABLED=false

# Bounded execution. No background indexing, cron or worker is created.
# PIERROT_DEV_REQUEST_DEADLINE_MS=90000
# PIERROT_DEV_TOOL_TIMEOUT_MS=20000
# PIERROT_DEV_MAX_TOOL_CALLS=16
# PIERROT_DEV_GITHUB_TIMEOUT_MS=15000
# PIERROT_DEV_MAX_TOKENS=6000
# Optional model overrides.
# PIERROT_DEV_MODEL=deepseek-chat
# PIERROT_DEV_OPENROUTER_MODEL=deepseek/deepseek-chat

# ─────────────────────────────────────────────────────────────────────────────
# Website intelligence · Google Analytics 4, Search Console, Umami
#
# The existing Supabase Google login is not changed. Analytics consent is a
# separate incremental OAuth grant with read-only scopes. Tokens stay server-
# side and are encrypted with AES-256-GCM.
# ─────────────────────────────────────────────────────────────────────────────
ANALYTICS_TIMEZONE=Europe/London
# First sync downloads this many days. Search Console may lag 2–3 days.
ANALYTICS_BACKFILL_DAYS=90
# Each incremental sync re-reads the last N days to repair delayed data.
ANALYTICS_INCREMENTAL_DAYS=3
# Dedicated 32+ byte secret for refresh-token encryption. If omitted, a key is
# derived from SUPABASE_SERVICE_ROLE_KEY (reported in the admin UI).
# ANALYTICS_TOKEN_ENCRYPTION_KEY=
# Must be registered in the same Google OAuth 2.0 client as Supabase Auth.
# Defaults to <NEXT_PUBLIC_SITE_URL>/api/auth/google-analytics/callback
# ANALYTICS_GOOGLE_REDIRECT_URI=
# Optional overrides. The numeric GA4 property is discovered automatically.
# Account ID and Property ID are different resources; never put a Measurement ID here.
# ANALYTICS_GA4_ACCOUNT_ID=
# ANALYTICS_GA4_PROPERTY_ID=
# Only set after sites.list confirms the resource and permission level.
# ANALYTICS_GSC_SITE_URL=sc-domain:merkurov.love
# Umami is optional. Without these values it is reported as not configured.
# ANALYTICS_UMAMI_API_URL=
# ANALYTICS_UMAMI_API_KEY=
# ANALYTICS_UMAMI_WEBSITE_ID=
# Optional scheduler secret. CRON_SECRET is reused when this is omitted.
# ANALYTICS_SYNC_SECRET=
