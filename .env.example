# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Telegram
TELEGRAM_WEBHOOK_SECRET=your-secret-token
# Set to 1 only after registering the webhook with secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_WEBHOOK_ENFORCE_SECRET=0
TELEGRAM_ALLOWED_USER_IDS=123456789

# AI — Pierrot uses DeepSeek only
DEEPSEEK_API_KEY=your-deepseek-key

# Optional
NEXT_PUBLIC_SITE_NAME=merkurov.love
