{
  "buildCommand": "next build",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/brain-worker",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/graph-worker",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/media-analysis-worker",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/pierrot-retention",
      "schedule": "0 5 * * *"
    }
  ]
}
