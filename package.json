{
  "name": "newlove",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=11.0.0 <12"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "edge >= 111",
    "not IE 11"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"app/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test --runInBand",
    "prepare": "if [ -d .git ]; then husky install 2>/dev/null || true; fi",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "vercel:login": "vercel login",
    "vercel:deploy": "vercel --prod",
    "vercel:logs": "vercel logs --since 60m",
    "vercel:logs:grep": "vercel logs --since 60m | grep -E 'SANITIZE DIAG|Unsupported Server Component type|2153716801' -n -C 5",
    "render:logs": "echo 'Check logs at https://dashboard.render.com'",
    "render:shell": "echo 'Use Render Dashboard → Shell to access container'",
    "check:metadata": "node scripts/check_metadata.js",
    "audit:gsc": "node scripts/gsc-coverage-audit.mjs",
    "test:pierrot": "playwright test --config=tests/pierrot.playwright.config.ts",
    "test:pierrot:viewport": "playwright test --config=tests/pierrot.playwright.config.ts",
    "test:attach-tags": "node scripts/test_attach_tags.js",
    "test:telegram-research": "jest lib/telegram-research --runInBand",
    "security:verify": "node scripts/security/verify-supabase-exposure.mjs",
    "typecheck:telegram-research": "tsc -p tsconfig.telegram-research.json",
    "telegram:configure": "node scripts/telegram/configure-bot.mjs",
    "telegram:find": "bun run scripts/telegram-research/cli.ts find",
    "telegram:export": "bun run scripts/telegram-research/cli.ts export",
    "telegram:stats": "bun run scripts/telegram-research/cli.ts stats",
    "telegram:verify": "bun run scripts/telegram-research/cli.ts verify",
    "telegram:deepseek": "bun run scripts/telegram-research/cli.ts deepseek",
    "telegram:public-case": "bun run scripts/telegram-research/build-public-case.ts",
    "compile:contracts": "npx hardhat compile",
    "deploy:hardhat": "npx hardhat run --network polygon scripts/deploy_hardhat.js",
    "mint:transfer": "npx hardhat run --network polygon scripts/mint_and_transfer.js",
    "deploy:local": "node scripts/deploy_hardhat.js",
    "mint:local": "node scripts/mint_and_transfer.js",
    "db:diag": "tsc db_diagnostics.ts && node db_diagnostics.js",
    "seo:check": "node --experimental-strip-types scripts/seo-check.ts",
    "media:analyze": "tsx scripts/media-analysis-run.ts",
    "brain:ingestion-recovery": "npx tsx scripts/knowledge/brain-ingestion-recovery.ts",
    "media:inventory": "node --experimental-strip-types --no-warnings scripts/media-audit/archive-inventory.ts",
    "media:verify": "node scripts/media-audit/verify.mjs",
    "media:verify-bundle": "node --experimental-strip-types --no-warnings scripts/knowledge/verify-media-archive-bundle.ts",
    "media:audit": "node scripts/media-audit/problems.mjs",
    "media:repair:consistency": "node scripts/media-audit/repair-media-consistency.mjs --dry-run",
    "audit:pierrot-intelligence": "node scripts/audit/pierrot-intelligence-audit.mjs",
    "ai:routing-report": "node scripts/ai/provider-routing-report.mjs"
  },
  "dependencies": {
    "@atproto/api": "^0.17.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/embed": "^2.7.6",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.3",
    "@editorjs/link": "^2.6.0",
    "@editorjs/list": "^2.0.8",
    "@nomicfoundation/solidity-analyzer-linux-x64-gnu": "^0.1.2",
    "@octokit/rest": "^22.0.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@react-email/components": "^0.0.22",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/typography": "^0.5.18",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/connect": "^2.9.3",
    "@vercel/speed-insights": "^1.2.0",
    "@web3-onboard/core": "^2.24.1",
    "@web3-onboard/injected-wallets": "^2.11.3",
    "@web3-onboard/walletconnect": "^2.6.3",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "domhandler": "^5.0.3",
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.8",
    "ethers": "^6.15.0",
    "framer-motion": "^12.43.0",
    "grammy": "^1.38.3",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^27.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.59.0",
    "markdown-to-jsx": "^7.5.0",
    "nanoid": "^5.1.16",
    "next": "16.4.6",
    "openai": "^7.22.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.0",
    "pino": "^10.1.0",
    "pino-pretty": "^9.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^3.5.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "stripe": "^18.5.0",
    "swiper": "^12.2.0",
    "tailwindcss": "^3.4.17",
    "turndown": "^7.2.0",
    "viem": "^2.38.5",
    "yahoo-finance2": "^4.0.4",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.6",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
